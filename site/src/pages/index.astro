---
// The landing page (decision 0022): a ruled sheet, about 200 words. The
// hero tells the whole story as a drawing (HeroStory); each section after
// it is a short heading, at most one line, and a figure. It shares the
// docs' header, search and footer through StarlightPage. The name comes
// from the site's title and the rest of the brand from
// src/generated/brand.json, which cmd/docgen writes from internal/brand, so
// a rename needs no change here. Everything reads without script; the
// script adds the live launcher and the copy buttons.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import HeroStory from '../components/landing/HeroStory.astro';
import Hosts from '../components/landing/Hosts.astro';
import Marks from '../components/landing/Marks.astro';
import brand from '../generated/brand.json';
import agents from '../generated/agents.json';
import '../styles/landing.css';

const name = brand.displayName;
const repo = __SITE__.repo || 'https://github.com/owner/repo';
const raw = repo.replace('https://github.com/', 'https://raw.githubusercontent.com/');
const install = `curl -fsSL ${raw}/main/install.sh | sh`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const to = (path) => base + path;

const shiftEnter = ['1b', '5b', '31', '33', '3b', '32', '75'];
const agentNames = agents.filter((a) => a.kind !== 'shell').map((a) => a.title);
const steps = [
	{ title: 'Install', cmd: install, label: 'Copy the install command' },
	{ title: 'Set up', cmd: `${brand.name} setup`, label: 'Copy the setup command' },
	{ title: 'Start an agent', cmd: `${brand.name} new my-server --agent claude`, label: 'Copy the command' },
];
---

<StarlightPage
	frontmatter={{
		title: name,
		template: 'splash',
		pagefind: false,
		landing: true,
		editUrl: false,
		head: [{ tag: 'title', content: `${name}: walk away, and your agents keep working` }],
	}}
	hasSidebar={false}
>
	<div class="landing" data-landing data-name={name}>
		<div class="sheet">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-text">
					<h1 id="hero-title">Walk away.<br /> Your agents <em>keep&nbsp;working.</em></h1>
					<p class="lead">
						{name} runs Claude Code, Codex or any terminal agent on your own machine, over your own SSH.
					</p>
					<div class="act">
						<a class="btn primary" href={to('/tutorials/getting-started/')}>Get started</a>
						<a class="btn" href={to('/docs/')}>Read the docs</a>
						<div class="cmd install" data-copy-box>
							<code data-copy-text tabindex="0">{install}</code>
							<button type="button" class="copy" data-copy data-js-only hidden aria-label="Copy the install command">
								Copy
							</button>
						</div>
					</div>
					<p class="pre">
						Signed releases for macOS and Linux. <a href={to('/how-to/install/')}>Other ways to install</a>.
					</p>
				</div>
				<HeroStory />
			</section>

			<section class="cell" aria-labelledby="screen-title">
				<div class="cell-head">
					<h2 id="screen-title">One screen for every session.</h2>
					<p>Every agent on every host, and the one that needs you.</p>
				</div>
				<figure class="plate grid" aria-labelledby="screen-cap">
					<div class="term">
						<div class="term-screen" data-term-screen>
							<img
								src={to('/images/sessions.svg')}
								alt="The launcher: the sessions on one host, each with its state, agent, folder and a trace of its output. The selected session waits for an answer."
								width="972"
								height="576"
								decoding="async"
								loading="lazy"
							/>
						</div>
					</div>
					<figcaption id="screen-cap" class="cap">
						<span>[ live ]</span> made-up sessions, in this page. Try <kbd>↑</kbd> <kbd>↓</kbd> <kbd>enter</kbd>
						<kbd>esc</kbd>
					</figcaption>
					<Marks />
				</figure>
			</section>

			<section class="cell" aria-labelledby="bytes-title">
				<div class="cell-head">
					<h2 id="bytes-title">The real screen, not a copy.</h2>
					<p>Your keys reach the agent byte for byte.</p>
					<a class="more" href={to('/explanation/fidelity/')}>What byte for byte covers</a>
				</div>
				<figure class="plate grid" aria-labelledby="bytes-cap">
					<div class="panel bytes">
						<p class="panel-title"><span>shift + enter</span><span>kitty keyboard protocol</span></p>
						<div class="brow">
							<span class="who">your terminal sends</span>
							<span class="cells">{shiftEnter.map((b) => <span>{b}</span>)}</span>
						</div>
						<div class="brow ok">
							<span class="who">through {name}</span>
							<span class="cells">{shiftEnter.map((b) => <span>{b}</span>)}</span>
							<em>the same seven bytes</em>
						</div>
						<div class="brow bad">
							<span class="who">through tmux 3.8</span>
							<span class="cells"><span>0d</span></span>
							<em>a plain enter</em>
						</div>
					</div>
					<figcaption id="bytes-cap" class="sr-only">
						Shift+Enter is seven bytes. {name} passes the same seven bytes to the agent; tmux 3.8 passes one, a plain
						Enter.
					</figcaption>
					<Marks />
				</figure>
			</section>

			<section class="cell" aria-labelledby="hosts-title">
				<div class="cell-head">
					<h2 id="hosts-title">Your machines. Your SSH.</h2>
					<p>Any Linux host that <code>ssh</code> reaches. No account, no relay, no telemetry.</p>
					<a class="more" href={to('/explanation/how-it-works/')}>How it works</a>
				</div>
				<figure class="plate grid">
					<Hosts />
					<Marks />
				</figure>
			</section>

			<section class="cell" aria-labelledby="start-title">
				<div class="cell-head">
					<h2 id="start-title">Three commands to a running agent.</h2>
					<a class="more" href={to('/tutorials/getting-started/')}>The five-minute tutorial</a>
				</div>
				<div class="plate">
					<div class="panel">
						<p class="panel-title"><span>your laptop</span><span>terminal</span></p>
						<ol class="steps">
							{
								steps.map((s) => (
									<li>
										<h3>{s.title}</h3>
										<div class="cmd" data-copy-box>
											<code data-copy-text tabindex="0">{s.cmd}</code>
											<button type="button" class="copy" data-copy data-js-only hidden aria-label={s.label}>
												Copy
											</button>
										</div>
									</li>
								))
							}
						</ol>
					</div>
					<Marks />
				</div>
			</section>

			<section class="cell" aria-labelledby="agents-title">
				<div class="cell-head">
					<h2 id="agents-title">Use the agent you already have.</h2>
					<a class="more" href={to('/reference/agents/')}>The agent table</a>
				</div>
				<div class="plate">
					<div class="panel agents">
						<p class="panel-title"><span>my-server</span><span>agents</span></p>
						<ul>
							{agentNames.map((a) => <li>{a}</li>)}
							<li class="any">any terminal program</li>
						</ul>
					</div>
					<Marks />
				</div>
			</section>

			<section class="cell close" aria-labelledby="close-title">
				<h2 id="close-title"><span class="sq" aria-hidden="true"></span>{name}</h2>
				<p class="tag">{brand.tagline}</p>
				<div class="act">
					<a class="btn primary" href={to('/tutorials/getting-started/')}>Get started</a>
					<a class="btn" href={to('/docs/')}>Read the docs</a>
				</div>
			</section>
		</div>
	</div>
</StarlightPage>

<script>
	import '../scripts/landing.js';
</script>
