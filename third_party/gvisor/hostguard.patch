+
+func (owner *NativeSentrySetupV1) Close() error {
+	if owner == nil || owner.closed {
+		return nil
+	}
+	// An unknown original child keeps ALL source objects and this owner
+	// retryable. No earlier failed close may become a later false success.
+	if owner.phase != nil {
+		if err := owner.phase.Close(); err != nil {
+			return err
+		}
+	}
+	owner.closed = true
+	var result error
+	for _, file := range append([]*os.File{owner.setup, owner.helper, owner.umounter}, owner.controllerCode...) {
+		if file != nil {
+			result = errors.Join(result, file.Close())
+		}
+	}
