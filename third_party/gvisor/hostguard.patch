+// decoded. Source paths are guest labels only; directfs is fixed false and
+// the original native Gofer capabilities supply the actual filesystem.
+func nativeFixedSpecV1(projection hostguard.NativeGuestProjectionV1) (*specs.Spec, error) {
+	return nativeconfig.SpecV1(projection)
