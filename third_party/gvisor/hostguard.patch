+
+// PublishOriginalWitnessesV1 sends actual final post-exec objects through the
+// SAME inherited setup-only channel. The parent must compare its ORIGINAL
+// creation pidfd, current SCM sender, exact held signed code and own-task birth,
+// all namespaces and socket pair before adopting the fresh endpoint. This
+// publication itself grants no private release and reads no setup-channel data.
+func (owner *NativeFinalBootV1) PublishOriginalWitnessesV1() (failure error) {
+	if owner == nil || owner.closed || owner.phase == nil || owner.setup == nil || owner.published || nativeEntryFinalFSV1 != 1 {
+		return fmt.Errorf("final native witness publication has no original final entry")
+	}
+	if err := owner.phase.RequireRoleV1(NativeSentryV1); err != nil {
+		return err
+	}
+	if err := publishNativeRoleWitnessesV1(owner.phase, owner.setup, NativeSentryV1); err != nil {
+		return err
+	}
+	owner.setup = nil
+	owner.published = true
+	return nil
+}
+
+func publishNativeRoleWitnessesV1(phase *NativePrivateV1, setup *os.File, kind NativeRoleKindV1) (failure error) {
+	if phase == nil || setup == nil || kind != NativeSentryV1 && kind != NativeGoferV1 && kind != NativeControllerV1 {
+		return fmt.Errorf("native publication lost its original role")
+	}
+	if err := phase.RequireRoleV1(kind); err != nil {
+		return err
+	}
+	witnesses, err := phase.TakeOriginalWitnessesV1()
+	if err != nil {
+		return err
+	}
+	defer func() {
+		for _, witness := range witnesses {
+			failure = errors.Join(failure, witness.Close())
+		}
+	}()
+	if len(witnesses) != 9 {
+		return fmt.Errorf("final native publication lost its closed original vector")
+	}
+	var rights []int
+	for _, witness := range witnesses {
+		rights = append(rights, int(witness.Fd()))
+	}
+	data := []byte{'N', 'W', 'V', 1, byte(kind)}
+	oob := unix.UnixRights(rights...)
+	oob = append(oob, unix.UnixCredentials(&unix.Ucred{Pid: int32(os.Getpid()), Uid: uint32(os.Geteuid()), Gid: uint32(os.Getegid())})...)
+	if n, err := unix.SendmsgN(int(setup.Fd()), data, oob, nil, unix.MSG_NOSIGNAL); err != nil || n != len(data) {
+		return fmt.Errorf("publish complete original final native witnesses: %v", err)
+	}
+	// No inherited stream can carry a private vector after exec's dumpability
+	// reset. Only the just-published fresh endpoint can receive later messages.
+	if err := setup.Close(); err != nil {
+		return err
+	}
+	return nil
+}
