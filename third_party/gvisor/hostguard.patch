+// SPDX-License-Identifier: Apache-2.0
+package hostguard
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"syscall"
+
+	"golang.org/x/sys/unix"
+)
+
+// ReceiveFinalFilesystemV1 consumes the exact final barrier from this SAME
+// created role's fresh endpoint. This is an actual native receive plus current
+// creation/birth checks; no saved success value can issue the private receipt.
+func (owner *NativeRoleCreationV1) ReceiveFinalFilesystemV1() error {
+	if owner == nil {
+		return fmt.Errorf("final filesystem receive has no original native creation")
+	}
+	owner.mu.Lock()
+	defer owner.mu.Unlock()
+	if err := owner.checkLiveLockedV1(); err != nil {
+		return err
+	}
+	if owner.endpoint == nil || owner.final != nil || len(owner.witnesses) != 8 {
+		return fmt.Errorf("original native filesystem receive is missing or reused")
+	}
+	data := make([]byte, 6)
+	ancillary := make([]byte, unix.CmsgSpace(unix.SizeofUcred)+unix.CmsgSpace(4))
+	n, oobn, flags, _, err := unix.Recvmsg(int(owner.endpoint.Fd()), data, ancillary, unix.MSG_CMSG_CLOEXEC)
+	if err != nil {
+		return err
+	}
+	messages, parseErr := unix.ParseSocketControlMessage(ancillary[:oobn])
+	var sender *unix.Ucred
+	credentials := 0
+	var semanticErr error
+	for _, message := range messages {
+		if message.Header.Level == unix.SOL_SOCKET && message.Header.Type == unix.SCM_RIGHTS {
+			rights, err := unix.ParseUnixRights(&message)
+			semanticErr = errors.Join(semanticErr, err, fmt.Errorf("native filesystem result cannot contain rights"))
+			for _, fd := range rights {
+				semanticErr = errors.Join(semanticErr, unix.Close(fd))
+			}
+		} else if message.Header.Level == unix.SOL_SOCKET && message.Header.Type == unix.SCM_CREDENTIALS {
+			credentials++
+			current, err := unix.ParseUnixCredentials(&message)
+			semanticErr = errors.Join(semanticErr, err)
+			sender = current
+		} else {
+			semanticErr = errors.Join(semanticErr, fmt.Errorf("native filesystem result has unsupported ancillary data"))
+		}
+	}
+	if parseErr != nil || semanticErr != nil || flags&(unix.MSG_TRUNC|unix.MSG_CTRUNC) != 0 || n != 5 || string(data[:4]) != "FSV\x01" || data[4] != byte(owner.kind) || credentials != 1 || sender == nil || int(sender.Pid) != owner.process.Pid || sender.Uid != 0 || sender.Gid != 0 {
+		return fmt.Errorf("native filesystem result changed its current original sender/vector: %v", errors.Join(parseErr, semanticErr))
+	}
+	current, err := readNativeTaskBirthV1(owner.task)
+	if err != nil || current != owner.birth {
+		return fmt.Errorf("original native filesystem role changed kernel birth: %v", err)
+	}
+	if err := owner.checkCurrentOriginalRoleV1(owner.witnesses[2:]); err != nil {
+		return err
+	}
+	if err := owner.checkLiveLockedV1(); err != nil {
+		return err
+	}
+	owner.final = &nativeOriginalFinalV1{original: owner}
+	return nil
+}
+
+// KillAndJoinV1 signals the original creation pidfd and waits through its
+// original os.Process, never a reopened PID or proc snapshot. Uncertainty
+// retains all native objects and the controller's owner entry.
+func (owner *NativeRoleCreationV1) KillAndJoinV1() error {
+	if owner == nil {
+		return fmt.Errorf("native role cancellation has no original creation owner")
+	}
+	owner.mu.Lock()
+	defer owner.mu.Unlock()
+	if owner.joined {
+		return nil
+	}
+	if owner.closed || owner.process == nil {
+		return fmt.Errorf("native role cancellation lost its original process owner")
+	}
+	var signalErr error
+	if owner.creation != nil {
+		signalErr = unix.PidfdSendSignal(int(owner.creation.Fd()), unix.SIGKILL, nil, 0)
+	} else {
+		// Start's unsupported-pidfd error cannot admit a role. The original
+		// os.Process may still be killed and positively waited for cleanup.
+		signalErr = owner.process.Kill()
+	}
+	if signalErr != nil && !errors.Is(signalErr, unix.ESRCH) && !errors.Is(signalErr, os.ErrProcessDone) {
+		return fmt.Errorf("signal original native creation for cancellation: %w", signalErr)
+	}
+	return owner.waitLockedV1()
+}
+
+// WaitV1 positively joins the original process created by this owner. A
+// non-zero or signalled exit is still a physical join, never an FS success.
+func (owner *NativeRoleCreationV1) WaitV1() error {
+	if owner == nil {
+		return fmt.Errorf("native role wait has no original creation owner")
+	}
+	owner.mu.Lock()
+	defer owner.mu.Unlock()
+	return owner.waitLockedV1()
+}
+
+func (owner *NativeRoleCreationV1) waitLockedV1() error {
+	if owner.joined {
+		return nil
+	}
+	if owner.closed || owner.process == nil {
+		return fmt.Errorf("native role wait lost its original process")
+	}
+	if owner.waitState == nil {
+		state, err := owner.process.Wait()
+		if err != nil || state == nil {
+			return fmt.Errorf("join same original native process: %v", err)
+		}
+		// Preserve the ACTUAL positive wait across a later pidfd uncertainty.
+		// A second check never substitutes a reconstructed process or wait DTO.
+		owner.waitState = state
+	}
+	status, ok := owner.waitState.Sys().(syscall.WaitStatus)
+	if !ok || !status.Exited() && !status.Signaled() {
+		return fmt.Errorf("original native wait did not report physical exit")
+	}
+	if owner.creation != nil {
+		events := []unix.PollFd{{Fd: int32(owner.creation.Fd()), Events: unix.POLLIN}}
+		n, err := unix.Poll(events, 0)
+		if err != nil || n != 1 || events[0].Revents&(unix.POLLERR|unix.POLLNVAL) != 0 || events[0].Revents&(unix.POLLIN|unix.POLLHUP) == 0 {
+			return fmt.Errorf("original creation pidfd did not confirm its positive wait: %v", err)
+		}
+	}
+	owner.joined = true
+	return nil
+}
+
+func (owner *NativeRoleCreationV1) requirePhysicalJoinV1() error {
+	if owner == nil {
+		return fmt.Errorf("native controller lost an original child owner")
+	}
+	owner.mu.Lock()
+	defer owner.mu.Unlock()
+	if !owner.joined {
+		return fmt.Errorf("native controller still owns an unjoined original child")
+	}
+	return nil
+}
+
+func (owner *NativeRoleCreationV1) Close() error {
+	if owner == nil {
+		return nil
+	}
+	owner.mu.Lock()
+	defer owner.mu.Unlock()
+	if owner.closed {
+		return nil
+	}
+	if !owner.joined {
+		return fmt.Errorf("native role objects remain held until the original physical join")
+	}
+	owner.closed = true
+	var result error
+	for _, file := range append([]*os.File{owner.creation, owner.code, owner.setup, owner.task, owner.endpoint}, owner.witnesses...) {
+		if file != nil {
+			result = errors.Join(result, file.Close())
+		}
+	}
+	if owner.parked != nil {
+		for _, file := range owner.parked.files {
+			result = errors.Join(result, file.Close())
+		}
+	}
+	if owner.closedExec != nil {
+		if owner.closedExec.state != nil {
+			result = errors.Join(result, owner.closedExec.state.Close())
+		}
+		for _, file := range owner.closedExec.creatorNamespaces {
+			result = errors.Join(result, file.Close())
+		}
+	}
+	return result
+}
+
+// OriginalExitCodeV1 projects only the SAME positively joined process result.
+// It grants no creation, final filesystem, aggregate or cleanup authority.
+func (owner *NativeRoleCreationV1) OriginalExitCodeV1() (int, error) {
+	if owner == nil {
+		return -1, fmt.Errorf("native role exit has no original process owner")
+	}
+	owner.mu.Lock()
+	defer owner.mu.Unlock()
+	if !owner.joined || owner.waitState == nil {
+		return -1, fmt.Errorf("native role exit has no original positive physical wait")
+	}
+	status, ok := owner.waitState.Sys().(syscall.WaitStatus)
+	if !ok {
+		return -1, fmt.Errorf("native role exit has another actual wait result")
+	}
+	if status.Exited() {
+		return status.ExitStatus(), nil
+	}
+	if status.Signaled() {
+		return 128 + int(status.Signal()), nil
+	}
+	return -1, fmt.Errorf("native role exit has no physical terminal status")
+}
