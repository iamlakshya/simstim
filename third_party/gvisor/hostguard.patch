+func TestNonSentryFilesystemCompletionAddsNoScopedDomain(t *testing.T) {
+	for _, abi := range []int{1, 2, 3, 4, 5, 6, 8, 9, 10, 11} {
+		attr := nativeFilesystemAttrV1(abi)
+		if attr.FS != nativeFSRightsV1(abi) || attr.Scoped != 0 {
+			t.Fatalf("ABI %d changed FS-only role policy: %+v", abi, attr)
+		}
+		if abi < 4 && attr.Net != 0 || abi >= 4 && abi < 10 && attr.Net != 3 || abi >= 10 && attr.Net != 15 {
+			t.Fatalf("ABI %d changed native network handling", abi)
+		}
+	}
+}
+
+// This focused native fixture is opt-in under the sole native validator's
+// resource gate. It does not construct a product NativeScope/role/receipt.
+// The actual raw-entry common scoped ancestry and systrap lineage still need
+// the complete original creation harness; this checks the FS-only mechanism.
+func TestNativeFSOnlyCurrentAndFutureThreadsV1(t *testing.T) {
+	if os.Getenv("GVISOR_NATIVE_FS_THREADS_V1") != "1" {
+		t.Skip("native thread fixture needs explicit validator admission")
+	}
+	dir := t.TempDir()
+	for _, name := range []string{"allowed", "denied"} {
+		if err := os.WriteFile(filepath.Join(dir, name), []byte("public fixture"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	child := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestNativeFSOnlyThreadFixtureV1$")
+	child.Env = append(os.Environ(), "GVISOR_NATIVE_FS_THREADS_CHILD_V1=1", "GVISOR_NATIVE_FS_THREADS_DIR_V1="+dir)
+	if output, err := child.CombinedOutput(); err != nil {
+		t.Fatalf("native filesystem thread fixture: %v\n%s", err, output)
+	}
+}
+
+func TestNativeFSOnlyThreadFixtureV1(t *testing.T) {
+	if os.Getenv("GVISOR_NATIVE_FS_THREADS_CHILD_V1") != "1" {
+		t.Skip("dedicated native child only")
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	dir := os.Getenv("GVISOR_NATIVE_FS_THREADS_DIR_V1")
+	if !filepath.IsAbs(dir) || filepath.Clean(dir) != dir {
+		t.Fatal("fixture has no exact parent-owned directory")
+	}
+	abi, err := nativeLandlockABIV1()
+	if err != nil || abi < 1 {
+		t.Fatalf("native Landlock unavailable: %v", err)
+	}
+	// Handle only file reads. Every other access class is unchanged by this
+	// fixture, so diagnostics and parent cleanup require no permission widening.
+	attr := nativeRulesetAttrV1{FS: 1 << 2}
+	fd, err := createNativeRulesetV1(&attr, abi)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(fd)
+	allowed := filepath.Join(dir, "allowed")
+	pathFD, err := unix.Open(allowed, unix.O_PATH|unix.O_CLOEXEC, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(pathFD)
+	rule := nativePathRuleV1{Allowed: 1 << 2, Parent: int32(pathFD)}
+	_, _, errno := unix.RawSyscall6(unix.SYS_LANDLOCK_ADD_RULE, uintptr(fd), 1, uintptr(unsafe.Pointer(&rule)), 0, 0, 0)
+	runtime.KeepAlive(rule)
+	if errno != 0 {
+		t.Fatal(errno)
+	}
+	const workers = 8
+	ready := make(chan int, workers)
+	run := make(chan struct{})
+	release := make(chan struct{})
+	results := make(chan error, workers+1)
+	check := func() error {
+		file, err := os.Open(allowed)
+		if err != nil {
+			return err
+		}
+		if err := file.Close(); err != nil {
+			return err
+		}
+		file, err = os.Open(filepath.Join(dir, "denied"))
+		if err == nil {
+			_ = file.Close()
+			return errors.New("a native thread read outside the same FS policy")
+		}
+		if !errors.Is(err, unix.EACCES) {
+			return err
+		}
+		return nil
+	}
+	// Keep every existing worker on its original kernel thread through the
+	// actual all-thread syscall and both reads. A later locked goroutine forces
+	// another thread while these workers and the main thread remain occupied.
+	for range workers {
+		go func() {
+			runtime.LockOSThread()
+			defer runtime.UnlockOSThread()
+			ready <- unix.Gettid()
+			<-run
+			results <- check()
+			<-release
+		}()
+	}
+	seen := map[int]bool{}
+	for range workers {
+		tid := <-ready
+		if seen[tid] {
+			t.Fatal("fixture reused a held original worker thread")
+		}
+		seen[tid] = true
+	}
+	if err := enforceNativeAllThreadsV1(fd); err != nil {
+		t.Fatal(err)
+	}
+	close(run)
+	for range workers {
+		if err := <-results; err != nil {
+			t.Fatal(err)
+		}
+	}
+	future := make(chan int, 1)
+	go func() {
+		runtime.LockOSThread()
+		defer runtime.UnlockOSThread()
+		future <- unix.Gettid()
+		results <- check()
+	}()
+	if tid := <-future; seen[tid] {
+		t.Fatal("future fixture reused a held original worker")
+	}
+	if err := <-results; err != nil {
+		t.Fatal(err)
+	}
+	if err := check(); err != nil {
+		t.Fatal(err)
+	}
+	close(release)
+}
