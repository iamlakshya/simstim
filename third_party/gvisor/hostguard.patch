+func TestNativeGoferDispatchRequiresExactOriginalInternalEntry(t *testing.T) {
+	originalArgs, originalScope, originalFinal := os.Args, nativeEntryScopeABIV1, nativeEntryFinalFSV1
+	defer func() {
+		os.Args, nativeEntryScopeABIV1, nativeEntryFinalFSV1 = originalArgs, originalScope, originalFinal
+	}()
+	nativeEntryScopeABIV1, nativeEntryFinalFSV1 = 6, 0
+	for _, args := range [][]string{
+		{"runsc", "native-gofer-setup-v1"},
+		{"native-gofer-setup-v1", "gofer"},
+		{"native-gofer-setup-v1", "native-gofer-setup-v1", "--spec-fd=4"},
+		{"native-sentry-setup-v1", "native-sentry-setup-v1"},
+	} {
+		os.Args = args
+		if NativeGoferSetupEntryV1() {
+			t.Fatal("public CLI or another role selected native Gofer dispatch", args)
+		}
+	}
+	os.Args = []string{"native-gofer-setup-v1", "native-gofer-setup-v1"}
+	if !NativeGoferSetupEntryV1() {
+		t.Fatal("exact fixed native Gofer entry was not recognised")
+	}
+	nativeEntryFinalFSV1 = 1
+	if NativeGoferSetupEntryV1() {
+		t.Fatal("final Sentry entry was reclassified as a Gofer setup")
+	}
+	nativeEntryFinalFSV1, nativeEntryScopeABIV1 = 0, 0
+	if NativeGoferSetupEntryV1() {
+		t.Fatal("argv alone supplied the native pre-Go scope")
+	}
+}
+
+func TestGoferCreationAndParkedIOCannotBeReconstructed(t *testing.T) {
+	for _, controller := range []*NativePrivateV1{nil, {}, {role: NativeControllerV1}, {role: NativeGoferV1}} {
+		if owner, err := controller.StartNativeGoferV1(NativeGoferCreationInputV1{}); err == nil || owner != nil {
+			t.Fatal("copied controller data created a native Gofer")
+		}
+	}
+	for _, owner := range []*NativeRoleCreationV1{nil, {}, {kind: NativeGoferV1}, {kind: NativeGoferV1, final: &nativeOriginalFinalV1{}}} {
+		if err := owner.ReceiveParkedGoferIOV1(); err == nil {
+			t.Fatal("copied role/final data supplied parked native streams")
+		}
+	}
+	setup := &NativeSentrySetupV1{kind: NativeGoferV1, phase: &NativePrivateV1{role: NativeGoferV1}}
+	if err := setup.PublishGoferWitnessesV1(); err == nil {
+		t.Fatal("copied setup data published an original Gofer endpoint")
+	}
