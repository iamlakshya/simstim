+		return fmt.Errorf("final typed state has another purpose or resource shape")
+	}
+	setupType, err := unix.GetsockoptInt(int(input.PublicSetup.Fd()), unix.SOL_SOCKET, unix.SO_TYPE)
+	if err != nil || setupType != unix.SOCK_STREAM {
+		return fmt.Errorf("final setup handoff is not its original native Unix stream: %v", err)
+	}
+	setupDomain, err := unix.GetsockoptInt(int(input.PublicSetup.Fd()), unix.SOL_SOCKET, unix.SO_DOMAIN)
+	if err != nil || setupDomain != unix.AF_UNIX {
+		return fmt.Errorf("final setup handoff has another native domain: %v", err)
+	}
+	topology := phase.topology
+	topology.mu.Lock()
+	defer topology.mu.Unlock()
+	if topology.closed || topology.descriptor == nil || len(topology.sources) != len(topology.wire.Mounts) {
+		return fmt.Errorf("final typed state lost its original topology")
+	}
+	wire := nativeFinalBootWireV1{Version: 1, ID: topology.wire.ID, Role: topology.wire.Role, CPUs: input.CPUs, MemoryMax: input.MemoryMax, HostMemory: input.HostMemory, Sources: []nativeFinalObjectV1{}, RootDev: owner.rootDev, RootIno: owner.rootIno, ProgramDev: owner.programDev, ProgramIno: owner.programIno}
+	handoff := &nativeFinalHandoffV1{original: owner}
+	complete := false
+	defer func() {
+		if !complete {
+			for _, file := range handoff.objects {
+				failure = errors.Join(failure, file.Close())
+			}
+			if handoff.sealedState != nil {
+				failure = errors.Join(failure, handoff.sealedState.Close())
+			}
+		}
+	}()
+	held, object, err := nativeRetainFinalObjectV1(topology.descriptor)
+	if err != nil {
+		return err
+	}
+	handoff.objects = append(handoff.objects, held)
+	wire.Topology = object
+	for index, source := range topology.sources {
+		identity, err := nativeObjectIdentityV1(source)
+		if err != nil || identity != topology.wire.Mounts[index].Identity {
+			return fmt.Errorf("final topology native source changed: %v", err)
+		}
+		held, object, err := nativeRetainFinalObjectV1(source)
+		if err != nil {
+			return err
+		}
+		handoff.objects = append(handoff.objects, held)
+		wire.Sources = append(wire.Sources, object)
+	}
+	if wire.Role == "guest-init" {
+		if err := nativeHelperGuestObjectV1(topology, input.Helper, input.HelperGuest); err != nil {
+			return err
+		}
+		held, object, err := nativeRetainFinalObjectV1(input.Helper)
+		if err != nil {
+			return err
+		}
+		handoff.objects = append(handoff.objects, held)
+		wire.Helper = &object
+		wire.HelperGuest = input.HelperGuest
+		info, err := held.Stat()
+		if err != nil {
+			return err
+		}
+		if info.Size() < 1 || info.Size() > 512<<20 {
+			return fmt.Errorf("final guest helper exceeds its fixed code bound")
+		}
+		digest := sha256.New()
+		n, err := io.Copy(digest, io.NewSectionReader(held, 0, info.Size()))
