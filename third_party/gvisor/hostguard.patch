+// SPDX-License-Identifier: Apache-2.0
+package cmd
+
+import (
+	"errors"
+	"fmt"
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+	"golang.org/x/sys/unix"
+	"gvisor.dev/gvisor/pkg/unet"
+	"gvisor.dev/gvisor/pkg/urpc"
+	"gvisor.dev/gvisor/runsc/boot/sentryapi"
+	"gvisor.dev/gvisor/runsc/cmd/sandboxsetup"
+	"gvisor.dev/gvisor/runsc/hostguard"
+)
+
+// RunNativeControllerV1 is the fixed controller body. Its initial input is
+// only the sealed public topology/code suite. Its fresh endpoint does not
+// receive the original guest stream until every actual local role is final.
+// The outside C/runtime owner must independently authenticate this original
+// controller and suite before lending that stream or any private operation.
+func RunNativeControllerV1() (failure error) {
+	owner, err := hostguard.CaptureNativeControllerSetupV1()
+	if err != nil {
+		return err
+	}
+	defer func() { failure = errors.Join(failure, owner.Close()) }()
+	phase, sentryInput, goferInput, err := owner.ControllerChildrenInputV1()
+	if err != nil {
+		return err
+	}
+	_, projection, _, err := owner.SetupProjectionV1()
+	if err != nil {
+		return err
+	}
+	if err := owner.PublishControllerWitnessesV1(); err != nil {
+		return err
+	}
+	var sentry, gofer *hostguard.NativeRoleCreationV1
+	defer func() {
+		// Actual same original sources are joined even when creation reports a
+		// later error. No setup EOF, aggregate value or cancellation retires them.
+		for _, child := range []*hostguard.NativeRoleCreationV1{sentry, gofer} {
+			if child != nil {
+				failure = errors.Join(failure, child.KillAndJoinV1())
+			}
+		}
+	}()
+	gofer, err = phase.StartNativeGoferV1(goferInput)
+	if err != nil {
+		return err
+	}
+	sentry, err = phase.StartNativeSentryV1(sentryInput)
+	if err != nil {
+		return err
+	}
+	if err := gofer.ReceiveOriginalWitnessesV1(); err != nil {
+		return err
+	}
+	if err := sentry.ReceiveOriginalWitnessesV1(); err != nil {
+		return err
+	}
+	if err := gofer.ReceiveFinalFilesystemV1(); err != nil {
+		return err
+	}
+	if err := gofer.ReceiveParkedGoferIOV1(); err != nil {
+		return err
+	}
+	if err := sentry.ReceiveFinalFilesystemV1(); err != nil {
+		return err
+	}
+	// No further topology or role creation follows. Own task/namespace sources
+	// are already held, and both children have completed their final topology.
+	if err := unix.Unmount("/proc", unix.MNT_DETACH); err != nil {
+		return fmt.Errorf("remove final controller proc mount: %w", err)
+	}
+	caps, err := sandboxsetup.ResolveThreadCaps(&specs.LinuxCapabilities{}, nil)
+	if err != nil {
+		return err
+	}
+	if err := caps.Apply(nil); err != nil {
+		return err
+	}
+	if err := hostguard.Disable(); err != nil {
+		return err
+	}
+	if err := phase.FinishCurrentRootV1(); err != nil {
+		return err
+	}
+	aggregate, err := phase.JoinNativeRoleAggregateV1(sentry, gofer)
+	if err != nil {
+		return err
+	}
+	if err := aggregate.PublishAggregateV1(); err != nil {
+		return err
+	}
+	if err := aggregate.ReceiveOriginalGuestV1(); err != nil {
+		return err
+	}
+	control, err := aggregate.ReleaseFinalIOV1()
+	if err != nil {
+		if control >= 0 {
+			_ = unix.Close(control)
+		}
+		return err
+	}
+	socket, err := unet.NewSocket(control)
+	if err != nil {
+		_ = unix.Close(control)
+		return err
+	}
+	client := urpc.NewClient(socket)
+	defer client.Close()
+	// The only RPC is the fixed root-start method and the sealed original ID.
+	// Network is fixed none; no caller RPC name, process data or environment is
+	// accepted by this controller, and no controller RPC listener is exported.
+	if err := client.Call(sentryapi.ContMgrRootContainerStart, &projection.ID, nil); err != nil {
+		return fmt.Errorf("start fixed native root: %w", err)
+	}
+	if err := sentry.WaitV1(); err != nil {
+		return err
+	}
+	code, err := sentry.OriginalExitCodeV1()
+	if err != nil {
+		return err
+	}
+	if code != 0 {
+		return fmt.Errorf("original native Sentry exited with code %d", code)
+	}
+	return nil
+}
