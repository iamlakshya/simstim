+// SPDX-License-Identifier: Apache-2.0
+package hostguard
+
+import (
+	"errors"
+	"fmt"
+	"golang.org/x/sys/unix"
+	"os"
+	"reflect"
+	"runtime"
+	"slices"
+	"strconv"
+	"syscall"
+)
+
+// nativeClosedRoleExecV1 is an explicit native source class, never an EACCES
+// fallback. Only the real synchronous fixed held-code StartProcess producer
+// below can issue it. Outside original C/runtime code-suite binding remains
+// independently mandatory before any private operation or late guest release.
+type nativeClosedRoleExecV1 struct {
+	original              *nativeClosedRoleExecV1
+	owner                 *NativeRoleCreationV1
+	process               *os.Process
+	creation, code, state *os.File
+	setup                 *NativeSentrySetupV1
+	creatorNamespaces     []*os.File
+	kind                  NativeRoleKindV1
+}
+
+type nativeClosedRolePlanV1 struct {
+	controller        *NativePrivateV1
+	code, state       *os.File
+	creatorNamespaces []*os.File
+	role              NativeRoleKindV1
+	path              string
+	argv              []string
+	attr              *os.ProcAttr
+	creation          *int
+	issued            bool
+}
+
+func (controller *NativePrivateV1) checkOriginalRoleInputV1(input NativeSentryCreationInputV1, role NativeRoleKindV1) error {
+	if controller == nil || controller.nativeSetup == nil || controller.nativeSetup.original != controller.nativeSetup || controller.nativeSetup.phase != controller || controller.nativeSetup.closed || controller.nativeSetup.kind != NativeControllerV1 || controller.nativeSetup.topology != controller.topology || len(controller.nativeSetup.controllerCode) != 3 {
+		return fmt.Errorf("native role input has no same original fixed controller setup")
+	}
+	setup := controller.nativeSetup
+	expected := controller.executable
+	if role == NativeSentryV1 {
+		expected = setup.controllerCode[0]
+	} else if role != NativeGoferV1 {
+		return fmt.Errorf("native role input has another continuation")
+	}
+	if err := errors.Join(nativeSameObjectV1(input.Sentry, expected), nativeSameObjectV1(input.ProcUmounter, setup.umounter)); err != nil {
+		return err
+	}
+	if input.Boot.CPUs != setup.wire.CPUs || input.Boot.MemoryMax != setup.wire.MemoryMax || input.Boot.HostMemory != setup.wire.HostMemory || input.Boot.HelperGuest != setup.wire.HelperGuest || input.Boot.PublicSetup != nil {
+		return fmt.Errorf("native role input changed its original public resource or code projection")
+	}
+	if setup.helper == nil {
+		if input.Boot.Helper != nil {
+			return fmt.Errorf("native role input invented another fixed helper")
+		}
+	} else if err := nativeSameObjectV1(input.Boot.Helper, setup.helper); err != nil {
+		return err
+	}
+	return nil
+}
+
+func nativeClosedRoleNameV1(role NativeRoleKindV1) (string, error) {
+	switch role {
+	case NativeSentryV1:
+		return "native-sentry-setup-v1", nil
+	case NativeGoferV1:
+		return "native-gofer-setup-v1", nil
+	default:
+		return "", fmt.Errorf("closed role exec has another fixed continuation")
+	}
+}
+func checkNativeClosedRoleAttrsV1(attr *syscall.SysProcAttr, creation *int) error {
+	if attr == nil || creation == nil || attr.PidFD != creation {
+		return fmt.Errorf("closed role lost its original atomic creation output")
+	}
+	actual := *attr
+	actual.PidFD = nil
+	expected := syscall.SysProcAttr{Cloneflags: unix.CLONE_NEWNS | unix.CLONE_NEWPID | unix.CLONE_NEWIPC | unix.CLONE_NEWNET | unix.CLONE_NEWCGROUP, Pdeathsig: syscall.SIGKILL}
+	if !reflect.DeepEqual(actual, expected) {
+		return fmt.Errorf("closed native role changed its exact namespace/credential/exec creation attributes")
+	}
+	return nil
+}
+func (plan *nativeClosedRolePlanV1) checkCallV1() error {
+	if plan == nil || plan.controller == nil || plan.code == nil || plan.state == nil || plan.attr == nil || plan.creation == nil || plan.issued {
+		return fmt.Errorf("closed native exec has no unconsumed original call source")
+	}
+	name, err := nativeClosedRoleNameV1(plan.role)
+	if err != nil {
+		return err
+	}
+	if !slices.Equal(plan.argv, []string{name, name}) || plan.attr.Dir != "/" || plan.attr.Env == nil || !slices.Equal(plan.attr.Env, []string{"PATH=/usr/bin:/bin", "LANG=C", "LC_ALL=C", "TZ=UTC"}) || len(plan.attr.Files) < 8 || plan.attr.Files[len(plan.attr.Files)-1] != plan.code || plan.path != "/proc/self/fd/"+strconv.Itoa(len(plan.attr.Files)-1) || plan.attr.Files[nativeSentrySetupStateFDV1] == nil {
+		return fmt.Errorf("closed role changed its fixed executable/argv/environment/public FD layout")
+	}
+	if err := checkNativeClosedRoleAttrsV1(plan.attr.Sys, plan.creation); err != nil {
+		return err
+	}
+	if err := nativeSameObjectV1(plan.state, plan.attr.Files[nativeSentrySetupStateFDV1]); err != nil {
+		return err
+	}
+	required := unix.F_SEAL_WRITE | unix.F_SEAL_GROW | unix.F_SEAL_SHRINK | unix.F_SEAL_SEAL
+	seals, err := unix.FcntlInt(plan.state.Fd(), unix.F_GET_SEALS, 0)
+	if err != nil || seals&required != required {
+		return fmt.Errorf("closed native call lost its original sealed public state: %v", err)
+	}
+	return checkNativeStaticRoleELFV1(plan.code)
+}
+
+// Caller holds controller.mu and locks its actual creator OS thread across
+// this capture, real StartProcess and issue. These parent-only NSFS/state FDs
+// are CLOEXEC and are not added to the child's closed public descriptor table.
+func prepareNativeClosedRolePlanV1(controller *NativePrivateV1, role NativeRoleKindV1, code *os.File, path string, argv []string, attr *os.ProcAttr, creation *int) (_ *nativeClosedRolePlanV1, failure error) {
+	if controller == nil || controller.nativeSetup == nil || controller.nativeSetup.original != controller.nativeSetup || controller.nativeSetup.phase != controller || controller.nativeSetup.kind != NativeControllerV1 || controller.nativeSetup.closed || len(controller.nativeSetup.controllerCode) != 3 || len(controller.namespaces) != 6 {
+		return nil, fmt.Errorf("closed role exec has no original fixed controller setup producer")
+	}
+	expected := controller.executable
+	if role == NativeSentryV1 {
+		expected = controller.nativeSetup.controllerCode[0]
+	} else if role != NativeGoferV1 {
+		return nil, fmt.Errorf("closed native role has another continuation")
+	}
+	if err := nativeSameObjectV1(code, expected); err != nil {
+		return nil, err
+	}
+	if attr == nil || len(attr.Files) <= nativeSentrySetupStateFDV1 || attr.Files[nativeSentrySetupStateFDV1] == nil {
+		return nil, fmt.Errorf("closed native role lost its actual sealed public state")
+	}
+	stateFD, err := unix.FcntlInt(attr.Files[nativeSentrySetupStateFDV1].Fd(), unix.F_DUPFD_CLOEXEC, 32)
+	if err != nil {
+		return nil, err
+	}
+	plan := &nativeClosedRolePlanV1{controller: controller, role: role, code: code, state: os.NewFile(uintptr(stateFD), "same-original-closed-role-state"), path: path, argv: argv, attr: attr, creation: creation}
+	complete := false
+	defer func() {
+		if !complete {
+			failure = errors.Join(failure, plan.closeV1())
+		}
+	}()
+	for index, name := range []string{"user", "pid", "mnt", "ipc", "net", "cgroup"} {
+		fd, err := unix.Open("/proc/thread-self/ns/"+name, unix.O_RDONLY|unix.O_CLOEXEC, 0)
+		if err != nil {
+			return nil, err
+		}
+		file := os.NewFile(uintptr(fd), "actual-closed-role-creator-namespace")
+		plan.creatorNamespaces = append(plan.creatorNamespaces, file)
+		if err := nativeSameObjectV1(file, controller.namespaces[index]); err != nil {
+			return nil, err
+		}
+	}
+	if err := plan.checkCallV1(); err != nil {
+		return nil, err
+	}
+	complete = true
+	return plan, nil
+}
+
+func (plan *nativeClosedRolePlanV1) issueV1(owner *NativeRoleCreationV1, process *os.Process) error {
+	if err := plan.checkCallV1(); err != nil {
+		return err
+	}
+	if owner == nil || process == nil || owner.closedExec != nil || owner.process != process || owner.controller != plan.controller || owner.code != plan.code || owner.kind != plan.role || owner.creation == nil || *plan.creation < 0 || int(owner.creation.Fd()) != *plan.creation {
+		return fmt.Errorf("closed role exec differs from its real original synchronous creation")
+	}
+	if err := owner.checkLiveLockedV1(); err != nil {
+		return err
+	}
+	receipt := &nativeClosedRoleExecV1{owner: owner, process: process, creation: owner.creation, code: owner.code, state: plan.state, creatorNamespaces: plan.creatorNamespaces, setup: plan.controller.nativeSetup, kind: plan.role}
+	receipt.original = receipt
+	owner.closedExec = receipt
+	plan.state = nil
+	plan.creatorNamespaces = nil
+	plan.issued = true
+	return nil
+}
+func (plan *nativeClosedRolePlanV1) closeV1() error {
+	if plan == nil {
+		return nil
+	}
+	var result error
+	if plan.state != nil {
+		result = errors.Join(result, plan.state.Close())
+	}
+	for _, file := range plan.creatorNamespaces {
+		result = errors.Join(result, file.Close())
+	}
+	return result
+}
+
+// The continuation is closed in the held signed code: Gofer is pure-Go with
+// no re-exec/userns FD and cannot start service before its final FS/GOF; Sentry
+// executes only initial setup, positively joined fixed tiny unmount, SAMEPID
+// SAME held-code final exec, raw pre-Go FS, NWV and FSV. No argv/env/OCI/private
+// input or other executable runs on either path before the actual aggregate.
+func (receipt *nativeClosedRoleExecV1) checkV1(owner *NativeRoleCreationV1, namespaces []*os.File) error {
+	if receipt == nil || receipt.original != receipt || owner == nil || owner.controller == nil || receipt.process == nil || receipt.creation == nil || receipt.code == nil || receipt.state == nil || receipt.owner != owner || owner.closedExec != receipt || receipt.process != owner.process || receipt.creation != owner.creation || receipt.code != owner.code || receipt.kind != owner.kind || receipt.setup == nil || receipt.setup.original != receipt.setup || receipt.setup != owner.controller.nativeSetup || receipt.setup.phase != owner.controller || len(receipt.creatorNamespaces) != 6 || len(namespaces) != 6 {
+		return fmt.Errorf("closed role proof has another original native exec source")
+	}
+	if receipt.kind != NativeSentryV1 && receipt.kind != NativeGoferV1 {
+		return fmt.Errorf("closed role proof has another allowed continuation")
+	}
+	if err := owner.checkLiveLockedV1(); err != nil {
+		return err
+	}
+	if err := checkNativeStaticRoleELFV1(receipt.code); err != nil {
+		return err
+	}
+	required := unix.F_SEAL_WRITE | unix.F_SEAL_GROW | unix.F_SEAL_SHRINK | unix.F_SEAL_SEAL
+	seals, err := unix.FcntlInt(receipt.state.Fd(), unix.F_GET_SEALS, 0)
+	if err != nil || seals&required != required {
+		return fmt.Errorf("closed role lost its original immutable state: %v", err)
+	}
+	for index, file := range receipt.creatorNamespaces {
+		if err := nativeSameObjectV1(file, owner.controller.namespaces[index]); err != nil {
+			return err
+		}
+	}
+	if owner.endpoint == nil {
+		if owner.namespaceProof != nil || len(owner.witnesses) != 0 {
+			return fmt.Errorf("closed role namespace receive is out of order")
+		}
+		for index, kind := range []int{unix.CLONE_NEWUSER, unix.CLONE_NEWPID, unix.CLONE_NEWNS, unix.CLONE_NEWIPC, unix.CLONE_NEWNET, unix.CLONE_NEWCGROUP} {
+			if err := nativeNamespaceRelatedV1(namespaces[index], receipt.creatorNamespaces[0], receipt.creatorNamespaces[index], kind); err != nil {
+				return err
+			}
+		}
+	} else {
+		proof := owner.namespaceProof
+		if proof == nil || proof.owner != owner || len(proof.children) != 6 || len(owner.witnesses) != 8 {
+			return fmt.Errorf("closed role has no original native namespace-relationship receive")
+		}
+		for index, original := range proof.children {
+			if original != owner.witnesses[2+index] {
+				return fmt.Errorf("closed role changed its original namespace receive objects")
+			}
+			if err := nativeSameObjectV1(namespaces[index], original); err != nil {
+				return err
+			}
+		}
+	}
+	return owner.checkLiveLockedV1()
+}
+
+// Source classification is explicit before any observation. Generic actors
+// retain strict current task/exe/ns checks; failed opens never select a receipt.
+func (owner *NativeRoleCreationV1) checkCurrentOriginalRoleV1(namespaces []*os.File) error {
+	if owner == nil {
+		return fmt.Errorf("native current role has no original creation source")
+	}
+	if owner.closedExec != nil {
+		return owner.closedExec.checkV1(owner, namespaces)
+	}
+	if len(namespaces) != 6 {
+		return fmt.Errorf("native current role lost its original namespace vector")
+	}
+	if err := nativeCurrentActorCodeV1(owner.task, owner.code); err != nil {
+		return err
+	}
+	for index, name := range []string{"user", "pid", "mnt", "ipc", "net", "cgroup"} {
+		if err := nativeCurrentActorNamespaceV1(owner.task, namespaces[index], name); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// runNativeClosedRoleStartV1 contains the ONLY real StartProcess call allowed
+// to issue this source class. It publishes the original child owner before
+// receipt checks can fail, and transfers no private descriptor or payload.
+func runNativeClosedRoleStartV1(controller *NativePrivateV1, owner *NativeRoleCreationV1, path string, argv []string, attr *os.ProcAttr, creation *int) (_ *os.Process, failure error) {
+	if controller == nil || owner == nil {
+		return nil, fmt.Errorf("closed role start has no original controller or child owner")
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	plan, err := prepareNativeClosedRolePlanV1(controller, owner.kind, owner.code, path, argv, attr, creation)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { failure = errors.Join(failure, plan.closeV1()) }()
+	process, err := os.StartProcess(path, argv, attr)
+	if err != nil {
+		return nil, err
+	}
+	owner.process = process
+	controller.children = append(controller.children, owner)
+	if *creation < 0 {
+		return process, fmt.Errorf("closed native role has no original atomic creation pidfd")
+	}
+	owner.creation = os.NewFile(uintptr(*creation), "same-original-closed-role-creation")
+	if err := plan.issueV1(owner, process); err != nil {
+		return process, err
+	}
+	return process, nil
+}
