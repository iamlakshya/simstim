+// SPDX-License-Identifier: Apache-2.0
+package hostguard
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"runtime"
+	"strconv"
+	"syscall"
+
+	"golang.org/x/sys/unix"
+)
+
+const nativeFinalSentryPathV1 = "/.native-final-sentry-v1"
+const nativeFinalEntryRulesetFDV1 = 1023
+const nativeFinalEntryOwnTaskFDV1 = 1021
+const nativeFinalEntryNamespacesFDV1 = 1014
+
+// NativeFinalExecV1 is a private same-process re-exec producer. It is created
+// only from this actual role's captured executable and immutable topology.
+// There is no executable path, argv, environment, OCI or skip-policy argument.
+// The exact original creation pidfd stays owned across the exec transition.
+type nativeFinalHandoffV1 struct {
+	original    *NativeFinalExecV1
+	sealedState *os.File
+	publicSetup *os.File
+	// Same owned native source objects survive this exact process's exec.
+	objects []*os.File
+}
+
+type NativeFinalExecV1 struct {
+	phase                  *NativePrivateV1
+	rootDev, rootIno       uint64
+	programDev, programIno uint64
+	installed, consumed    bool
+	handoff                *nativeFinalHandoffV1
+}
+
+// BindFinalSentryV1 runs during trusted topology, before the new root is
+// sealed or pivoted. Both paths used by mount are fixed native FD links, not
+// host paths accepted from a caller. The resulting code mount is read-only,
+// nosuid and nodev; only this verified code object may be executed finally.
+func (phase *NativePrivateV1) BindFinalSentryV1(root *os.File) (_ *NativeFinalExecV1, failure error) {
+	if phase == nil || root == nil {
+		return nil, fmt.Errorf("final native exec lacks its actual root/role")
+	}
+	phase.mu.Lock()
+	defer phase.mu.Unlock()
+	if err := phase.checkLocked(); err != nil {
+		return nil, err
+	}
+	if phase.role != NativeSentryV1 || phase.final || phase.consumed {
+		return nil, fmt.Errorf("final native exec has another role or phase")
+	}
+	var rootStat, programStat unix.Stat_t
+	if err := unix.Fstat(int(root.Fd()), &rootStat); err != nil {
+		return nil, err
+	}
+	if rootStat.Mode&unix.S_IFMT != unix.S_IFDIR {
+		return nil, fmt.Errorf("final native root is not the actual directory")
+	}
+	if err := unix.Fstat(int(phase.executable.Fd()), &programStat); err != nil {
+		return nil, err
+	}
+	if programStat.Mode&unix.S_IFMT != unix.S_IFREG || programStat.Mode&0111 == 0 || programStat.Mode&(unix.S_ISUID|unix.S_ISGID) != 0 {
+		return nil, fmt.Errorf("final native code lost its original executable shape")
+	}
+	fd, err := unix.Openat(int(root.Fd()), nativeFinalSentryPathV1[1:], unix.O_CREAT|unix.O_EXCL|unix.O_RDWR|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0500)
+	if err != nil {
+		return nil, err
+	}
+	destination := os.NewFile(uintptr(fd), "fixed-final-sentry-target")
+	defer func() { failure = errors.Join(failure, destination.Close()) }()
+	sourcePath := "/proc/self/fd/" + strconv.Itoa(int(phase.executable.Fd()))
+	// Resolve the fixed child through the actual root descriptor after the
+	// bind. The pre-bind target FD continues to name the covered old inode.
+	targetPath := "/proc/self/fd/" + strconv.Itoa(int(root.Fd())) + nativeFinalSentryPathV1
+	if err := unix.Mount(sourcePath, targetPath, "", unix.MS_BIND, ""); err != nil {
+		return nil, err
+	}
+	// Mount attributes are per mount; MS_BIND alone does not make it read-only.
+	if err := unix.Mount("", targetPath, "", unix.MS_REMOUNT|unix.MS_BIND|unix.MS_RDONLY|unix.MS_NOSUID|unix.MS_NODEV, ""); err != nil {
+		return nil, err
+	}
+	// Opening through the final root verifies the new binding resolves to the
+	// SAME original native executable, independently of the now-covered target.
+	captured, err := unix.Openat(int(root.Fd()), nativeFinalSentryPathV1[1:], unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return nil, err
+	}
+	var bound unix.Stat_t
+	statErr := unix.Fstat(captured, &bound)
+	closeErr := unix.Close(captured)
+	if statErr != nil || closeErr != nil || bound.Dev != programStat.Dev || bound.Ino != programStat.Ino {
+		return nil, errors.Join(statErr, closeErr, fmt.Errorf("final native code bind differs from its actual original object"))
+	}
+	return &NativeFinalExecV1{phase: phase, rootDev: uint64(rootStat.Dev), rootIno: rootStat.Ino, programDev: uint64(programStat.Dev), programIno: programStat.Ino, installed: true}, nil
+}
+
+// ExecV1 is the irreversible final boundary, called only after the last
+// mount/pivot/unmount and positive original tiny-role join, BEFORE Loader.New
+// or platform.New. The original public setup state/FD lineage must already be
+// installed by the closed entry producer; no private endpoint is inherited.
+func (owner *NativeFinalExecV1) ExecV1() error {
+	if owner == nil || owner.phase == nil {
+		return fmt.Errorf("native final exec has no original producer")
+	}
+	phase := owner.phase
+	phase.mu.Lock()
+	defer phase.mu.Unlock()
+	if err := phase.checkLocked(); err != nil {
+		return err
+	}
+	if !owner.installed || owner.consumed || phase.role != NativeSentryV1 || phase.final || phase.consumed {
+		return fmt.Errorf("native final exec was reused or changed purpose")
+	}
+	if owner.handoff == nil || owner.handoff.original != owner || owner.handoff.sealedState == nil {
+		return fmt.Errorf("native final exec has no actual closed immutable setup/FD handoff")
+	}
+	rootFD, err := unix.Open("/", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return err
+	}
+	root := os.NewFile(uintptr(rootFD), "actual-final-sentry-root")
+	defer root.Close()
+	var actualRoot unix.Stat_t
+	if err := unix.Fstat(rootFD, &actualRoot); err != nil {
+		return err
+	}
+	if uint64(actualRoot.Dev) != owner.rootDev || actualRoot.Ino != owner.rootIno {
+		return fmt.Errorf("native final exec did not reach its original constructed root")
+	}
+	program, err := os.Open(nativeFinalSentryPathV1)
+	if err != nil {
+		return err
+	}
+	defer program.Close()
+	var code unix.Stat_t
+	if err := unix.Fstat(int(program.Fd()), &code); err != nil {
+		return err
+	}
+	if uint64(code.Dev) != owner.programDev || code.Ino != owner.programIno {
+		return fmt.Errorf("native final path no longer names its captured code object")
+	}
+	roots, err := phase.topology.policyRootsV1(root)
+	if err != nil {
+		return err
+	}
+	roots = append(roots, NativeFSRootV1{File: phase.executable, Executable: true}, NativeFSRootV1{File: phase.task})
+	policy, err := PrepareNativeFilesystemV1(phase.scope, roots)
+	if err != nil {
+		return err
+	}
+	phase.policy = policy
+	// Exec inherits only actual owned setup objects, never a future private
+	// endpoint. Other Go/runtime descriptors are marked close-on-exec first.
+	if err := unix.CloseRange(3, 0xffffffff, unix.CLOSE_RANGE_CLOEXEC); err != nil {
+		return fmt.Errorf("bound final setup inheritance: %w", err)
+	}
+	for _, object := range owner.handoff.objects {
+		if object == owner.handoff.publicSetup {
+			continue
+		} // only the one fixed SETUP alias survives
+		if _, err := unix.FcntlInt(object.Fd(), unix.F_SETFD, 0); err != nil {
+			return err
+		}
+	}
+	var entryCopies []*os.File
+	defer func() {
+		for _, file := range entryCopies {
+			_ = file.Close()
+		}
+	}()
+	for _, entry := range []struct {
+		target int
+		file   *os.File
+	}{
+		{nativeFinalEntryStateFDV1, owner.handoff.sealedState},
+		{nativeFinalEntrySetupFDV1, owner.handoff.publicSetup},
+	} {
+		if entry.file == nil {
+			return fmt.Errorf("final entry handoff object is missing")
+		}
+		if _, err := unix.FcntlInt(uintptr(entry.target), unix.F_GETFD, 0); err == nil || !errors.Is(err, unix.EBADF) {
