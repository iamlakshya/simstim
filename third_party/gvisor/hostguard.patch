+// NativeSentrySetupEntryV1 recognises the exact internal setup role after the
+// real raw common-scope entry. It is neither a public CLI option nor a final
+// filesystem receipt. Missing inherited public objects make capture refuse.
+func NativeSentrySetupEntryV1() bool {
+	return nativeEntryScopeABIV1 != 0 && nativeEntryFinalFSV1 == 0 && len(os.Args) == 2 && os.Args[0] == "native-sentry-setup-v1" && os.Args[1] == "native-sentry-setup-v1"
