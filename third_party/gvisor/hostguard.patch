+	// closed high slot belongs only to the actual final entry layout producer.
+	if _, err := unix.FcntlInt(nativeFinalEntryRulesetFDV1, unix.F_GETFD, 0); err == nil || !errors.Is(err, unix.EBADF) {
+		return fmt.Errorf("native final ruleset slot is already occupied: %v", err)
+	}
+	reserved, err := unix.FcntlInt(uintptr(policy.fd), unix.F_DUPFD_CLOEXEC, nativeFinalEntryRulesetFDV1)
+	if err != nil {
+		return err
+	}
+	if reserved != nativeFinalEntryRulesetFDV1 {
+		_ = unix.Close(reserved)
+		return fmt.Errorf("native final ruleset reservation collided")
+	}
+	slot := os.NewFile(uintptr(reserved), "actual-final-entry-kernel-ruleset")
+	defer slot.Close()
+	if _, err := unix.FcntlInt(slot.Fd(), unix.F_SETFD, 0); err != nil {
+		return err
+	}
