+
+// SetupProjectionV1 supplies only the original native phase and public fixed
+// guest data. These are not an original creation or private release capability.
+func (owner *NativeSentrySetupV1) SetupProjectionV1() (*NativePrivateV1, NativeGuestProjectionV1, NativeFinalBootInputV1, error) {
+	var projection NativeGuestProjectionV1
+	var input NativeFinalBootInputV1
+	if owner == nil || owner.original != owner || owner.closed || owner.phase == nil || owner.setup == nil || owner.umounter == nil {
