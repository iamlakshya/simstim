+// SPDX-License-Identifier: Apache-2.0
+package hostguard
+
+import (
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"os"
+
+	"golang.org/x/sys/unix"
+)
+
+// CreateFinalGoferIOV1 creates each actual lisafs socketpair only AFTER the
+// Gofer's native final FS result and current ND0. It transfers the opposite
+// ends to the original controller to park until its aggregate proof is closed.
+// No RPC can run until the fresh endpoint receives the exact later release.
+// Neither a vector count nor a copied role can reach this producer.
+func (phase *NativePrivateV1) CreateFinalGoferIOV1() (_ []int, failure error) {
+	if phase == nil {
+		return nil, fmt.Errorf("native Gofer IO has no original final role")
+	}
+	phase.mu.Lock()
+	defer phase.mu.Unlock()
+	if err := phase.checkLocked(); err != nil {
+		return nil, err
+	}
+	if phase.role != NativeGoferV1 || !phase.published || !phase.final || phase.policy == nil || phase.consumed {
+		return nil, fmt.Errorf("native Gofer IO preceded its actual final filesystem result")
+	}
+	if err := phase.policy.finalReceiptV1(); err != nil {
+		return nil, err
+	}
+	count := len(phase.topology.wire.Mounts) + 1
+	if count < 1 || count > 1025 {
+		return nil, fmt.Errorf("native Gofer IO exceeds its original topology")
+	}
+	var servers, peers []*os.File
+	var result []int
+	complete := false
+	defer func() {
+		for _, file := range append(servers, peers...) {
+			failure = errors.Join(failure, file.Close())
+		}
+		if !complete {
+			for _, fd := range result {
+				failure = errors.Join(failure, unix.Close(fd))
+			}
+		}
+	}()
+	for index := 0; index < count; index++ {
+		pair, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_STREAM|unix.SOCK_CLOEXEC, 0)
+		if err != nil {
+			return nil, err
+		}
+		servers = append(servers, os.NewFile(uintptr(pair[0]), "post-final-FS-Gofer-server"))
+		peers = append(peers, os.NewFile(uintptr(pair[1]), "post-final-FS-Gofer-parked-client"))
+	}
+	for offset := 0; offset < count; {
+		next := min(240, count-offset)
+		data := make([]byte, 10)
+		copy(data, "GIO\x01")
+		binary.BigEndian.PutUint16(data[4:6], uint16(count))
+		binary.BigEndian.PutUint16(data[6:8], uint16(offset))
+		binary.BigEndian.PutUint16(data[8:10], uint16(next))
+		var rights []int
+		for _, peer := range peers[offset : offset+next] {
+			rights = append(rights, int(peer.Fd()))
+		}
+		if n, err := unix.SendmsgN(int(phase.local.Fd()), data, unix.UnixRights(rights...), nil, unix.MSG_NOSIGNAL); err != nil || n != len(data) {
+			return nil, fmt.Errorf("park complete original Gofer IO batch: %v", err)
+		}
+		offset += next
+	}
+	// The controller now has native objects to park, but guest RPC has still
+	// never run. This exact fresh channel is the only release input.
+	data := make([]byte, 5)
+	ancillary := make([]byte, unix.CmsgSpace(unix.SizeofUcred)+unix.CmsgSpace(4))
+	n, oobn, flags, _, err := unix.Recvmsg(int(phase.local.Fd()), data, ancillary, unix.MSG_CMSG_CLOEXEC)
+	if err != nil {
+		return nil, err
+	}
+	messages, parseErr := unix.ParseSocketControlMessage(ancillary[:oobn])
+	credentials, extraRights := 0, 0
+	var semanticErr error
+	for _, message := range messages {
+		if message.Header.Level == unix.SOL_SOCKET && message.Header.Type == unix.SCM_RIGHTS {
+			rights, err := unix.ParseUnixRights(&message)
+			semanticErr = errors.Join(semanticErr, err, fmt.Errorf("Gofer release cannot contain descriptor rights"))
+			extraRights += len(rights)
+			for _, fd := range rights {
+				semanticErr = errors.Join(semanticErr, unix.Close(fd))
+			}
+		} else if message.Header.Level == unix.SOL_SOCKET && message.Header.Type == unix.SCM_CREDENTIALS {
+			credentials++
+			_, err := unix.ParseUnixCredentials(&message)
+			semanticErr = errors.Join(semanticErr, err)
+		} else {
+			semanticErr = errors.Join(semanticErr, fmt.Errorf("Gofer release contains unsupported ancillary data"))
+		}
+	}
+	if parseErr != nil || semanticErr != nil || flags&(unix.MSG_TRUNC|unix.MSG_CTRUNC) != 0 || n != 4 || string(data[:n]) != "GOF\x01" || credentials != 1 || extraRights != 0 {
+		return nil, fmt.Errorf("native Gofer release has another closed role: %v", errors.Join(parseErr, semanticErr))
+	}
+	if err := phase.scope.check(); err != nil {
+		return nil, err
+	}
+	for _, server := range servers {
+		fd, err := unix.FcntlInt(server.Fd(), unix.F_DUPFD_CLOEXEC, 3)
+		if err != nil {
+			return nil, err
+		}
+		result = append(result, fd)
+	}
+	phase.consumed = true
+	complete = true
+	return result, nil
+}
