+// Copyright 2026 The gVisor Authors.
+// SPDX-License-Identifier: Apache-2.0
+package sandboxsetup
+
+import (
+	"errors"
+	"fmt"
+	"math"
+	"os"
+	"os/exec"
+	"sync"
+
+	"golang.org/x/sys/unix"
+)
+
+// NativeProcUmounterV1 owns the exact fixed tiny role's creation pidfd and
+// Cmd. EOF and Wait4(0) are deliberately absent from its physical proof.
+// The original signed runtime producer supplies the already-verified code;
+// this constructor accepts no path, arbitrary argv, namespace or private FD.
+type NativeProcUmounterV1 struct {
+	mu                   sync.Mutex
+	cmd                  *exec.Cmd
+	creation, gate, code *os.File
+	finished             bool
+	result               error
+}
+
+func StartNativeProcUmounterV1(program *os.File) (_ *NativeProcUmounterV1, failure error) {
+	if program == nil {
+		return nil, fmt.Errorf("native proc umounter lost its verified code object")
+	}
+	retained, err := unix.FcntlInt(program.Fd(), unix.F_DUPFD_CLOEXEC, 3)
+	if err != nil {
+		return nil, err
+	}
+	owner := &NativeProcUmounterV1{code: os.NewFile(uintptr(retained), "same-native-proc-umounter")}
+	started := false
+	defer func() {
+		if !started {
+			if owner.gate != nil {
+				failure = errors.Join(failure, owner.gate.Close())
+			}
+			failure = errors.Join(failure, owner.code.Close())
+		}
+	}()
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		return nil, err
+	}
+	defer reader.Close()
+	owner.gate = writer
+	null, err := os.OpenFile("/dev/null", os.O_RDWR, 0)
+	if err != nil {
+		return nil, err
+	}
+	defer null.Close()
+	// The fixed tiny role receives ONLY null stdio, its activation pipe and
+	// verified code. Inherited public setup/source descriptors must not leak
+	// merely because they arrived without CLOEXEC in this trusted setup role.
+	if err := unix.CloseRange(3, math.MaxUint32, unix.CLOSE_RANGE_CLOEXEC); err != nil {
+		return nil, fmt.Errorf("bound native proc-umounter descriptor vector: %w", err)
+	}
+	pidfd := -1
+	cmd := exec.Command("/proc/self/fd/4", "/proc")
+	cmd.Args[0] = "native-proc-umounter-v1"
+	cmd.ExtraFiles = []*os.File{reader, owner.code}
+	cmd.Stdin, cmd.Stdout, cmd.Stderr = null, null, null
+	cmd.Env = []string{"PATH=/usr/bin:/bin", "LANG=C", "LC_ALL=C", "TZ=UTC"}
+	cmd.Dir = "/"
+	cmd.SysProcAttr = &unix.SysProcAttr{PidFD: &pidfd, Pdeathsig: unix.SIGKILL}
+	owner.cmd = cmd
+	if err := cmd.Start(); err != nil {
+		return nil, err
+	}
+	started = true
+	if pidfd < 0 {
+		// The caller must fail its original scope and retain uncertainty. Never
+		// reconstruct a pidfd from cmd.Process.Pid or equate EOF with tiny exit.
+		return owner, fmt.Errorf("native proc umounter has no original creation pidfd")
+	}
+	owner.creation = os.NewFile(uintptr(pidfd), "actual-proc-umounter-creation")
+	return owner, nil
+}
+
+// FinishV1 executes one fixed unmount and joins THIS actual creation-bound
+// child. Every failure keeps the owner live until physical exit is positive.
+func (owner *NativeProcUmounterV1) FinishV1() error {
+	if owner == nil {
+		return fmt.Errorf("native proc umounter has no actual creation owner")
+	}
+	owner.mu.Lock()
+	defer owner.mu.Unlock()
+	if owner.finished {
+		return owner.result
+	}
+	if owner.creation == nil || owner.cmd == nil || owner.gate == nil {
+		return fmt.Errorf("native proc umounter original lifetime is uncertain")
+	}
+	n, writeErr := owner.gate.Write([]byte{0})
+	if n != 1 && writeErr == nil {
+		writeErr = fmt.Errorf("native proc umounter activation was incomplete")
+	}
+	closeErr := owner.gate.Close()
+	if writeErr != nil || closeErr != nil {
+		_ = unix.PidfdSendSignal(int(owner.creation.Fd()), unix.SIGKILL, nil, 0)
+	}
+	for {
+		poll := []unix.PollFd{{Fd: int32(owner.creation.Fd()), Events: unix.POLLIN}}
+		_, err := unix.Poll(poll, -1)
+		if errors.Is(err, unix.EINTR) {
+			continue
+		}
+		if err != nil {
+			return errors.Join(writeErr, closeErr, err)
+		}
+		if poll[0].Revents&(unix.POLLERR|unix.POLLNVAL) != 0 {
+			return fmt.Errorf("native proc umounter creation descriptor became uncertain")
+		}
+		if poll[0].Revents&unix.POLLIN != 0 {
+			break
+		}
+	}
+	waitErr := owner.cmd.Wait()
+	owner.result = errors.Join(writeErr, closeErr, waitErr, owner.creation.Close(), owner.code.Close())
+	owner.finished = true
+	if owner.result != nil {
+		return owner.result
+	}
+	if owner.cmd.ProcessState == nil || !owner.cmd.ProcessState.Success() {
+		owner.result = fmt.Errorf("native proc umounter did not exit successfully")
+		return owner.result
+	}
+	if err := unix.Access("/proc/self", unix.F_OK); err != unix.ENOENT {
+		owner.result = fmt.Errorf("native proc unmount left proc accessible: %v", err)
+	}
+	return owner.result
+}
