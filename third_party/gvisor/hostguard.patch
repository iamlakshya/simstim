+func TestClosedControllerSetupBindsDistinctCompleteNativeCodeRoles(t *testing.T) {
+	boot := nativeFinalBootWireV1{Version: 1, ID: "aaaa2222", Role: "probe-true", CPUs: 2, MemoryMax: 512 << 20, HostMemory: 4 << 30, Topology: nativeFinalObjectV1{FD: 5, Dev: 1, Ino: 2}, Sources: []nativeFinalObjectV1{}, RootDev: 1, RootIno: 4, ProgramDev: 1, ProgramIno: 5}
+	bootRaw, err := json.Marshal(boot)
+	if err != nil {
+		t.Fatal(err)
+	}
+	base := nativeSentrySetupWireV1{Version: 1, Boot: bootRaw, ProcUmounter: nativeFinalObjectV1{FD: 6, Dev: 1, Ino: 6}, Program: nativeFinalObjectV1{FD: 7, Dev: 1, Ino: 5}}
+	baseRaw, err := json.Marshal(base)
+	if err != nil {
+		t.Fatal(err)
+	}
+	wire := nativeControllerSetupWireV1{Version: 1, Setup: baseRaw, Sentry: nativeFinalObjectV1{FD: 8, Dev: 1, Ino: 7}, FDParking: nativeFinalObjectV1{FD: 9, Dev: 1, Ino: 8}, Prewarmer: nativeFinalObjectV1{FD: 10, Dev: 1, Ino: 9}}
+	raw, err := json.Marshal(wire)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, code, err := decodeNativeControllerSetupV1(raw); err != nil || len(code) != 3 {
+		t.Fatal("complete distinct public code roles rejected", err)
+	}
+	original := string(raw)
+	for _, bad := range []string{
+		strings.Replace(original, `"v":1`, `"v":1,"private_op":9`, 1),
+		strings.Replace(original, `"v":1`, `"v":1,"guest_link":3`, 1),
+		strings.Replace(original, `"v":1`, `"v":1,"argv":["/bin/sh"]`, 1),
+		strings.Replace(original, `"v":1`, `"v":1,"V":1`, 1),
+		strings.Replace(original, `"sentry":{"fd":8,"dev":1,"ino":7}`, `"sentry":{"fd":7,"dev":1,"ino":7}`, 1),
+		strings.Replace(original, `"fdparking":{"fd":9,"dev":1,"ino":8}`, `"fdparking":{"fd":9,"dev":1,"ino":5}`, 1),
+		strings.Replace(original, `"prewarmer":{"fd":10,"dev":1,"ino":9}`, `"prewarmer":{"fd":10,"dev":1,"ino":8}`, 1),
+		strings.Replace(original, `"prewarmer":{"fd":10,"dev":1,"ino":9}`, `"prewarmer":null`, 1),
+	} {
+		if _, _, _, err := decodeNativeControllerSetupV1([]byte(bad)); err == nil {
+			t.Fatal("private payload or foreign native code role passed", bad)
+		}
+	}
+}
+
+func TestAggregateCannotBeIssuedFromCopiedRoleData(t *testing.T) {
+	phase := &NativePrivateV1{role: NativeControllerV1, published: true, final: true}
+	if aggregate, err := phase.JoinNativeRoleAggregateV1(&NativeRoleCreationV1{}, &NativeRoleCreationV1{}); err == nil || aggregate != nil {
+		t.Fatal("copied role fields issued native aggregate")
+	}
+	for _, aggregate := range []*NativeRoleAggregateV1{nil, {}, {controller: phase, published: true, received: true}} {
+		if err := aggregate.PublishAggregateV1(); err == nil {
+			t.Fatal("copied fields published native aggregate")
+		}
+		if err := aggregate.ReceiveOriginalGuestV1(); err == nil {
+			t.Fatal("copied fields received private guest")
+		}
+		if fd, err := aggregate.ReleaseFinalIOV1(); err == nil || fd != -1 {
+			t.Fatal("copied fields released private native IO")
+		}
+	}
+	setup := &NativeSentrySetupV1{kind: NativeControllerV1}
+	if _, _, _, err := setup.ControllerChildrenInputV1(); err == nil {
+		t.Fatal("copied controller setup supplied code authority")
+	}
+}
+
+func TestControllerSetupUnknownChildCloseRetainsOriginalOwner(t *testing.T) {
+	file, err := os.CreateTemp(t.TempDir(), "public-setup")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer file.Close()
+	phase := &NativePrivateV1{children: []*NativeRoleCreationV1{{}}}
+	owner := &NativeSentrySetupV1{phase: phase, setup: file}
+	for range 2 {
+		if err := owner.Close(); err == nil {
+			t.Fatal("unknown original child became successful setup closure")
+		}
+		if owner.closed || phase.closed {
+			t.Fatal("unknown original child invalidated retryable native owner")
+		}
+		if _, err := file.Stat(); err != nil {
+			t.Fatal("unknown original child lost its original public source", err)
+		}
+	}
+}
