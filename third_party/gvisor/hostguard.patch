+
+// PublishGoferWitnessesV1 publishes only original native public witnesses.
+// It closes the initial setup stream before the Gofer starts topology setup;
+// future lisafs streams are born only after its final filesystem restriction.
+func (owner *NativeSentrySetupV1) PublishGoferWitnessesV1() error {
+	if owner == nil || owner.closed || owner.kind != NativeGoferV1 || owner.phase == nil || owner.setup == nil {
+		return fmt.Errorf("native Gofer publication has no original fixed setup")
+	}
+	if err := owner.phase.RequireRoleV1(NativeGoferV1); err != nil {
+		return err
+	}
+	if err := publishNativeRoleWitnessesV1(owner.phase, owner.setup, NativeGoferV1); err != nil {
+		return err
+	}
+	owner.setup = nil
+	return nil
+}
