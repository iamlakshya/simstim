+func TestFinalTypedStateRejectsPrivateAndReconstructedInputs(t *testing.T) {
+	value := nativeFinalBootWireV1{Version: 1, ID: "aaaa2222", Role: "probe-true", CPUs: 2, MemoryMax: 512 << 20, HostMemory: 4 << 30, Topology: nativeFinalObjectV1{FD: 32, Dev: 1, Ino: 2}, Sources: []nativeFinalObjectV1{{FD: 33, Dev: 1, Ino: 3}}, RootDev: 1, RootIno: 4, ProgramDev: 1, ProgramIno: 5}
+	raw, err := json.Marshal(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := decodeNativeFinalBootV1(raw); err != nil {
+		t.Fatal(err)
+	}
+	original := string(raw)
+	cases := []string{
+		strings.Replace(original, `"v":1`, `"v":2`, 1),
+		strings.Replace(original, `"v":1`, `"v":1,"V":1`, 1),
+		strings.Replace(original, `"v":1`, `"v":1,"v":1`, 1),
+		strings.Replace(original, `"role":"probe-true"`, `"role":"arbitrary-command"`, 1),
+		strings.Replace(original, `"memory_max":536870912`, `"memory_max":0`, 1),
+		strings.Replace(original, `"host_memory":4294967296`, `"host_memory":0`, 1),
+		strings.Replace(original, `"sources":`, `"argv":["/bin/sh"],"sources":`, 1),
+		strings.Replace(original, `"sources":`, `"environment":{"SECRET":"value"},"sources":`, 1),
+		strings.Replace(original, `"sources":`, `"original_op":7,"sources":`, 1),
+		strings.Replace(original, `"sources":`, `"guest_link":8,"sources":`, 1),
+		strings.Replace(original, `"fd":33`, `"fd":32`, 1),
+		strings.Replace(original, `"fd":33`, `"fd":1023`, 1),
+		strings.Replace(original, `"fd":33`, `"fd":33,"extra":true`, 1),
+	}
+	for _, candidate := range cases {
+		if _, err := decodeNativeFinalBootV1([]byte(candidate)); err == nil {
+			t.Fatal("unsupported final setup became a current role", candidate)
+		}
+	}
+}
+func TestZeroFinalExecCannotManufactureHandoff(t *testing.T) {
+	var owner NativeFinalExecV1
+	if err := owner.SealBootHandoffV1(NativeFinalBootInputV1{}); err == nil {
+		t.Fatal("zero owner produced immutable final setup")
+	}
+	if err := owner.ExecV1(); err == nil {
+		t.Fatal("zero owner executed a final stage")
+	}
+}
