+func TestFinalIORejectsChangedTopologyExtent(t *testing.T) {
+	valid := []byte{'I', 'O', 'V', 1, 0, 3}
+	if err := nativeSentryIOHeaderV1(valid, 3); err != nil {
+		t.Fatal(err)
+	}
+	for _, value := range []struct {
+		data   []byte
+		gofers int
+	}{
+		{nil, 3}, {valid[:5], 3}, {append(append([]byte{}, valid...), 0), 3},
+		{[]byte{'I', 'O', 'V', 2, 0, 3}, 3}, {valid, 2}, {valid, 4},
+		{[]byte{'I', 'O', 'V', 1, 0, 0}, 0},
+	} {
+		if err := nativeSentryIOHeaderV1(value.data, value.gofers); err == nil {
+			t.Fatal("changed final IO became an original topology vector", value)
+		}
+	}
+	tooMany := append([]byte{}, valid...)
+	binary.BigEndian.PutUint16(tooMany[4:], 1026)
+	if err := nativeSentryIOHeaderV1(tooMany, 1026); err == nil {
+		t.Fatal("unbounded final IO vector passed")
+	}
+}
+
+func TestFinalIOCannotBeIssuedByZeroOrCopiedOwners(t *testing.T) {
+	var phase NativePrivateV1
+	if _, err := phase.ReceiveFinalSentryIOV1(); err == nil {
+		t.Fatal("zero role entered a blocking private receive")
+	}
+	var io NativeSentryIOV1
+	if _, _, err := io.TakeBootFDsV1(); err == nil {
+		t.Fatal("zero IO owner produced native descriptors")
+	}
+	if err := io.AcceptBootV1(&phase, 3, []int{4}); err == nil {
+		t.Fatal("public FD numbers authorised Loader adoption")
+	}
+	if err := phase.ConfirmFinalBoundaryV1(); err == nil {
+		t.Fatal("zero role created a final inheritance receipt")
+	}
+	if _, err := phase.ReceiveLateGuestFD3V1(); err == nil {
+		t.Fatal("zero role entered a guest descriptor receive")
+	}
+	if _, err := phase.CreateFinalGoferIOV1(); err == nil {
+		t.Fatal("zero role created future Gofer IO")
+	}
+}
