+// SPDX-License-Identifier: Apache-2.0
+package hostguard
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+)
+
+// This is only the sealed public FD layout emitted by the original mapped
+// helper. The outside owner independently binds these SAME objects to its
+// protected signed-runtime closure and original C creation chain before any
+// private operation or guest FD can be released.
+type nativeControllerSetupWireV1 struct {
+	Version   int                 `json:"v"`
+	Setup     json.RawMessage     `json:"setup"`
+	Sentry    nativeFinalObjectV1 `json:"sentry"`
+	FDParking nativeFinalObjectV1 `json:"fdparking"`
+	Prewarmer nativeFinalObjectV1 `json:"prewarmer"`
+}
+
+func NativeControllerSetupEntryV1() bool {
+	return nativeEntryScopeABIV1 != 0 && nativeEntryFinalFSV1 == 0 && len(os.Args) == 2 && os.Args[0] == "native-controller-setup-v1" && os.Args[1] == "native-controller-setup-v1"
+}
+
+func decodeNativeControllerSetupV1(raw []byte) (nativeSentrySetupWireV1, nativeFinalBootWireV1, []nativeFinalObjectV1, error) {
+	var base nativeSentrySetupWireV1
+	var boot nativeFinalBootWireV1
+	if len(raw) < 1 || len(raw) > nativeTopologyLimitV1 {
+		return base, boot, nil, fmt.Errorf("controller public setup exceeds its closed frame")
+	}
+	fields, err := nativeExactObjectV1(raw, "v", "setup", "sentry", "fdparking", "prewarmer")
+	if err != nil {
+		return base, boot, nil, err
+	}
+	for _, name := range []string{"sentry", "fdparking", "prewarmer"} {
+		if _, err := nativeExactObjectV1(fields[name], "fd", "dev", "ino"); err != nil {
+			return base, boot, nil, err
+		}
+	}
+	var wire nativeControllerSetupWireV1
+	if err := json.Unmarshal(raw, &wire); err != nil {
+		return base, boot, nil, err
+	}
+	if wire.Version != 1 {
+		return base, boot, nil, fmt.Errorf("controller public setup has another version")
+	}
+	base, boot, err = decodeNativeSentrySetupV1(wire.Setup)
+	if err != nil {
+		return base, boot, nil, err
+	}
+	code := []nativeFinalObjectV1{wire.Sentry, wire.FDParking, wire.Prewarmer}
+	seen := map[[2]uint64]bool{{base.Program.Dev, base.Program.Ino}: true, {base.ProcUmounter.Dev, base.ProcUmounter.Ino}: true}
+	for index, object := range code {
+		key := [2]uint64{object.Dev, object.Ino}
+		if object.FD != base.Program.FD+1+index || object.FD >= nativeFinalEntryNamespacesFDV1 || object.Ino == 0 || seen[key] {
+			return base, boot, nil, fmt.Errorf("controller code suite changed its distinct original native roles")
+		}
+		seen[key] = true
+	}
+	return base, boot, code, nil
+}
+
+func CaptureNativeControllerSetupV1() (*NativeSentrySetupV1, error) {
+	return captureNativeFilesystemSetupV1(NativeControllerV1)
+}
+
+// ControllerChildrenInputV1 returns SAME checked code objects for its two real
+// creations. Unused signed companions remain held and never become programs.
+func (owner *NativeSentrySetupV1) ControllerChildrenInputV1() (*NativePrivateV1, NativeSentryCreationInputV1, NativeGoferCreationInputV1, error) {
+	var sentry NativeSentryCreationInputV1
+	var gofer NativeGoferCreationInputV1
+	if owner == nil || owner.original != owner || owner.closed || owner.kind != NativeControllerV1 || owner.phase == nil || owner.umounter == nil || len(owner.controllerCode) != 3 {
+		return nil, sentry, gofer, fmt.Errorf("controller children lost their same original public code suite")
+	}
+	if err := owner.phase.RequireRoleV1(NativeControllerV1); err != nil {
+		return nil, sentry, gofer, err
+	}
+	for _, code := range append([]*os.File{owner.phase.executable, owner.umounter}, owner.controllerCode...) {
+		if err := checkNativeSealedCodeV1(code); err != nil {
+			return nil, sentry, gofer, err
+		}
+	}
+	input := NativeFinalBootInputV1{CPUs: owner.wire.CPUs, MemoryMax: owner.wire.MemoryMax, HostMemory: owner.wire.HostMemory, Helper: owner.helper, HelperGuest: owner.wire.HelperGuest}
+	sentry = NativeSentryCreationInputV1{Sentry: owner.controllerCode[0], ProcUmounter: owner.umounter, Boot: input}
+	gofer = NativeGoferCreationInputV1{Gofer: owner.phase.executable, ProcUmounter: owner.umounter, Boot: input}
+	return owner.phase, sentry, gofer, nil
+}
+
+func (owner *NativeSentrySetupV1) PublishControllerWitnessesV1() error {
+	if owner == nil || owner.original != owner || owner.closed || owner.kind != NativeControllerV1 || owner.phase == nil || owner.setup == nil || len(owner.controllerCode) != 3 {
+		return fmt.Errorf("controller witness publication lost its fixed public code suite")
+	}
+	if err := publishNativeRoleWitnessesV1(owner.phase, owner.setup, NativeControllerV1); err != nil {
+		return err
+	}
+	owner.setup = nil
+	return nil
+}
