+
+// TakeProcUmounterV1 returns an owned duplicate of the SAME captured fixed
+// helper code. Its actual original creation pidfd and join are owned by the
+// native proc-umounter producer, never by a path or a saved success value.
+func (owner *NativeSentrySetupV1) TakeProcUmounterV1() (int, error) {
+	if owner == nil || owner.closed || owner.umounter == nil || owner.phase == nil {
+		return -1, fmt.Errorf("initial Sentry has no original tiny helper code")
+	}
+	if err := owner.phase.RequireRoleV1(NativeSentryV1); err != nil {
+		return -1, err
+	}
+	return unix.FcntlInt(owner.umounter.Fd(), unix.F_DUPFD_CLOEXEC, 32)
