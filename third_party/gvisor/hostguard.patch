+		return fmt.Errorf("native final own-task slot is already occupied: %v", err)
+	}
+	ownFD, err := unix.FcntlInt(phase.task.Fd(), unix.F_DUPFD_CLOEXEC, nativeFinalEntryOwnTaskFDV1)
+	if err != nil {
+		return err
+	}
+	if ownFD != nativeFinalEntryOwnTaskFDV1 {
+		_ = unix.Close(ownFD)
+		return fmt.Errorf("native final own-task reservation collided")
+	}
+	own := os.NewFile(uintptr(ownFD), "same-native-own-task-through-exec")
