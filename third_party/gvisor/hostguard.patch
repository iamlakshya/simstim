+	"io"
+	"os"
+	"path"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+const nativeFinalEntryStateFDV1 = 1022
+const nativeFinalEntrySetupFDV1 = 1020
+
+// NativeFinalBootInputV1 is public setup DATA and already-owned native
+// objects. It contains no guest IO, guest link, OP, secret, arbitrary argv,
+// environment or raw OCI. The actual original creator handshake separately
+// proves that Helper is the same captured host helper code, not a caller's
+// chosen program. This builder supplies no execution/namespace permission.
+type NativeFinalBootInputV1 struct {
+	CPUs        int
+	MemoryMax   uint64
+	HostMemory  uint64
+	Helper      *os.File
+	HelperGuest string
+	PublicSetup *os.File
+}
+
+type nativeFinalObjectV1 struct {
+	FD  int    `json:"fd"`
+	Dev uint64 `json:"dev"`
+	Ino uint64 `json:"ino"`
+}
+type nativeFinalBootWireV1 struct {
+	Version      int                   `json:"v"`
+	ID           string                `json:"id"`
+	Role         string                `json:"role"`
+	CPUs         int                   `json:"cpus"`
+	MemoryMax    uint64                `json:"memory_max"`
+	HostMemory   uint64                `json:"host_memory"`
+	Topology     nativeFinalObjectV1   `json:"topology"`
+	Sources      []nativeFinalObjectV1 `json:"sources"`
+	Helper       *nativeFinalObjectV1  `json:"helper,omitempty"`
+	HelperGuest  string                `json:"helper_guest"`
+	HelperDigest string                `json:"helper_digest"`
+	RootDev      uint64                `json:"root_dev"`
+	RootIno      uint64                `json:"root_ino"`
+	ProgramDev   uint64                `json:"program_dev"`
+	ProgramIno   uint64                `json:"program_ino"`
+}
+
+func nativeRetainFinalObjectV1(file *os.File) (*os.File, nativeFinalObjectV1, error) {
+	var object nativeFinalObjectV1
+	if file == nil {
+		return nil, object, fmt.Errorf("final setup lost an original native object")
+	}
+	fd, err := unix.FcntlInt(file.Fd(), unix.F_DUPFD_CLOEXEC, 32)
+	if err != nil {
+		return nil, object, err
+	}
+	held := os.NewFile(uintptr(fd), "same-public-native-final-object")
+	if fd >= nativeFinalEntryNamespacesFDV1 {
+		return nil, object, errors.Join(fmt.Errorf("final public object vector exceeds its closed slot extent"), held.Close())
+	}
+	var before, after unix.Stat_t
+	if err := unix.Fstat(int(file.Fd()), &before); err != nil {
+		return nil, object, errors.Join(err, held.Close())
+	}
+	if err := unix.Fstat(fd, &after); err != nil {
+		return nil, object, errors.Join(err, held.Close())
+	}
+	if before.Dev != after.Dev || before.Ino != after.Ino {
+		return nil, object, errors.Join(fmt.Errorf("final native object changed during retention"), held.Close())
+	}
+	object = nativeFinalObjectV1{FD: fd, Dev: uint64(after.Dev), Ino: after.Ino}
+	return held, object, nil
+}
+
+func nativeHelperGuestObjectV1(topology *NativeTopologyV1, helper *os.File, target string) error {
+	if helper == nil || !path.IsAbs(target) || path.Clean(target) != target || strings.ContainsAny(target, "\x00\r\n") {
+		return fmt.Errorf("final guest-init has no fixed original helper object")
+	}
+	parent := path.Dir(target)
+	for index, mount := range topology.wire.Mounts {
+		if mount.Role != "mount" || mount.Guest != parent || mount.Write {
+			continue
+		}
+		// The actual captured helper directory supplies a single ordinary leaf.
+		// No path walk outside that original object or symlink resolution exists.
+		fd, err := unix.Openat2(int(topology.sources[index].Fd()), path.Base(target), &unix.OpenHow{Flags: unix.O_RDONLY | unix.O_CLOEXEC | unix.O_NOFOLLOW, Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_SYMLINKS | unix.RESOLVE_NO_MAGICLINKS})
+		if err != nil {
+			return err
+		}
+		candidate := os.NewFile(uintptr(fd), "original-fixed-guest-helper")
+		actual, err := candidate.Stat()
+		expected, expectedErr := helper.Stat()
+		closeErr := candidate.Close()
+		if err != nil || expectedErr != nil || closeErr != nil || !os.SameFile(actual, expected) || !actual.Mode().IsRegular() || actual.Mode().Perm()&0111 == 0 || actual.Mode()&(os.ModeSetuid|os.ModeSetgid) != 0 {
+			return errors.Join(err, expectedErr, closeErr, fmt.Errorf("guest-init code differs from its original captured native helper"))
+		}
+		return nil
+	}
+	return fmt.Errorf("guest-init target is outside the original read-only helper mount")
+}
+
+// SealBootHandoffV1 is the actual immutable typed state producer. All sources
+// come from this SAME captured topology; future Gofer RPC/guest links are
+// deliberately absent and are received only after final post-exec ND0.
+func (owner *NativeFinalExecV1) SealBootHandoffV1(input NativeFinalBootInputV1) (failure error) {
+	if owner == nil || owner.phase == nil {
+		return fmt.Errorf("final state lacks its original same-process producer")
+	}
