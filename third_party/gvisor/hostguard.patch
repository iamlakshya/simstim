+
+func TestInitialSentrySetupRejectsPayloadAndForeignCodeLayout(t *testing.T) {
+	boot := nativeFinalBootWireV1{Version: 1, ID: "aaaa2222", Role: "probe-true", CPUs: 2, MemoryMax: 512 << 20, HostMemory: 4 << 30, Topology: nativeFinalObjectV1{FD: 5, Dev: 1, Ino: 2}, Sources: []nativeFinalObjectV1{}, RootDev: 1, RootIno: 4, ProgramDev: 1, ProgramIno: 5}
+	bootRaw, err := json.Marshal(boot)
+	if err != nil {
+		t.Fatal(err)
+	}
+	setup := nativeSentrySetupWireV1{Version: 1, Boot: bootRaw, ProcUmounter: nativeFinalObjectV1{FD: 6, Dev: 1, Ino: 6}, Program: nativeFinalObjectV1{FD: 7, Dev: 1, Ino: 5}}
+	raw, err := json.Marshal(setup)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := decodeNativeSentrySetupV1(raw); err != nil {
+		t.Fatal(err)
+	}
+	original := string(raw)
+	for _, bad := range []string{
+		strings.Replace(original, `"v":1`, `"v":1,"V":1`, 1),
+		strings.Replace(original, `"v":1`, `"v":1,"v":1`, 1),
+		strings.Replace(original, `"boot":`, `"argv":["/bin/sh"],"boot":`, 1),
+		strings.Replace(original, `"boot":`, `"environment":{"SECRET":"value"},"boot":`, 1),
+		strings.Replace(original, `"boot":`, `"guest_link":9,"boot":`, 1),
+		strings.Replace(original, `"boot":`, `"private_op":8,"boot":`, 1),
+		strings.Replace(original, `"fd":5`, `"fd":4`, 1),
+		strings.Replace(original, `"fd":6`, `"fd":5`, 1),
+		strings.Replace(original, `"fd":7`, `"fd":1023`, 1),
+		strings.Replace(original, `"ino":6`, `"ino":5`, 1),
+		strings.Replace(original, `"fd":7,"dev":1,"ino":5`, `"fd":7,"dev":1,"ino":7`, 1),
+	} {
+		if _, _, err := decodeNativeSentrySetupV1([]byte(bad)); err == nil {
+			t.Fatal("foreign payload or code layout became native setup", bad)
+		}
+	}
+}
+
+func TestInitialSentryDataOwnerCannotReconstructNativeSetup(t *testing.T) {
+	var owner NativeSentrySetupV1
+	if _, _, _, err := owner.SetupProjectionV1(); err == nil {
+		t.Fatal("zero setup data owner created an initial native phase")
+	}
+	if _, err := owner.TakeProcUmounterV1(); err == nil {
+		t.Fatal("zero setup data owner issued helper code")
+	}
+}
