+// SPDX-License-Identifier: Apache-2.0
+package cmd
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"golang.org/x/sys/unix"
+	"gvisor.dev/gvisor/runsc/flag"
+	"gvisor.dev/gvisor/runsc/hostguard"
+	"gvisor.dev/gvisor/runsc/nativeconfig"
+	"runtime"
+	"strings"
+)
+
+// RunNativeGoferV1 is the closed initial Gofer dispatch before public CLI.
+// The actual original creator supplies only its sealed native object layout.
+// No inherited future guest stream or private operation enters this method.
+func RunNativeGoferV1() error {
+	owner, err := hostguard.CaptureNativeGoferSetupV1()
+	if err != nil {
+		return err
+	}
+	defer owner.Close()
+	phase, projection, _, err := owner.SetupProjectionV1()
+	if err != nil {
+		return err
+	}
+	conf, err := nativeconfig.ConfigV1()
+	if err != nil {
+		return err
+	}
+	conf.Rootless = false
+	spec, err := nativeconfig.SpecV1(projection)
+	if err != nil {
+		return err
+	}
+	configs := make([]string, len(projection.Mounts)+1)
+	for index := range configs {
+		configs[index] = "lisafs:none"
+	}
+	raw, err := json.Marshal(spec)
+	if err != nil || len(raw) > 4<<20 {
+		return fmt.Errorf("fixed native Gofer spec exceeds its closed frame: %v", err)
+	}
+	fd, err := unix.MemfdCreate("native-fixed-Gofer-spec-v1", unix.MFD_CLOEXEC|unix.MFD_ALLOW_SEALING)
+	if err != nil {
+		return err
+	}
+	if n, err := unix.Write(fd, raw); err != nil || n != len(raw) {
+		_ = unix.Close(fd)
+		return fmt.Errorf("write complete fixed Gofer spec: %v", err)
+	}
+	required := unix.F_SEAL_WRITE | unix.F_SEAL_GROW | unix.F_SEAL_SHRINK | unix.F_SEAL_SEAL
+	if _, err := unix.FcntlInt(uintptr(fd), unix.F_ADD_SEALS, required); err != nil {
+		_ = unix.Close(fd)
+		return err
+	}
+	if _, err := unix.Seek(fd, 0, 0); err != nil {
+		_ = unix.Close(fd)
+		return err
+	}
+	local := flag.NewFlagSet("native-gofer-setup-v1", flag.ContinueOnError)
+	var g Gofer
+	g.SetFlags(local)
+	if err := local.Parse([]string{projection.ID}); err != nil {
+		_ = unix.Close(fd)
+		return err
+	}
+	if err := g.mountConfs.Set(strings.Join(configs, ",")); err != nil {
+		_ = unix.Close(fd)
+		return err
+	}
+	g.specFD, g.bundleDir, g.mountsFD = fd, "/", -1
+	g.NativePrivateV1 = phase
+	g.setUpRoot, g.applyCaps = true, true
+	if err := owner.PublishGoferWitnessesV1(); err != nil {
+		_ = unix.Close(fd)
+		return err
+	}
+	result := g.Execute(context.Background(), local, conf)
+	runtime.KeepAlive(owner)
+	if result != 0 {
+		return fmt.Errorf("fixed native Gofer service ended: %v", result)
+	}
+	return nil
+}
