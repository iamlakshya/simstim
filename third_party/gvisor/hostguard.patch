+// SPDX-License-Identifier: Apache-2.0
+package hostguard
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"strconv"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+type nativeTaskBirthV1 struct {
+	pid, parent int
+	birth       uint64
+}
+
+func parseNativeTaskBirthV1(raw []byte) (nativeTaskBirthV1, error) {
+	var value nativeTaskBirthV1
+	if len(raw) == 0 || len(raw) > 64<<10 || raw[len(raw)-1] != '\n' {
+		return value, fmt.Errorf("native task stat has another complete record extent")
+	}
+	text := string(raw)
+	if strings.ContainsAny(text[:len(text)-1], "\x00\r\n") {
+		return value, fmt.Errorf("native task stat has trailing or unsupported records")
+	}
+	left, right := strings.Index(text, " ("), strings.LastIndex(text, ") ")
+	if left < 1 || right <= left+1 {
+		return value, fmt.Errorf("native task stat has another kernel record shape")
+	}
+	pid, err := strconv.ParseUint(text[:left], 10, 31)
+	if err != nil || pid == 0 || strconv.FormatUint(pid, 10) != text[:left] {
+		return value, fmt.Errorf("native task stat has no exact kernel PID")
+	}
+	fields := strings.Fields(text[right+2:])
+	if len(fields) < 20 || len(fields[0]) != 1 {
+		return value, fmt.Errorf("native task stat has no complete kernel birth")
+	}
+	parent, err := strconv.ParseUint(fields[1], 10, 31)
+	if err != nil || strconv.FormatUint(parent, 10) != fields[1] {
+		return value, fmt.Errorf("native task stat has another kernel parent")
+	}
+	birth, err := strconv.ParseUint(fields[19], 10, 64)
+	if err != nil || birth == 0 || strconv.FormatUint(birth, 10) != fields[19] {
+		return value, fmt.Errorf("native task stat has no exact kernel birth ticks")
+	}
+	return nativeTaskBirthV1{pid: int(pid), parent: int(parent), birth: birth}, nil
+}
+
+func readNativeTaskBirthV1(task *os.File) (nativeTaskBirthV1, error) {
+	var value nativeTaskBirthV1
+	if task == nil {
+		return value, fmt.Errorf("native role lost its original task source")
+	}
+	var st unix.Stat_t
+	var fs unix.Statfs_t
+	if err := errors.Join(unix.Fstat(int(task.Fd()), &st), unix.Fstatfs(int(task.Fd()), &fs)); err != nil {
+		return value, err
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFDIR || fs.Type != unix.PROC_SUPER_MAGIC {
+		return value, fmt.Errorf("native task source is not the original proc directory")
+	}
+	fd, err := unix.Openat(int(task.Fd()), "stat", unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return value, err
+	}
+	file := os.NewFile(uintptr(fd), "original-native-kernel-task-stat")
+	raw, readErr := io.ReadAll(io.LimitReader(file, (64<<10)+1))
+	closeErr := file.Close()
+	if err := errors.Join(readErr, closeErr); err != nil {
+		return value, err
+	}
+	return parseNativeTaskBirthV1(raw)
+}
+
+func nativeSameObjectV1(a, b *os.File) error {
+	if a == nil || b == nil {
+		return fmt.Errorf("native original object is missing")
+	}
+	left, leftErr := a.Stat()
+	right, rightErr := b.Stat()
+	if leftErr != nil || rightErr != nil || !os.SameFile(left, right) {
+		return fmt.Errorf("native object differs from its same original source: %v", errors.Join(leftErr, rightErr))
+	}
+	return nil
+}
+
+func nativeCurrentActorCodeV1(task, expected *os.File) error {
+	if task == nil || expected == nil {
+		return fmt.Errorf("native current code has no original task/code source")
+	}
+	// Follow only the kernel's fixed proc exe link. O_PATH checks current mm
+	// identity without asking for a new readable alias of execute-only code.
+	fd, err := unix.Openat(int(task.Fd()), "exe", unix.O_PATH|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return fmt.Errorf("capture current original native executable: %w", err)
+	}
+	actual := os.NewFile(uintptr(fd), "actual-current-original-native-executable")
+	return errors.Join(nativeSameObjectV1(actual, expected), actual.Close())
+}
+
+func nativeCurrentActorNamespaceV1(task, received *os.File, name string) error {
+	if task == nil || received == nil {
+		return fmt.Errorf("native current namespace has no original task/source")
+	}
+	fd, err := unix.Openat(int(task.Fd()), "ns/"+name, unix.O_RDONLY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return fmt.Errorf("capture current original native namespace: %w", err)
+	}
+	actual := os.NewFile(uintptr(fd), "actual-current-original-native-namespace")
+	return errors.Join(nativeSameObjectV1(actual, received), actual.Close())
+}
+
+func nativeNamespaceRelatedV1(file, parentUser, parentSameKind *os.File, kind int) error {
+	if file == nil || parentUser == nil || parentSameKind == nil {
+		return fmt.Errorf("native role lost its original namespace objects")
+	}
+	var fs unix.Statfs_t
