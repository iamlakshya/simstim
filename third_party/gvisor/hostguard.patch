+// SPDX-License-Identifier: Apache-2.0
+package hostguard
+
+import "testing"
+
+func TestClosedNativeTopologyRejectsPrivateAndAmbiguousInput(t *testing.T) {
+	valid := `{"v":1,"id":"aaaa2222","role":"guest-init","mounts":[{"source":0,"guest":"/work","write":true,"identity":"1:2"}]}`
+	if _, err := decodeNativeTopologyV1([]byte(valid), 1); err != nil {
+		t.Fatal(err)
+	}
+	cases := []string{
+		`{"v":1,"V":1,"id":"aaaa2222","role":"guest-init","mounts":[]}`,
+		`{"v":1,"v":1,"id":"aaaa2222","role":"guest-init","mounts":[]}`,
+		`{"v":2,"id":"aaaa2222","role":"guest-init","mounts":[]}`,
+		`{"v":1,"id":"aaaa2222","role":"arbitrary-exec","mounts":[]}`,
+		`{"v":1,"id":"aaaa2222","role":"guest-init","mounts":[],"argv":["/bin/sh"]}`,
+		`{"v":1,"id":"aaaa2222","role":"guest-init","mounts":[{"source":0,"guest":"/work","write":true,"identity":"1:2","host":"/private"}]}`,
+		`{"v":1,"id":"aaaa2222","role":"guest-init","mounts":[{"source":0,"guest":"/work","write":null,"identity":"1:2"}]}`,
+		`{"v":1,"id":"aaaa2222","role":"guest-init","mounts":[{"source":0,"guest":"/work","write":false,"write":true,"identity":"1:2"}]}`,
+		`{"v":1,"id":"aaaa2222","role":"guest-init","mounts":[{"source":1,"guest":"/work","write":true,"identity":"1:2"}]}`,
+		`{"v":1,"id":"aaaa2222","role":"guest-init","mounts":[{"source":0,"guest":"/proc/self/fd","write":false,"identity":"1:2"}]}`,
+		`{"v":1,"id":"aaaa2222","role":"guest-init","mounts":[{"source":0,"guest":"/home/agent/secret","write":true,"identity":"1:2"}]}`,
+	}
+	for _, data := range cases {
+		if _, err := decodeNativeTopologyV1([]byte(data), 1); err == nil {
+			t.Fatal("unsupported native setup accepted", data)
+		}
+	}
+}
+
+func TestNoDataOrZeroValueIssuesFinalPrivateReceipt(t *testing.T) {
+	if (&NativeFilesystemV1{}).finalReceiptV1() == nil {
+		t.Fatal("zero FS issued private receipt")
+	}
+	var phase NativePrivateV1
+	if _, err := phase.ReceiveLateGuestFD3V1(); err == nil {
+		t.Fatal("zero role imported late FD3")
+	}
+	if _, err := phase.TakeOriginalWitnessesV1(); err == nil {
+		t.Fatal("zero role issued native witnesses")
+	}
+	if err := phase.RequireRoleV1(NativeSentryV1); err == nil {
+		t.Fatal("copied role kind became original native source")
+	}
+	if err := (&NativeFilesystemV1{}).Close(); err != nil {
+		t.Fatal(err)
+	}
+}
