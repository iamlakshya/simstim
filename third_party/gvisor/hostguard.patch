+	}
+	// This inherited endpoint remains SETUP-ONLY. It transfers fresh native
+	// witnesses after final exec and must never receive a later private vector.
+	setup, _, err := nativeRetainFinalObjectV1(input.PublicSetup)
+	if err != nil {
+		return err
+	}
+	handoff.objects = append(handoff.objects, setup)
+	handoff.publicSetup = setup
+	raw, err := json.Marshal(wire)
+	if err != nil || len(raw) > nativeTopologyLimitV1 {
+		return fmt.Errorf("final typed state exceeds its existing frame bound: %v", err)
+	}
+	fd, err := unix.MemfdCreate("native-final-setup-v1", unix.MFD_CLOEXEC|unix.MFD_ALLOW_SEALING)
+	if err != nil {
+		return err
+	}
+	handoff.sealedState = os.NewFile(uintptr(fd), "same-process-immutable-final-setup")
+	if n, err := handoff.sealedState.Write(raw); err != nil || n != len(raw) {
+		return fmt.Errorf("write complete final typed setup: %v", err)
+	}
+	required := unix.F_SEAL_WRITE | unix.F_SEAL_GROW | unix.F_SEAL_SHRINK | unix.F_SEAL_SEAL
+	if _, err := unix.FcntlInt(handoff.sealedState.Fd(), unix.F_ADD_SEALS, required); err != nil {
+		return err
+	}
+	if _, err := decodeNativeFinalBootV1(raw); err != nil {
+		return err
+	}
+	owner.handoff = handoff
+	complete = true
+	return nil
+}
+
+func decodeNativeFinalBootV1(raw []byte) (nativeFinalBootWireV1, error) {
+	var value nativeFinalBootWireV1
+	if len(raw) < 1 || len(raw) > nativeTopologyLimitV1 {
+		return value, fmt.Errorf("final state exceeds its closed bound")
+	}
+	var marker struct {
+		Role string `json:"role"`
+	}
+	if json.Unmarshal(raw, &marker) != nil {
+		return value, fmt.Errorf("final state has no closed role")
+	}
+	names := []string{"v", "id", "role", "cpus", "memory_max", "host_memory", "topology", "sources", "helper_guest", "helper_digest", "root_dev", "root_ino", "program_dev", "program_ino"}
+	if marker.Role == "guest-init" {
+		names = append(names, "helper")
+	}
+	fields, err := nativeExactObjectV1(raw, names...)
+	if err != nil {
+		return value, err
+	}
+	if _, err := nativeExactObjectV1(fields["topology"], "fd", "dev", "ino"); err != nil {
+		return value, err
+	}
+	var sourceShapes []json.RawMessage
+	if json.Unmarshal(fields["sources"], &sourceShapes) != nil {
+		return value, fmt.Errorf("final state has another source shape")
+	}
+	for _, source := range sourceShapes {
+		if _, err := nativeExactObjectV1(source, "fd", "dev", "ino"); err != nil {
+			return value, err
+		}
+	}
+	if marker.Role == "guest-init" {
+		if _, err := nativeExactObjectV1(fields["helper"], "fd", "dev", "ino"); err != nil {
+			return value, err
+		}
+	}
+
+	if err := json.Unmarshal(raw, &value); err != nil {
+		return value, err
+	}
+	if value.Version != 1 || len(value.ID) < 1 || len(value.ID) > 32 || strings.Trim(value.ID, "abcdefghijklmnopqrstuvwxyz234567") != "" || value.CPUs < 1 || value.CPUs > 256 || value.MemoryMax == 0 || value.MemoryMax > 1<<60 || value.HostMemory == 0 || value.HostMemory > 1<<60 || value.RootIno == 0 || value.ProgramIno == 0 {
+		return value, fmt.Errorf("final typed state changed its closed purpose")
+	}
+	checkObject := func(object nativeFinalObjectV1) bool {
+		return object.FD >= 3 && object.FD < nativeFinalEntryNamespacesFDV1 && object.Ino != 0
+	}
+	if !checkObject(value.Topology) || len(value.Sources) > 1024 {
+		return value, fmt.Errorf("final state has another native source layout")
+	}
+	seen := map[int]bool{value.Topology.FD: true}
+	for _, object := range value.Sources {
+		if !checkObject(object) || seen[object.FD] {
+			return value, fmt.Errorf("final state repeats or changes a native source slot")
+		}
+		seen[object.FD] = true
+	}
+	if value.Role == "guest-init" {
+		if value.Helper == nil || !checkObject(*value.Helper) || seen[value.Helper.FD] || !path.IsAbs(value.HelperGuest) || path.Clean(value.HelperGuest) != value.HelperGuest || len(value.HelperDigest) != 64 || strings.Trim(value.HelperDigest, "0123456789abcdef") != "" {
+			return value, fmt.Errorf("final guest-init lost its original code object")
+		}
+	} else if value.Role != "probe-true" || value.Helper != nil || value.HelperGuest != "" || value.HelperDigest != "" {
+		return value, fmt.Errorf("final state contains an arbitrary guest program")
+	}
+	return value, nil
+}
+
+// NativeFinalBootV1 is a retained actual final-entry DATA owner. The original
+// native creator still authenticates the same process, code and fresh endpoint
+// before any private IO is supplied. No saved state or public FD snapshot can
+// independently authorise that external release.
+type NativeFinalBootV1 struct {
+	phase     *NativePrivateV1
+	wire      nativeFinalBootWireV1
+	topology  *NativeTopologyV1
+	setup     *os.File
+	helper    *os.File
+	published bool
+	closed    bool
+}
+
+func nativeCaptureFinalObjectV1(object nativeFinalObjectV1) (*os.File, error) {
+	if object.FD < 3 || object.FD >= nativeFinalEntryNamespacesFDV1 {
+		return nil, fmt.Errorf("final inherited object has another slot")
+	}
+	var before, after unix.Stat_t
+	if err := unix.Fstat(object.FD, &before); err != nil {
+		return nil, err
+	}
+	fd, err := unix.FcntlInt(uintptr(object.FD), unix.F_DUPFD_CLOEXEC, 32)
+	if err != nil {
+		return nil, err
+	}
+	held := os.NewFile(uintptr(fd), "same-original-final-entry-object")
+	if err := unix.Fstat(fd, &after); err != nil {
+		return nil, errors.Join(err, held.Close())
+	}
+	if before.Dev != after.Dev || before.Ino != after.Ino || uint64(after.Dev) != object.Dev || after.Ino != object.Ino {
+		return nil, errors.Join(fmt.Errorf("final entry object differs from its original held native source"), held.Close())
+	}
+	return held, nil
+}
+
+// CaptureFinalBootV1 is the actual post-exec reader, before any final role
+// control can consume private input. It requires successful raw pre-Go FS and
+// scope enforcement, exact fixed argv and the same sealed typed state.
+func CaptureFinalBootV1() (_ *NativeFinalBootV1, failure error) {
+	if nativeEntryFinalFSV1 != 1 || len(os.Args) != 2 || os.Args[0] != "native-sentry-final-v1" || os.Args[1] != "native-final-sentry-v1" {
+		return nil, fmt.Errorf("this process is not the original closed final Sentry entry")
+	}
+	if err := Disable(); err != nil {
+		return nil, err
+	}
+	if os.Getpid() != 1 || os.Getppid() != 0 {
+		return nil, fmt.Errorf("final Sentry is not its original fresh namespace init")
+	}
+	stateFD, err := unix.FcntlInt(nativeFinalEntryStateFDV1, unix.F_DUPFD_CLOEXEC, 32)
+	if err != nil {
+		return nil, err
+	}
+	state := os.NewFile(uintptr(stateFD), "original-sealed-final-state")
+	defer state.Close()
+	required := unix.F_SEAL_WRITE | unix.F_SEAL_GROW | unix.F_SEAL_SHRINK | unix.F_SEAL_SEAL
+	seals, err := unix.FcntlInt(state.Fd(), unix.F_GET_SEALS, 0)
+	if err != nil || seals&required != required {
+		return nil, fmt.Errorf("final setup state lost its original kernel seals: %v", err)
+	}
+	raw, err := io.ReadAll(io.NewSectionReader(state, 0, nativeTopologyLimitV1+1))
+	if err != nil {
+		return nil, err
+	}
+	wire, err := decodeNativeFinalBootV1(raw)
+	if err != nil {
+		return nil, err
+	}
+	result := &NativeFinalBootV1{wire: wire}
+	complete := false
+	defer func() {
+		if !complete {
+			failure = errors.Join(failure, result.Close())
+		}
+	}()
+	var root unix.Stat_t
+	if err := unix.Stat("/", &root); err != nil {
+		return nil, err
+	}
+	if uint64(root.Dev) != wire.RootDev || root.Ino != wire.RootIno {
+		return nil, fmt.Errorf("final Sentry reached another native root")
+	}
+	descriptor, err := nativeCaptureFinalObjectV1(wire.Topology)
+	if err != nil {
+		return nil, err
+	}
+	defer descriptor.Close()
+	var sources []*os.File
+	defer func() {
+		for _, source := range sources {
+			_ = source.Close()
+		}
+	}()
+	for _, object := range wire.Sources {
+		file, err := nativeCaptureFinalObjectV1(object)
+		if err != nil {
+			return nil, err
+		}
+		sources = append(sources, file)
+	}
+	result.topology, err = CaptureNativeTopologyV1(descriptor, sources)
+	if err != nil {
+		return nil, err
+	}
+	if result.topology.wire.ID != wire.ID || result.topology.wire.Role != wire.Role {
+		return nil, fmt.Errorf("final native setup changed its original topology purpose")
+	}
+	result.phase, err = PrepareNativePrivateV1(NativeSentryV1, result.topology)
+	if err != nil {
+		return nil, err
+	}
+	var executable unix.Stat_t
+	if err := unix.Fstat(int(result.phase.executable.Fd()), &executable); err != nil {
+		return nil, err
+	}
+	if uint64(executable.Dev) != wire.ProgramDev || executable.Ino != wire.ProgramIno {
+		return nil, fmt.Errorf("final raw entry is not its original exact bound code")
+	}
+	if wire.Helper != nil {
+		result.helper, err = nativeCaptureFinalObjectV1(*wire.Helper)
+		if err != nil {
+			return nil, err
+		}
+		if err := nativeHelperGuestObjectV1(result.topology, result.helper, wire.HelperGuest); err != nil {
+			return nil, err
+		}
+		info, err := result.helper.Stat()
+		if err != nil {
+			return nil, err
+		}
+		if info.Size() < 1 || info.Size() > 512<<20 {
+			return nil, fmt.Errorf("final helper code has another bounded shape")
+		}
+		digest := sha256.New()
+		n, err := io.Copy(digest, io.NewSectionReader(result.helper, 0, info.Size()))
+		if err != nil || n != info.Size() || hex.EncodeToString(digest.Sum(nil)) != wire.HelperDigest {
+			return nil, fmt.Errorf("final helper differs from its original measured code: %v", err)
+		}
+	}
+	setupFD, err := unix.FcntlInt(nativeFinalEntrySetupFDV1, unix.F_DUPFD_CLOEXEC, 32)
+	if err != nil {
+		return nil, err
+	}
+	result.setup = os.NewFile(uintptr(setupFD), "original-public-setup-only-handoff")
+	// Every inherited source alias is closed explicitly after retention.
+	// New Go poll/control descriptors are never overwritten or close-ranged.
+	originalSlots := []int{nativeFinalEntryStateFDV1, nativeFinalEntrySetupFDV1, nativeFinalEntryOwnTaskFDV1, wire.Topology.FD}
+	for _, object := range wire.Sources {
+		originalSlots = append(originalSlots, object.FD)
+	}
+	if wire.Helper != nil {
+		originalSlots = append(originalSlots, wire.Helper.FD)
+	}
+	for index := 0; index < 6; index++ {
+		originalSlots = append(originalSlots, nativeFinalEntryNamespacesFDV1+index)
+	}
+	seen := map[int]bool{}
+	for _, fd := range originalSlots {
+		if !seen[fd] {
+			seen[fd] = true
+			if err := unix.Close(fd); err != nil {
+				return nil, err
+			}
+		}
+	}
+	complete = true
+	return result, nil
+}
+
+func (owner *NativeFinalBootV1) Close() error {
+	if owner == nil || owner.closed {
+		return nil
+	}
+	owner.closed = true
+	var result error
+	if owner.phase != nil {
+		result = errors.Join(result, owner.phase.Close())
+	}
+	if owner.setup != nil {
+		result = errors.Join(result, owner.setup.Close())
+	}
+	if owner.helper != nil {
+		result = errors.Join(result, owner.helper.Close())
+	}
+	if owner.topology != nil {
+		result = errors.Join(result, owner.topology.Close())
+	}
+	return result
+}
+
+// ReleaseSetupObjectsV1 runs after the fixed in-memory guest projection and
+// original native witnesses have been checked, before guest/platform work.
+// Sentry's final policy is already inherited; it needs no directory source
+// capabilities for direct host filesystem access (directfs is fixed false).
+func (owner *NativeFinalBootV1) ReleaseSetupObjectsV1() error {
+	if owner == nil || owner.closed || owner.phase == nil || !owner.published || owner.setup != nil || nativeEntryFinalFSV1 != 1 {
+		return fmt.Errorf("final setup objects have no original confined owner")
+	}
+	var result error
+	if owner.helper != nil {
+		result = errors.Join(result, owner.helper.Close())
+		owner.helper = nil
+	}
+	if owner.topology != nil {
+		result = errors.Join(result, owner.topology.Close())
+	}
+	return result
+}
+
+// NativeGuestMountV1 is the pure guest projection of an original native
+// topology object. It has no host source path or new filesystem grant.
+type NativeGuestMountV1 struct {
+	Guest string
+	Write bool
+	Role  string
+}
+type NativeGuestProjectionV1 struct {
+	ID, Role, HelperGuest string
+	CPUs                  int
+	MemoryMax, HostMemory uint64
+	Mounts                []NativeGuestMountV1
+}
+
+func (owner *NativeFinalBootV1) GuestProjectionV1() (NativeGuestProjectionV1, error) {
+	var value NativeGuestProjectionV1
+	if owner == nil || owner.closed || owner.phase == nil || owner.topology == nil || nativeEntryFinalFSV1 != 1 {
+		return value, fmt.Errorf("guest projection has no original confined final entry")
+	}
+	if err := owner.phase.RequireRoleV1(NativeSentryV1); err != nil {
+		return value, err
+	}
+	value = NativeGuestProjectionV1{ID: owner.wire.ID, Role: owner.wire.Role, HelperGuest: owner.wire.HelperGuest, CPUs: owner.wire.CPUs, MemoryMax: owner.wire.MemoryMax, HostMemory: owner.wire.HostMemory, Mounts: []NativeGuestMountV1{}}
+	for _, mount := range owner.topology.wire.Mounts {
+		value.Mounts = append(value.Mounts, NativeGuestMountV1{Guest: mount.Guest, Write: mount.Write, Role: mount.Role})
+	}
+	return value, nil
+}
+
+// PrivatePhaseV1 returns only the original same-entry irreversible boundary.
+// Its actual native parent still must authenticate every creation/code/task/
+// namespace/socket witness and all other role results before private release.
+func (owner *NativeFinalBootV1) PrivatePhaseV1() (*NativePrivateV1, error) {
+	if owner == nil || owner.closed || owner.phase == nil || nativeEntryFinalFSV1 != 1 {
+		return nil, fmt.Errorf("final Sentry has no original private phase")
+	}
+	if err := owner.phase.RequireRoleV1(NativeSentryV1); err != nil {
+		return nil, err
+	}
+	return owner.phase, nil
+}
