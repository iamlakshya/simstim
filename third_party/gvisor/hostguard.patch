+// SPDX-License-Identifier: Apache-2.0
+package sentrycmd
+
+import (
+	"errors"
+	"fmt"
+
+	"golang.org/x/sys/unix"
+	"gvisor.dev/gvisor/pkg/cpuid"
+	"gvisor.dev/gvisor/pkg/hostarch"
+	"gvisor.dev/gvisor/pkg/metric"
+	"gvisor.dev/gvisor/pkg/ring0"
+	"gvisor.dev/gvisor/runsc/boot"
+	"gvisor.dev/gvisor/runsc/config"
+	"gvisor.dev/gvisor/runsc/hostguard"
+	"gvisor.dev/gvisor/runsc/nativeconfig"
+	"gvisor.dev/gvisor/runsc/specutils"
+	"gvisor.dev/gvisor/runsc/starttime"
+)
+
+func nativeFixedConfigV1() (*config.Config, error) { return nativeconfig.ConfigV1() }
+func nativeFixedMountConfsV1(count int) ([]specutils.GoferMountConf, error) {
+	return nativeconfig.MountConfsV1(count)
+}
+
+func nativeNullStdioV1() (result []int, failure error) {
+	complete := false
+	defer func() {
+		if !complete {
+			for _, fd := range result {
+				failure = errors.Join(failure, unix.Close(fd))
+			}
+		}
+	}()
+	for fd := 0; fd < 3; fd++ {
+		var st unix.Stat_t
+		if err := unix.Fstat(fd, &st); err != nil || st.Mode&unix.S_IFMT != unix.S_IFCHR || unix.Major(uint64(st.Rdev)) != 1 || unix.Minor(uint64(st.Rdev)) != 3 {
+			return nil, fmt.Errorf("final native standard IO differs from original null IO: %v", err)
+		}
+		copy, err := unix.FcntlInt(uintptr(fd), unix.F_DUPFD_CLOEXEC, 256)
+		if err != nil {
+			return nil, err
+		}
+		result = append(result, copy)
+	}
+	complete = true
+	return result, nil
+}
+
+// RunNativeFinalSentryV1 is the fixed final dispatch, before CLI flag or OCI
+// parsing. The raw ELF entry has already enforced the SAME filesystem policy
+// before every Go thread and systrap source. Every input below is either the
+// sealed original public setup or fresh IO released after aggregate proofs.
+func RunNativeFinalSentryV1() (_ unix.WaitStatus, failure error) {
+	owner, err := hostguard.CaptureFinalBootV1()
+	if err != nil {
+		return 0, err
+	}
+	defer func() { failure = errors.Join(failure, owner.Close()) }()
+	projection, err := owner.GuestProjectionV1()
+	if err != nil {
+		return 0, err
+	}
+	spec, err := nativeFixedSpecV1(projection)
+	if err != nil {
+		return 0, err
+	}
+	conf, err := nativeFixedConfigV1()
+	if err != nil {
+		return 0, err
+	}
+	mountConfs, err := nativeFixedMountConfsV1(len(projection.Mounts) + 1)
+	if err != nil {
+		return 0, err
+	}
+	phase, err := owner.PrivatePhaseV1()
+	if err != nil {
+		return 0, err
+	}
+	if err := owner.PublishOriginalWitnessesV1(); err != nil {
+		return 0, err
+	}
+	if err := owner.ReleaseSetupObjectsV1(); err != nil {
+		return 0, err
+	}
+	if err := phase.FinishCurrentRootV1(); err != nil {
+		return 0, err
+	}
+	// This receive cannot progress unless the original aggregate creator
+	// releases fresh Gofer streams and its fixed control listener. No guest
+	// endpoint, private OP or payload can pass the inherited setup channel.
+	io, err := phase.ReceiveFinalSentryIOV1()
+	if err != nil {
+		return 0, err
+	}
+	defer func() { failure = errors.Join(failure, io.Close()) }()
+	controller, gofers, err := io.TakeBootFDsV1()
+	if err != nil {
+		return 0, err
+	}
+	if unix.Getpagesize() != hostarch.PageSize {
+		return 0, fmt.Errorf("final native page size differs from compiled Sentry")
+	}
+	stdio, err := nativeNullStdioV1()
+	if err != nil {
+		return 0, err
+	}
+	// boot.New takes stdio ownership. A failure exits this fixed final process;
+	// its original creation owner still must physically join that exact PID.
+	cpuid.Initialize()
+	ring0.InitDefault()
+	timer := starttime.Timer("native final Sentry")
+	l, err := boot.New(boot.Args{
+		NativePrivateV1: phase, NativeIOV1: io,
+		ID: projection.ID, Spec: spec, Conf: conf,
+		ControllerFD: controller, GoferFDs: gofers, GoferMountConfs: mountConfs,
+		StdioFDs: stdio, NumCPU: projection.CPUs,
+		TotalMem: projection.MemoryMax, TotalHostMem: projection.HostMemory,
+		PinRingFD: -1, CPUDMALatencyFD: -1, DevGoferFD: -1, ExecFD: -1,
+		UserLogFD: -1, PodInitConfigFD: -1, RootfsUpperTarFD: -1,
+		StartupTimer: timer,
+	})
+	if err != nil {
+		return 0, fmt.Errorf("create fixed final native Loader: %w", err)
+	}
+	defer l.Destroy()
+	metric.Initialize()
+	l.StartControlServer()
+	l.WaitForStartSignal()
+	// The Loader verifies the SAME raw final receipt and accepts guest FD3
+	// only now, immediately before seccomp and fixed guest application work.
+	if err := l.Run(); err != nil {
+		return 0, err
+	}
+	return unix.WaitStatus(l.WaitExit()), nil
+}
