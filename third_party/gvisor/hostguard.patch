+// SPDX-License-Identifier: Apache-2.0
+package hostguard
+
+import (
+	"crypto/rand"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"golang.org/x/sys/unix"
+	"os"
+)
+
+// NativeRoleAggregateV1 is issued only by the same actual controller after
+// both exact original children have separately completed their native final
+// receipts. It contains no caller-supplied success, pidfd, code digest or OP.
+// The outside original C/runtime owner must authenticate the controller and
+// its SAME protected code suite before releasing any private input to it.
+type NativeRoleAggregateV1 struct {
+	original                      *NativeRoleAggregateV1
+	controller                    *NativePrivateV1
+	sentry, gofer                 *NativeRoleCreationV1
+	guest                         *os.File
+	published, received, released bool
+}
+
+func (phase *NativePrivateV1) JoinNativeRoleAggregateV1(sentry, gofer *NativeRoleCreationV1) (*NativeRoleAggregateV1, error) {
+	if phase == nil || sentry == nil || gofer == nil || sentry == gofer {
+		return nil, fmt.Errorf("native aggregate has no distinct original controller children")
+	}
+	phase.mu.Lock()
+	defer phase.mu.Unlock()
+	if err := phase.checkLocked(); err != nil {
+		return nil, err
+	}
+	if phase.role != NativeControllerV1 || !phase.published || !phase.final || phase.consumed || phase.aggregate != nil || phase.policy == nil || len(phase.children) != 2 || sentry.controller != phase || gofer.controller != phase || !(phase.children[0] == sentry && phase.children[1] == gofer || phase.children[1] == sentry && phase.children[0] == gofer) {
+		return nil, fmt.Errorf("native aggregate changed the complete original controller child set")
+	}
+	if err := phase.policy.finalReceiptV1(); err != nil {
+		return nil, err
+	}
+	sentry.mu.Lock()
+	defer sentry.mu.Unlock()
+	gofer.mu.Lock()
+	defer gofer.mu.Unlock()
+	if err := sentry.checkOriginalFinalLockedV1(NativeSentryV1); err != nil {
+		return nil, err
+	}
+	if err := gofer.checkOriginalFinalLockedV1(NativeGoferV1); err != nil {
+		return nil, err
+	}
+	if gofer.parked == nil || gofer.parked.original != gofer || len(gofer.parked.files) != len(phase.topology.wire.Mounts)+1 {
+		return nil, fmt.Errorf("native aggregate lacks the SAME final Gofer streams")
+	}
+	result := &NativeRoleAggregateV1{controller: phase, sentry: sentry, gofer: gofer}
+	result.original = result
+	phase.aggregate = result
+	return result, nil
+}
+
+// Caller holds the original controller mutex. New role creation refuses once
+// its filesystem is final, so this exact two-child set cannot later expand.
+func (aggregate *NativeRoleAggregateV1) checkLockedV1() error {
+	if aggregate == nil || aggregate.original != aggregate || aggregate.controller == nil || aggregate.controller.aggregate != aggregate {
+		return fmt.Errorf("native aggregate was copied or reconstructed")
+	}
+	phase := aggregate.controller
+	if err := phase.checkLocked(); err != nil {
+		return err
+	}
+	if phase.role != NativeControllerV1 || !phase.final || !phase.published || phase.consumed || phase.policy == nil || len(phase.children) != 2 {
+		return fmt.Errorf("native aggregate lost its original final controller")
+	}
+	if err := phase.policy.finalReceiptV1(); err != nil {
+		return err
+	}
+	for _, entry := range []struct {
+		owner *NativeRoleCreationV1
+		kind  NativeRoleKindV1
+	}{{aggregate.sentry, NativeSentryV1}, {aggregate.gofer, NativeGoferV1}} {
+		if entry.owner == nil || entry.owner.controller != phase {
+			return fmt.Errorf("native aggregate changed its original role owner")
+		}
+		entry.owner.mu.Lock()
+		err := entry.owner.checkOriginalFinalLockedV1(entry.kind)
+		entry.owner.mu.Unlock()
+		if err != nil {
+			return err
+		}
+	}
+	if aggregate.gofer.parked == nil || aggregate.gofer.parked.original != aggregate.gofer || len(aggregate.gofer.parked.files) != len(phase.topology.wire.Mounts)+1 {
+		return fmt.Errorf("native aggregate lost original parked Gofer IO")
+	}
+	return nil
+}
+
+// PublishAggregateV1 emits only after every actual local barrier. This frame
+// is not authority by itself: the outside owner must first match its original
+// controller creation/code/current SCM/native namespace/socket chain.
+func (aggregate *NativeRoleAggregateV1) PublishAggregateV1() error {
+	if aggregate == nil || aggregate.controller == nil {
+		return fmt.Errorf("native aggregate has no original controller")
+	}
+	phase := aggregate.controller
+	phase.mu.Lock()
+	defer phase.mu.Unlock()
+	if err := aggregate.checkLockedV1(); err != nil {
+		return err
+	}
+	if aggregate.published || aggregate.received || aggregate.released {
+		return fmt.Errorf("native aggregate publication was reused")
+	}
+	data := []byte{'A', 'G', 'V', 1}
+	if n, err := unix.SendmsgN(int(phase.local.Fd()), data, nil, nil, unix.MSG_NOSIGNAL); err != nil || n != len(data) {
+		return fmt.Errorf("publish complete native aggregate: %v", err)
+	}
+	aggregate.published = true
+	return nil
+}
+
+// ReceiveOriginalGuestV1 accepts only the single late connected Unix stream
+// through the controller's fresh post-ND0 endpoint. No original inherited
+// setup transport can carry it. The original outside owner is responsible for
+// withholding this right and its private operation until the native aggregate.
+func (aggregate *NativeRoleAggregateV1) ReceiveOriginalGuestV1() (failure error) {
+	if aggregate == nil || aggregate.controller == nil {
+		return fmt.Errorf("late controller input has no original native aggregate")
+	}
+	phase := aggregate.controller
+	phase.mu.Lock()
+	defer phase.mu.Unlock()
+	if err := aggregate.checkLockedV1(); err != nil {
+		return err
+	}
+	if !aggregate.published || aggregate.received || aggregate.released {
+		return fmt.Errorf("controller private input is outside its exact native aggregate phase")
+	}
+	data := make([]byte, 5)
+	ancillary := make([]byte, unix.CmsgSpace(4)+unix.CmsgSpace(unix.SizeofUcred))
+	n, oobn, flags, _, err := unix.Recvmsg(int(phase.local.Fd()), data, ancillary, unix.MSG_CMSG_CLOEXEC)
+	if err != nil {
+		return err
+	}
+	messages, parseErr := unix.ParseSocketControlMessage(ancillary[:oobn])
+	var rights []int
+	credentials, rightFrames := 0, 0
+	var semanticErr error
+	for _, message := range messages {
+		if message.Header.Level == unix.SOL_SOCKET && message.Header.Type == unix.SCM_RIGHTS {
+			rightFrames++
+			received, err := unix.ParseUnixRights(&message)
+			semanticErr = errors.Join(semanticErr, err)
+			rights = append(rights, received...)
+		} else if message.Header.Level == unix.SOL_SOCKET && message.Header.Type == unix.SCM_CREDENTIALS {
+			credentials++
+			_, err := unix.ParseUnixCredentials(&message)
+			semanticErr = errors.Join(semanticErr, err)
+		} else {
+			semanticErr = errors.Join(semanticErr, fmt.Errorf("late controller input has unsupported ancillary data"))
+		}
+	}
+	complete := false
+	defer func() {
+		if !complete {
+			for _, fd := range rights {
+				failure = errors.Join(failure, unix.Close(fd))
+			}
+		}
+	}()
+	if parseErr != nil || semanticErr != nil || flags&(unix.MSG_TRUNC|unix.MSG_CTRUNC) != 0 || n != 4 || string(data[:n]) != "CFD\x01" || len(rights) != 1 || rightFrames != 1 || credentials != 1 {
+		return fmt.Errorf("late controller input has another closed native vector: %v", errors.Join(parseErr, semanticErr))
+	}
+	fd := rights[0]
+	var stat unix.Stat_t
+	if err := unix.Fstat(fd, &stat); err != nil || stat.Mode&unix.S_IFMT != unix.S_IFSOCK {
+		return fmt.Errorf("late controller guest is not a native socket: %v", err)
+	}
+	kind, kindErr := unix.GetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_TYPE)
+	domain, domainErr := unix.GetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_DOMAIN)
+	listener, listenErr := unix.GetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_ACCEPTCONN)
+	if kindErr != nil || domainErr != nil || listenErr != nil || kind != unix.SOCK_STREAM || domain != unix.AF_UNIX || listener != 0 {
+		return fmt.Errorf("late controller guest has another native stream role: %v", errors.Join(kindErr, domainErr, listenErr))
+	}
+	if _, err := unix.Getpeername(fd); err != nil {
+		return fmt.Errorf("late controller guest is not connected: %w", err)
+	}
+	for _, file := range append([]*os.File{phase.local, aggregate.sentry.endpoint, aggregate.gofer.endpoint}, aggregate.gofer.parked.files...) {
+		info, err := file.Stat()
+		if err != nil {
+			return err
+		}
+		var actual unix.Stat_t
+		if err := unix.Fstat(int(file.Fd()), &actual); err != nil {
+			return err
+		}
+		if info.Mode()&os.ModeSocket == 0 || stat.Dev == actual.Dev && stat.Ino == actual.Ino {
+			return fmt.Errorf("late controller guest aliases another original native IO role")
+		}
+	}
+	if err := aggregate.checkLockedV1(); err != nil {
+		return err
+	}
+	aggregate.guest = os.NewFile(uintptr(fd), "same-original-late-controller-guest")
+	aggregate.received = true
+	complete = true
+	return nil
+}
+
+// ReleaseFinalIOV1 creates the fixed controller listener only now, releases
+// exact parked Gofer streams and guest FD3, and returns one owned raw client
+// descriptor for the fixed root-start RPC. It accepts no FD table or callback.
+func (aggregate *NativeRoleAggregateV1) ReleaseFinalIOV1() (client int, failure error) {
+	client = -1
+	if aggregate == nil || aggregate.controller == nil {
+		return -1, fmt.Errorf("native IO release has no original aggregate")
+	}
+	phase := aggregate.controller
+	phase.mu.Lock()
+	defer phase.mu.Unlock()
+	if err := aggregate.checkLockedV1(); err != nil {
+		return -1, err
+	}
+	if !aggregate.published || !aggregate.received || aggregate.guest == nil || aggregate.released {
+		return -1, fmt.Errorf("native IO release lacks its original one-use late input")
+	}
+	server, err := unix.Socket(unix.AF_UNIX, unix.SOCK_STREAM|unix.SOCK_CLOEXEC, 0)
+	if err != nil {
+		return -1, err
+	}
+	defer func() { failure = errors.Join(failure, unix.Close(server)) }()
+	name := &unix.SockaddrUnix{Name: "@native-gvisor-control-" + rand.Text()}
+	if err := unix.Bind(server, name); err != nil {
+		return -1, err
+	}
+	if err := unix.Listen(server, 1); err != nil {
+		return -1, err
+	}
+	fd, err := unix.Socket(unix.AF_UNIX, unix.SOCK_STREAM|unix.SOCK_CLOEXEC, 0)
+	if err != nil {
+		return -1, err
+	}
+	complete := false
+	defer func() {
+		if !complete {
+			failure = errors.Join(failure, unix.Close(fd))
+		}
+	}()
+	if err := unix.Connect(fd, name); err != nil {
+		return -1, err
+	}
+	rights := []int{server}
+	for _, file := range aggregate.gofer.parked.files {
+		rights = append(rights, int(file.Fd()))
+	}
+	for offset := 0; offset < len(rights); {
+		count := min(240, len(rights)-offset)
+		data := make([]byte, 10)
+		copy(data, "IOV\x01")
+		binary.BigEndian.PutUint16(data[4:6], uint16(len(rights)-1))
+		binary.BigEndian.PutUint16(data[6:8], uint16(offset))
+		binary.BigEndian.PutUint16(data[8:10], uint16(count))
+		if err := aggregate.checkLockedV1(); err != nil {
+			return -1, err
+		}
+		if n, err := unix.SendmsgN(int(aggregate.sentry.endpoint.Fd()), data, unix.UnixRights(rights[offset:offset+count]...), nil, unix.MSG_NOSIGNAL); err != nil || n != len(data) {
+			return -1, fmt.Errorf("release complete original Sentry IO batch: %v", err)
+		}
+		offset += count
+	}
+	if err := aggregate.checkLockedV1(); err != nil {
+		return -1, err
+	}
+	if n, err := unix.SendmsgN(int(aggregate.gofer.endpoint.Fd()), []byte("GOF\x01"), nil, nil, unix.MSG_NOSIGNAL); err != nil || n != 4 {
+		return -1, fmt.Errorf("release same original final Gofer: %v", err)
+	}
+	if err := aggregate.checkLockedV1(); err != nil {
+		return -1, err
+	}
+	if n, err := unix.SendmsgN(int(aggregate.sentry.endpoint.Fd()), []byte("FD3\x01"), unix.UnixRights(int(aggregate.guest.Fd())), nil, unix.MSG_NOSIGNAL); err != nil || n != 4 {
+		return -1, fmt.Errorf("release original late guest FD3: %v", err)
+	}
+	if err := aggregate.guest.Close(); err != nil {
+		return -1, err
+	}
+	aggregate.guest = nil
+	aggregate.released = true
+	phase.consumed = true
+	complete = true
+	return fd, nil
+}
