+
+func checkNativeSealedCodeV1(file *os.File) error {
+	if file == nil {
+		return fmt.Errorf("initial setup lost original native code")
+	}
+	var st unix.Stat_t
+	if err := unix.Fstat(int(file.Fd()), &st); err != nil {
+		return err
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFREG || st.Mode&0111 == 0 || st.Mode&(unix.S_ISUID|unix.S_ISGID) != 0 || st.Size < 1 || st.Size > 512<<20 {
