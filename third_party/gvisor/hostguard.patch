+// SPDX-License-Identifier: Apache-2.0
+package hostguard
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"sync"
+
+	"golang.org/x/sys/unix"
+)
+
+type NativeRoleKindV1 uint8
+
+const (
+	NativeControllerV1 NativeRoleKindV1 = 1
+	NativeGoferV1      NativeRoleKindV1 = 2
+	NativeSentryV1     NativeRoleKindV1 = 3
+)
+
+// NativePrivateV1 is an actual per-process irreversible filesystem boundary.
+// Its endpoint is born only after actual post-exec ND0. It is not a boot or
+// creation-owner capability: the parent MUST authenticate the actual original
+// creation pidfd/current SCM/exe/task/socket chain before using the endpoint.
+// No JSON true, public flag or copied role name creates a final receipt.
+type NativePrivateV1 struct {
+	namespaces                         []*os.File
+	mu                                 sync.Mutex
+	role                               NativeRoleKindV1
+	pid                                int
+	topology                           *NativeTopologyV1
+	scope                              *NativeScopeV1
+	local, outward                     *os.File
+	executable, task                   *os.File
+	policy                             *NativeFilesystemV1
+	io                                 *NativeSentryIOV1
+	children                           []*NativeRoleCreationV1
+	aggregate                          *NativeRoleAggregateV1
+	nativeSetup                        *NativeSentrySetupV1
+	published, final, consumed, closed bool
+}
+
+// PrepareNativePrivateV1 is called by the fixed signed setup entry before
+// native role creation or untrusted input. The capsule is immutable setup
+// DATA only. Every later private operation still requires real final syscalls
+// and a separately checked original creation-owner handshake.
+func PrepareNativePrivateV1(kind NativeRoleKindV1, topology *NativeTopologyV1) (_ *NativePrivateV1, failure error) {
+	if kind != NativeControllerV1 && kind != NativeGoferV1 && kind != NativeSentryV1 {
+		return nil, fmt.Errorf("unsupported fixed native role")
+	}
+	if topology == nil {
+		return nil, fmt.Errorf("native role has no immutable setup")
+	}
+	if err := Disable(); err != nil {
+		return nil, err
+	}
+	scope, err := NativeEntryScopeV1()
+	if err != nil {
+		return nil, err
+	}
+	result := &NativePrivateV1{role: kind, pid: os.Getpid(), topology: topology, scope: scope}
+	complete := false
+	defer func() {
+		if !complete {
+			failure = errors.Join(failure, result.Close())
+		}
+	}()
+	// Capture own native witnesses before the final proc unmount. These are
+	// compared with the parent's SAME actual creation-bound source; a received
+	// self-exe descriptor by itself is never sufficient native authority.
+	var fd int
+	if nativeEntryFinalFSV1 == 1 {
+		// The retained OWN task source survives same-process exec and the last
+		// proc unmount. The original creation owner independently verifies its
+		// current birth/namespace/socket chain; it is not a numeric PID lookup.
+		fd, err = unix.FcntlInt(1021, unix.F_DUPFD_CLOEXEC, 3)
+		if err != nil {
+			return nil, err
+		}
+	} else {
+		fd, err = unix.Open("/proc/self", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+		if err != nil {
+			return nil, err
+		}
+	}
+	result.task = os.NewFile(uintptr(fd), "actual-runtime-own-task")
+	executableFD, err := unix.Openat(fd, "exe", unix.O_RDONLY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	result.executable = os.NewFile(uintptr(executableFD), "actual-runtime-own-executable")
+	var fs unix.Statfs_t
+	if err := unix.Fstatfs(fd, &fs); err != nil || fs.Type != unix.PROC_SUPER_MAGIC {
+		return nil, fmt.Errorf("runtime own-task source is not actual procfs: %v", err)
+	}
+	for namespaceIndex, entry := range []struct {
+		name string
+		kind int
+	}{
+		{"user", unix.CLONE_NEWUSER}, {"pid", unix.CLONE_NEWPID}, {"mnt", unix.CLONE_NEWNS},
+		{"ipc", unix.CLONE_NEWIPC}, {"net", unix.CLONE_NEWNET}, {"cgroup", unix.CLONE_NEWCGROUP},
+	} {
+		var namespaceFD int
+		var err error
+		if nativeEntryFinalFSV1 == 1 {
+			// SAME held native namespace objects from the actual setup process;
+			// exec preserves the namespaces and no late peer magic link is opened.
+			namespaceFD, err = unix.FcntlInt(uintptr(nativeFinalEntryNamespacesFDV1+namespaceIndex), unix.F_DUPFD_CLOEXEC, 3)
+		} else {
+			namespaceFD, err = unix.Openat(fd, "ns/"+entry.name, unix.O_RDONLY|unix.O_CLOEXEC, 0)
+		}
+		file := os.NewFile(uintptr(namespaceFD), "actual-own-namespace")
+		if err != nil {
+			return nil, err
+		}
+		result.namespaces = append(result.namespaces, file)
+		kind, _, errno := unix.RawSyscall(unix.SYS_IOCTL, file.Fd(), unix.NS_GET_NSTYPE, 0)
+		if errno != 0 || int(kind) != entry.kind {
+			return nil, fmt.Errorf("native role namespace witness has another type: %v", errno)
+		}
+	}
+	if err := scope.check(); err != nil {
+		return nil, err
+	}
+	pair, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_SEQPACKET|unix.SOCK_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	result.local = os.NewFile(uintptr(pair[0]), "post-ND0-native-private-local")
+	result.outward = os.NewFile(uintptr(pair[1]), "post-ND0-native-private-original-owner")
+	for _, fd := range pair {
+		if err := unix.SetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_PASSCRED, 1); err != nil {
+			return nil, err
+		}
+	}
+	complete = true
+	return result, nil
+}
+
+// TakeOriginalWitnessesV1 transfers owned copies of the fresh endpoint and
+// actual own-exe/task witnesses to the original setup handoff. That inherited
+// handoff carries only public setup proofs and MUST be closed before PRIVATE.
+// The receiving owner must match these with its retained child creation pidfd.
+func (phase *NativePrivateV1) TakeOriginalWitnessesV1() (_ []*os.File, failure error) {
+	if phase == nil {
+		return nil, fmt.Errorf("native role has no original phase")
+	}
+	phase.mu.Lock()
+	defer phase.mu.Unlock()
+	if err := phase.checkLocked(); err != nil {
+		return nil, err
+	}
+	if phase.published {
+		return nil, fmt.Errorf("native role witnesses already transferred")
+	}
+	result := []*os.File{}
+	complete := false
+	defer func() {
+		if !complete {
+			for _, file := range result {
+				failure = errors.Join(failure, file.Close())
+			}
+		}
+	}()
+	for _, file := range append([]*os.File{phase.outward, phase.executable, phase.task}, phase.namespaces...) {
+		fd, err := unix.FcntlInt(file.Fd(), unix.F_DUPFD_CLOEXEC, 3)
+		if err != nil {
+			return nil, err
+		}
+		result = append(result, os.NewFile(uintptr(fd), "actual-native-phase-witness"))
+	}
+	if err := phase.outward.Close(); err != nil {
+		return nil, err
+	}
+	phase.outward = nil
+	phase.published = true
+	complete = true
+	return result, nil
+}
+
+func (phase *NativePrivateV1) checkLocked() error {
+	if phase.closed || phase.pid != os.Getpid() || phase.topology == nil || phase.local == nil {
+		return fmt.Errorf("native role phase has another process or ended lifetime")
+	}
+	return phase.scope.check()
+}
+
+// FinishTopologyV1 must be called only at this actual role's last native
+// mount/pivot/unmount/chroot boundary, before its filter or guest RPC starts.
+// Exact root and writable objects come from native setup. No path is reopened
+// from the capsule, and no input is accepted before all-thread restriction.
+func (phase *NativePrivateV1) FinishTopologyV1(root *os.File) error {
+	if phase == nil {
+		return fmt.Errorf("native role has no actual private phase")
+	}
+	phase.mu.Lock()
+	defer phase.mu.Unlock()
+	if err := phase.checkLocked(); err != nil {
+		return err
+	}
+	if !phase.published || phase.final || phase.consumed {
+		return fmt.Errorf("native role final boundary is out of order")
+	}
+	var policy *NativeFilesystemV1
+	var err error
+	if phase.role == NativeSentryV1 {
+		// A late per-thread layer cannot cover the already-created systrap source
+		// or preserve its full ptrace ancestry. ONLY actual final pre-Go entry
+		// inheritance can issue this Sentry receipt.
+		policy, err = nativeEntryFinalFilesystemV1(phase.scope)
+	} else {
+		var roots []NativeFSRootV1
+		roots, err = phase.topology.policyRootsV1(root)
+		if err == nil {
+			policy, err = PrepareNativeFilesystemV1(phase.scope, roots)
+		}
+		if err == nil {
+			err = policy.EnforceFinalV1()
+		}
+	}
+	if err != nil {
+		return err
+	}
+	phase.policy = policy
+	if err := policy.finalReceiptV1(); err != nil {
+		return err
+	}
+	// No success frame exists before the actual all-thread native result.
+	data := []byte{'F', 'S', 'V', 1, byte(phase.role)}
+	if n, err := unix.SendmsgN(int(phase.local.Fd()), data, nil, nil, unix.MSG_NOSIGNAL); err != nil || n != len(data) {
+		return fmt.Errorf("publish actual role filesystem boundary: %v", err)
+	}
+	phase.final = true
+	return nil
+}
+
+// ReceiveLateGuestFD3V1 accepts exactly one native Unix stream only after
+// this actual Sentry's real final filesystem receipt. It supplies neither an
+// arbitrary guest FD table nor commands/environment. The original owner must
+// have joined ALL other live-role final barriers/tiny-role exits before send.
+func (phase *NativePrivateV1) ReceiveLateGuestFD3V1() (_ *os.File, failure error) {
+	if phase == nil {
+		return nil, fmt.Errorf("late guest FD3 has no native Sentry phase")
+	}
+	phase.mu.Lock()
+	defer phase.mu.Unlock()
+	if err := phase.checkLocked(); err != nil {
+		return nil, err
+	}
+	if phase.role != NativeSentryV1 || !phase.final || phase.consumed || phase.policy == nil || phase.io == nil || !phase.io.accepted {
+		return nil, fmt.Errorf("late guest FD3 arrived before the actual Sentry boundary")
+	}
+	if err := phase.policy.finalReceiptV1(); err != nil {
+		return nil, err
+	}
+	data := make([]byte, 5)
+	ancillary := make([]byte, unix.CmsgSpace(4)+unix.CmsgSpace(unix.SizeofUcred))
+	n, oobn, flags, _, err := unix.Recvmsg(int(phase.local.Fd()), data, ancillary, unix.MSG_CMSG_CLOEXEC)
+	var rights []int
+	complete := false
+	defer func() {
+		if !complete {
+			for _, fd := range rights {
+				_ = unix.Close(fd)
+			}
+		}
+	}()
+	if err != nil {
+		return nil, err
+	}
+	messages, parseErr := unix.ParseSocketControlMessage(ancillary[:oobn])
+	// Collect every kernel-delivered right before any semantic refusal, so
+	// malformed ancillary order cannot strand an untracked native descriptor.
+	rightFrames := 0
+	var semanticErr error
+	for _, message := range messages {
+		if message.Header.Level == unix.SOL_SOCKET && message.Header.Type == unix.SCM_RIGHTS {
+			rightFrames++
+			received, err := unix.ParseUnixRights(&message)
+			semanticErr = errors.Join(semanticErr, err)
+			rights = append(rights, received...)
+		}
+	}
+	credentials := 0
+	for _, message := range messages {
+		if message.Header.Level != unix.SOL_SOCKET {
+			semanticErr = errors.Join(semanticErr, fmt.Errorf("late guest FD3 has another ancillary level"))
+			continue
+		}
+		switch message.Header.Type {
+		case unix.SCM_RIGHTS:
+		case unix.SCM_CREDENTIALS:
+			_, err := unix.ParseUnixCredentials(&message)
+			semanticErr = errors.Join(semanticErr, err)
+			credentials++
+		default:
+			semanticErr = errors.Join(semanticErr, fmt.Errorf("late guest FD3 contains unsupported ancillary data"))
+		}
+	}
+
+	if parseErr != nil || semanticErr != nil || flags&(unix.MSG_TRUNC|unix.MSG_CTRUNC) != 0 || n != 4 || string(data[:n]) != "FD3\x01" || len(rights) != 1 || rightFrames != 1 || credentials != 1 {
+		return nil, fmt.Errorf("late guest FD3 has a malformed closed vector: %v", errors.Join(parseErr, semanticErr))
+	}
+	// SCM PID0 is normal for the outer owner outside this PID namespace. It is
+	// not used as authority. The fresh endpoint and original creation handshake
+	// bind the sender; no advertised numeric PID grants release.
+	fd := rights[0]
+	var st unix.Stat_t
+	if err := unix.Fstat(fd, &st); err != nil || st.Mode&unix.S_IFMT != unix.S_IFSOCK {
+		return nil, fmt.Errorf("late FD3 is not a native socket: %v", err)
+	}
+	for _, object := range phase.io.objects {
+		if object.Dev == uint64(st.Dev) && object.Ino == st.Ino {
+			return nil, fmt.Errorf("late FD3 aliases another fixed native IO role")
+		}
+	}
+	kind, err := unix.GetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_TYPE)
+	if err != nil || kind != unix.SOCK_STREAM {
+		return nil, fmt.Errorf("late FD3 has another socket kind: %v", err)
+	}
+	domain, err := unix.GetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_DOMAIN)
+	if err != nil || domain != unix.AF_UNIX {
+		return nil, fmt.Errorf("late FD3 has another native domain: %v", err)
+	}
+	listening, err := unix.GetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_ACCEPTCONN)
+	if err != nil || listening != 0 {
+		return nil, fmt.Errorf("late FD3 is a listener instead of a connected guest stream: %v", err)
+	}
+	if _, err := unix.Getpeername(fd); err != nil {
+		return nil, fmt.Errorf("late FD3 is not connected: %w", err)
+	}
+	phase.consumed = true
+	complete = true
+	return os.NewFile(uintptr(fd), "one-use-late-guest-FD3"), nil
+}
+
+func (phase *NativePrivateV1) Close() error {
+	if phase == nil {
+		return nil
+	}
+	phase.mu.Lock()
+	defer phase.mu.Unlock()
+	if phase.closed {
+		return nil
+	}
+	for _, child := range phase.children {
+		if err := child.requirePhysicalJoinV1(); err != nil {
+			// Retain ALL original role objects on uncertainty. Closing an old
+			// setup stream or receiving EOF can never settle a live child.
+			return err
+		}
+	}
+	phase.closed = true
+	phase.nativeSetup = nil
+	var result error
+	for _, file := range append([]*os.File{phase.local, phase.outward, phase.executable, phase.task}, phase.namespaces...) {
+		if file != nil {
+			result = errors.Join(result, file.Close())
+		}
+	}
+	if phase.policy != nil {
+		result = errors.Join(result, phase.policy.Close())
+	}
+	if phase.io != nil {
+		result = errors.Join(result, phase.io.Close())
+	}
+	if phase.aggregate != nil && phase.aggregate.guest != nil {
+		result = errors.Join(result, phase.aggregate.guest.Close())
+		phase.aggregate.guest = nil
+	}
+	for _, child := range phase.children {
+		result = errors.Join(result, child.Close())
+	}
+	return result
+}
+
+// FinishCurrentRootV1 captures the actual final role root after its last
+// topology operation. The descriptor is not a caller-supplied host pathname.
+func (phase *NativePrivateV1) FinishCurrentRootV1() error {
+	fd, err := unix.Open("/", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return err
+	}
+	root := os.NewFile(uintptr(fd), "actual-final-native-role-root")
+	return errors.Join(phase.FinishTopologyV1(root), root.Close())
+}
+
+func (phase *NativePrivateV1) RequireRoleV1(kind NativeRoleKindV1) error {
+	if phase == nil {
+		return fmt.Errorf("native role has no original private phase")
+	}
+	phase.mu.Lock()
+	defer phase.mu.Unlock()
+	if err := phase.checkLocked(); err != nil {
+		return err
+	}
+	if phase.role != kind {
+		return fmt.Errorf("native private boundary belongs to another fixed role")
+	}
+	return nil
+}
+
+// IsFinalSentryEntryV1 is a source check, not caller-selectable policy. Only
+// actual successful raw pre-Go FS enforcement writes the private receipt.
+func (phase *NativePrivateV1) IsFinalSentryEntryV1() bool {
+	return phase != nil && phase.role == NativeSentryV1 && phase.pid == os.Getpid() && nativeEntryFinalFSV1 == 1
+}
