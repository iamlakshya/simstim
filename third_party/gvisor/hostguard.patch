+package hostguard
+
+import "testing"
+
+func TestNativeMapGrammar(t *testing.T) {
+	for _, text := range []string{"         0          0          1\n", "0 0 4294967295\n", "0 1000 1\n1 2000 8\n"} {
+		if _, err := parseMap(text); err != nil {
+			t.Fatal("a valid kernel map was refused", text, err)
+		}
+	}
+	for _, text := range []string{"", "0 0 1", "0 0 0\n", "00 0 1\n", "0 0 +1\n", "0 0 4294967296\n", "1 0 4294967295\n", "0 0 1\n0 2 1\n", "0 0 1\n1 0 1\n", "0 0 1\n\n", "0\u00a00 1\n"} {
+		if _, err := parseMap(text); err == nil {
+			t.Fatal("an invalid map acquired single-owner authority", text)
+		}
+	}
+}
