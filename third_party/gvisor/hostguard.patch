+// SPDX-License-Identifier: Apache-2.0
+package sentrycmd
+
+import (
+	"reflect"
+	"testing"
+
+	"gvisor.dev/gvisor/runsc/config"
+	"gvisor.dev/gvisor/runsc/hostguard"
+)
+
+func TestFinalConfigCannotTakeAmbientProcessOptions(t *testing.T) {
+	t.Setenv("XDG_RUNTIME_DIR", "/ambient/private-home")
+	conf, err := nativeFixedConfigV1()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if conf.RootDir != "/run/native-runtime" || conf.Platform != "systrap" || conf.DirectFS || conf.DisableSeccomp || conf.Network != config.NetworkNone || conf.HostUDS != config.HostUDSNone || conf.HostFifo != config.HostFifoNone || conf.ProfileEnable || conf.MetricServer != "" {
+		t.Fatal("ambient configuration changed fixed final entry", conf)
+	}
+}
+
+func TestFinalSpecUsesOnlyFixedGuestProgramAndOpaqueStateMount(t *testing.T) {
+	projection := hostguard.NativeGuestProjectionV1{ID: "aaaa2222", Role: "guest-init", HelperGuest: "/opt/native/bin/helper", Mounts: []hostguard.NativeGuestMountV1{{Guest: "/home/agent/.config", Write: true, Role: "kept-dir"}}}
+	spec, err := nativeFixedSpecV1(projection)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(spec.Process.Args, []string{projection.HelperGuest, "wall-init"}) || spec.Process.User.UID != 1000 || spec.Process.User.GID != 1000 || !spec.Process.NoNewPrivileges || spec.Process.Capabilities != nil {
+		t.Fatal("fixed guest-init acquired another process authority")
+	}
+	state := spec.Mounts[len(spec.Mounts)-1]
+	if state.Source != projection.Mounts[0].Guest || state.Destination != projection.Mounts[0].Guest || !reflect.DeepEqual(state.Options, []string{"bind", "rw", "nosuid", "nodev"}) {
+		t.Fatal("opaque original state mount acquired another source or parser")
+	}
+	projection.Role, projection.HelperGuest = "probe-true", ""
+	spec, err = nativeFixedSpecV1(projection)
+	if err != nil || !reflect.DeepEqual(spec.Process.Args, []string{"/usr/bin/true"}) || spec.Process.Cwd != "/" {
+		t.Fatal("fixed probe changed its original program", err)
+	}
+	projection.Role = "caller-program"
+	if _, err := nativeFixedSpecV1(projection); err == nil {
+		t.Fatal("caller program entered final native dispatch")
+	}
+}
+
+func TestFinalGoferMountsCannotChangeBackend(t *testing.T) {
+	for _, count := range []int{1, 3, 1025} {
+		values, err := nativeFixedMountConfsV1(count)
+		if err != nil || len(values) != count {
+			t.Fatal("fixed Gofer vector cannot be constructed", count, err)
+		}
+	}
+	for _, count := range []int{-1, 0, 1026} {
+		if _, err := nativeFixedMountConfsV1(count); err == nil {
+			t.Fatal("unsupported Gofer extent passed", count)
+		}
+	}
+}
