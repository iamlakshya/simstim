+// SPDX-License-Identifier: Apache-2.0
+// Package nativeconfig constructs the locally fixed public native role input.
+// It neither reads global flags nor accepts caller OCI, process data or IO.
+package nativeconfig
+
+import (
+	"fmt"
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+	"gvisor.dev/gvisor/runsc/config"
+	"gvisor.dev/gvisor/runsc/flag"
+	"gvisor.dev/gvisor/runsc/hostguard"
+	"gvisor.dev/gvisor/runsc/specutils"
+	"strings"
+)
+
+func ConfigV1() (*config.Config, error) {
+	// This is a local default table, never flag.CommandLine or caller input.
+	// Registering the pinned defaults also initialises private config fields.
+	fixed := flag.NewFlagSet("native-final-sentry-v1", flag.ContinueOnError)
+	config.RegisterFlags(fixed)
+	for _, value := range [][2]string{
+		{"root", "/run/native-runtime"}, {"platform", "systrap"},
+		{"network", "none"}, {"directfs", "false"}, {"overlay2", "none"},
+		{"file-access", "shared"}, {"file-access-mounts", "shared"},
+		{"rootless", "true"}, {"host-settings", "ignore"},
+		{"host-uds", "none"}, {"host-fifo", "none"},
+	} {
+		if err := fixed.Set(value[0], value[1]); err != nil {
+			return nil, fmt.Errorf("construct fixed native config: %w", err)
+		}
+	}
+	conf, err := config.NewFromFlags(fixed)
+	if err != nil {
+		return nil, err
+	}
+	if conf.Platform != "systrap" || conf.DirectFS || conf.DisableSeccomp || conf.Network != config.NetworkNone || conf.HostUDS != config.HostUDSNone || conf.ProfileEnable || conf.MetricServer != "" {
+		return nil, fmt.Errorf("pinned native config changed its fixed private purpose")
+	}
+	return conf, nil
+}
+
+func MountConfsV1(count int) ([]specutils.GoferMountConf, error) {
+	if count < 1 || count > 1025 {
+		return nil, fmt.Errorf("fixed native mount vector exceeds its topology bound")
+	}
+	values := make([]string, count)
+	for index := range values {
+		values[index] = "lisafs:none"
+	}
+	var flags specutils.GoferMountConfFlags
+	if err := flags.Set(strings.Join(values, ",")); err != nil {
+		return nil, fmt.Errorf("construct fixed native Gofer mount config: %w", err)
+	}
+	result := flags.GetArray()
+	if len(result) != count {
+		return nil, fmt.Errorf("fixed native Gofer mount count changed")
+	}
+	for _, value := range result {
+		if !value.ShouldUseLisafs() || value.ShouldUseOverlayfs() {
+			return nil, fmt.Errorf("fixed native Gofer mount acquired another backing")
+		}
+	}
+	return result, nil
+}
+
+func SpecV1(projection hostguard.NativeGuestProjectionV1) (*specs.Spec, error) {
+	argv := []string{}
+	cwd := "/work"
+	switch projection.Role {
+	case "guest-init":
+		if projection.HelperGuest == "" {
+			return nil, fmt.Errorf("fixed guest-init lost its original code target")
+		}
+		argv = []string{projection.HelperGuest, "wall-init"}
+	case "probe-true":
+		if projection.HelperGuest != "" {
+			return nil, fmt.Errorf("fixed probe acquired another program")
+		}
+		argv = []string{"/usr/bin/true"}
+		cwd = "/"
+	default:
+		return nil, fmt.Errorf("unsupported fixed native guest role")
+	}
+	result := &specs.Spec{Version: "1.2.1", Root: &specs.Root{Path: "/", Readonly: true},
+		Process: &specs.Process{Terminal: false, User: specs.User{UID: 1000, GID: 1000}, Args: argv, Env: []string{"HOME=/home/agent", "PATH=/usr/local/bin:/usr/bin:/bin", "LANG=C.UTF-8", "LC_ALL=C.UTF-8", "TZ=UTC"}, Cwd: cwd, NoNewPrivileges: true},
+		Linux:   &specs.Linux{Namespaces: []specs.LinuxNamespace{}},
+		Mounts: []specs.Mount{
+			{Destination: "/proc", Type: "proc", Source: "proc", Options: []string{"nosuid", "nodev", "noexec"}},
+			{Destination: "/dev", Type: "tmpfs", Source: "tmpfs", Options: []string{"nosuid", "mode=755"}},
+			{Destination: "/dev/pts", Type: "devpts", Source: "devpts", Options: []string{"nosuid", "noexec", "newinstance", "ptmxmode=0666", "mode=0620"}},
+			{Destination: "/dev/shm", Type: "tmpfs", Source: "shm", Options: []string{"nosuid", "nodev", "noexec", "mode=1777"}},
+			{Destination: "/tmp", Type: "tmpfs", Source: "tmpfs", Options: []string{"nosuid", "nodev", "mode=1777"}},
+			{Destination: "/run", Type: "tmpfs", Source: "tmpfs", Options: []string{"nosuid", "nodev", "mode=755", "uid=1000", "gid=1000"}},
+			{Destination: "/home/agent", Type: "tmpfs", Source: "tmpfs", Options: []string{"nosuid", "nodev", "mode=700", "uid=1000", "gid=1000"}},
+		},
+	}
+	seen := map[string]bool{}
+	for _, mount := range projection.Mounts {
+		if seen[mount.Guest] {
+			return nil, fmt.Errorf("fixed guest projection repeats a native target")
+		}
+		seen[mount.Guest] = true
+		mode := "ro"
+		if mount.Write {
+			mode = "rw"
+		}
+		result.Mounts = append(result.Mounts, specs.Mount{Destination: mount.Guest, Type: "bind", Source: mount.Guest, Options: []string{"bind", mode, "nosuid", "nodev"}})
+	}
+	return result, nil
+}
