+package sentrycmd
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"runtime"
+
+	"golang.org/x/sys/unix"
+	"gvisor.dev/gvisor/runsc/flag"
+	"gvisor.dev/gvisor/runsc/hostguard"
+)
+
+// RunNativeSetupSentryV1 is the closed public setup dispatch. It feeds only a
+// locally generated fixed spec to the existing topology implementation. No
+// caller OCI, process flags, guest IO or private endpoint enters that path.
+func RunNativeSetupSentryV1() error {
+	owner, err := hostguard.CaptureNativeSentrySetupV1()
+	if err != nil {
+		return err
+	}
+	defer owner.Close()
+	phase, projection, input, err := owner.SetupProjectionV1()
+	if err != nil {
+		return err
+	}
+	conf, err := nativeFixedConfigV1()
+	if err != nil {
+		return err
+	}
+	// Actual one-ID mapped root was checked above. This selects the original
+	// tiny child's real proc-unmount/join path before capabilities are dropped;
+	// it does not add host privileges or accept another user mapping.
+	conf.Rootless = false
+	spec, err := nativeFixedSpecV1(projection)
+	if err != nil {
+		return err
+	}
+	raw, err := json.Marshal(spec)
+	if err != nil || len(raw) > 4<<20 {
+		return fmt.Errorf("fixed native setup spec exceeds its public bound: %v", err)
+	}
+	specFD, err := unix.MemfdCreate("native-fixed-public-spec-v1", unix.MFD_CLOEXEC|unix.MFD_ALLOW_SEALING)
+	if err != nil {
+		return err
+	}
+	if n, err := unix.Write(specFD, raw); err != nil || n != len(raw) {
+		_ = unix.Close(specFD)
+		return fmt.Errorf("write complete fixed native setup spec: %v", err)
+	}
+	required := unix.F_SEAL_WRITE | unix.F_SEAL_GROW | unix.F_SEAL_SHRINK | unix.F_SEAL_SEAL
+	if _, err := unix.FcntlInt(uintptr(specFD), unix.F_ADD_SEALS, required); err != nil {
+		_ = unix.Close(specFD)
+		return err
+	}
+	if _, err := unix.Seek(specFD, 0, 0); err != nil {
+		_ = unix.Close(specFD)
+		return err
+	}
+	umounterFD, err := owner.TakeProcUmounterV1()
+	if err != nil {
