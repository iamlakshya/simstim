+)
+
+// nativeParkedGoferIOV1 owns only the original Gofer's freshly created client
+// streams. Receiving them starts no lisafs RPC and supplies no private release.
+type nativeParkedGoferIOV1 struct {
+	original *NativeRoleCreationV1
+	files    []*os.File
+}
+
+func (owner *NativeRoleCreationV1) checkOriginalFinalLockedV1(kind NativeRoleKindV1) error {
+	if err := owner.checkLiveLockedV1(); err != nil {
+		return err
+	}
+	if owner.kind != kind || owner.final == nil || owner.final.original != owner || owner.endpoint == nil || len(owner.witnesses) != 8 {
+		return fmt.Errorf("native role has no same original final filesystem receive")
+	}
+	birth, err := readNativeTaskBirthV1(owner.task)
+	if err != nil || birth != owner.birth {
+		return fmt.Errorf("native role changed its original final kernel birth: %v", err)
+	}
+	if err := owner.checkCurrentOriginalRoleV1(owner.witnesses[2:]); err != nil {
+		return err
+	}
+	return owner.checkLiveLockedV1()
+}
+
+// ReceiveParkedGoferIOV1 consumes exact ordered batches from this SAME created
+// Gofer after its actual final filesystem result. Each record must have that
+// original current kernel sender. Every delivered right becomes owned before
+// any semantic refusal; malformed vectors never leave untracked descriptors.
+func (owner *NativeRoleCreationV1) ReceiveParkedGoferIOV1() (failure error) {
+	if owner == nil {
+		return fmt.Errorf("parked Gofer IO has no original creation")
+	}
+	owner.mu.Lock()
+	defer owner.mu.Unlock()
+	if err := owner.checkOriginalFinalLockedV1(NativeGoferV1); err != nil {
+		return err
+	}
+	if owner.parked != nil {
+		return fmt.Errorf("original Gofer IO was already received")
+	}
+	count := len(owner.controller.topology.wire.Mounts) + 1
+	if count < 1 || count > 1025 {
+		return fmt.Errorf("parked Gofer IO changed original topology extent")
+	}
+	parked := &nativeParkedGoferIOV1{original: owner}
+	complete := false
+	defer func() {
+		if !complete {
+			for _, file := range parked.files {
+				failure = errors.Join(failure, file.Close())
+			}
+		}
+	}()
+	seen := map[[2]uint64]bool{}
+	for offset := 0; offset < count; {
+		batch := min(240, count-offset)
+		data := make([]byte, 11)
+		ancillary := make([]byte, unix.CmsgSpace(batch*4)+unix.CmsgSpace(unix.SizeofUcred))
+		n, oobn, flags, _, err := unix.Recvmsg(int(owner.endpoint.Fd()), data, ancillary, unix.MSG_CMSG_CLOEXEC)
+		if err != nil {
+			return err
+		}
+		messages, parseErr := unix.ParseSocketControlMessage(ancillary[:oobn])
+		var rights []int
+		var sender *unix.Ucred
+		credentials, rightFrames := 0, 0
+		var semanticErr error
+		for _, message := range messages {
+			if message.Header.Level == unix.SOL_SOCKET && message.Header.Type == unix.SCM_RIGHTS {
+				rightFrames++
+				received, err := unix.ParseUnixRights(&message)
+				semanticErr = errors.Join(semanticErr, err)
+				rights = append(rights, received...)
+			} else if message.Header.Level == unix.SOL_SOCKET && message.Header.Type == unix.SCM_CREDENTIALS {
+				credentials++
+				current, err := unix.ParseUnixCredentials(&message)
+				semanticErr = errors.Join(semanticErr, err)
+				sender = current
+			} else {
+				semanticErr = errors.Join(semanticErr, fmt.Errorf("parked Gofer IO contains unsupported ancillary data"))
+			}
+		}
+		for _, fd := range rights {
+			parked.files = append(parked.files, os.NewFile(uintptr(fd), "same-original-Gofer-parked-stream"))
+		}
+		if parseErr != nil || semanticErr != nil || flags&(unix.MSG_TRUNC|unix.MSG_CTRUNC) != 0 || n != 10 || string(data[:4]) != "GIO\x01" || int(binary.BigEndian.Uint16(data[4:6])) != count || int(binary.BigEndian.Uint16(data[6:8])) != offset || int(binary.BigEndian.Uint16(data[8:10])) != batch || len(rights) != batch || rightFrames != 1 || credentials != 1 || sender == nil || int(sender.Pid) != owner.process.Pid || sender.Uid != 0 || sender.Gid != 0 {
+			return fmt.Errorf("parked Gofer IO changed its current original sender or closed batch: %v", errors.Join(parseErr, semanticErr))
+		}
+		for _, fd := range rights {
+			var stat unix.Stat_t
+			if err := unix.Fstat(fd, &stat); err != nil || stat.Mode&unix.S_IFMT != unix.S_IFSOCK {
+				return fmt.Errorf("parked Gofer IO is not a native socket: %v", err)
+			}
+			identity := [2]uint64{uint64(stat.Dev), stat.Ino}
+			if seen[identity] {
+				return fmt.Errorf("parked Gofer IO aliases another original mount stream")
+			}
+			seen[identity] = true
+			domain, domainErr := unix.GetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_DOMAIN)
+			kind, kindErr := unix.GetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_TYPE)
+			listener, listenErr := unix.GetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_ACCEPTCONN)
+			peer, peerErr := unix.GetsockoptUcred(fd, unix.SOL_SOCKET, unix.SO_PEERCRED)
+			if domainErr != nil || kindErr != nil || listenErr != nil || peerErr != nil || domain != unix.AF_UNIX || kind != unix.SOCK_STREAM || listener != 0 || peer == nil || int(peer.Pid) != owner.process.Pid || peer.Uid != 0 || peer.Gid != 0 {
+				return fmt.Errorf("parked stream was not born in this same final Gofer: %v", errors.Join(domainErr, kindErr, listenErr, peerErr))
+			}
+			if _, err := unix.Getpeername(fd); err != nil {
+				return fmt.Errorf("parked Gofer stream is not connected: %w", err)
+			}
+		}
+		if err := owner.checkOriginalFinalLockedV1(NativeGoferV1); err != nil {
+			return err
+		}
+		offset += batch
+	}
+	owner.parked = parked
+	complete = true
+	return nil
+}
