+// SPDX-License-Identifier: Apache-2.0
+package hostguard
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"runtime"
+	"sync"
+	"syscall"
+	"unsafe"
+
+	"golang.org/x/sys/unix"
+)
+
+// NativeScopeV1 is a private success receipt from this actual runtime's real
+// pre-Go single-thread common scope. Data, a role string or a public flag cannot create
+// a filesystem-only layer. The receipt cannot survive an exec or PID change.
+type NativeScopeV1 struct {
+	pid, abi int
+	applied  *nativeScopeAppliedV1
+}
+type nativeScopeAppliedV1 struct{ original *NativeScopeV1 }
+
+type nativeRulesetAttrV1 struct{ FS, Net, Scoped uint64 }
+type nativePathRuleV1 struct {
+	Allowed  uint64
+	Parent   int32
+	Reserved uint32
+}
+
+func nativeLandlockABIV1() (int, error) {
+	value, _, errno := unix.RawSyscall(unix.SYS_LANDLOCK_CREATE_RULESET, 0, 0, 1)
+	if errno != 0 {
+		return 0, fmt.Errorf("read native Landlock ABI: %w", errno)
+	}
+	if value < 1 || value > 1<<16 {
+		return 0, fmt.Errorf("native Landlock ABI is not supported")
+	}
+	return int(value), nil
+}
+
+func createNativeRulesetV1(attr *nativeRulesetAttrV1, abi int) (int, error) {
+	size := uintptr(8)
+	if abi >= 4 {
+		size = 16
+	}
+	if abi >= 6 {
+		size = 24
+	}
+	result, _, errno := unix.RawSyscall(unix.SYS_LANDLOCK_CREATE_RULESET, uintptr(unsafe.Pointer(attr)), size, 0)
+	runtime.KeepAlive(attr)
+	if errno != 0 {
+		return -1, fmt.Errorf("create native filesystem ruleset: %w", errno)
+	}
+	return int(result), nil
+}
+
+// enforceNativeAllThreadsV1 refuses cgo/unsupported or partial restrictions.
+// syscall.AllThreadsSyscall operates on every Go runtime thread and causes
+// future threads to inherit the result. No private acknowledgement is emitted
+// by this library on failure; the original owner must kill/join the scope.
+func enforceNativeAllThreadsV1(fd int) error {
+	if _, _, errno := syscall.AllThreadsSyscall6(unix.SYS_PRCTL, unix.PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0, 0); errno != 0 {
+		return fmt.Errorf("set all-thread no_new_privs: %w", errno)
+	}
+	if _, _, errno := syscall.AllThreadsSyscall(unix.SYS_LANDLOCK_RESTRICT_SELF, uintptr(fd), 0, 0); errno != 0 {
+		return fmt.Errorf("restrict all native runtime threads: %w", errno)
+	}
+	return nil
+}
+
+// nativeEntryScopeABIV1 is written only by the raw ELF entry after actual
+// single-thread NNP and scope enforcement, before any Go initialiser or thread.
+// A Go flag/JSON/caller bool cannot set the receipt. All runtime threads and
+// later native children inherit ONE actual common domain, rather than sibling
+// domains from separate per-thread Landlock calls.
+var nativeEntryScopeABIV1 uintptr
+
+// Written only after the exact final raw ELF entry actually applies its
+// inherited kernel filesystem ruleset before Go or platform.New.
+var nativeEntryFinalFSV1 uintptr
+
+// NativeFinalEntryV1 recognises only the private raw-entry success receipt.
+// Dispatch still checks the exact fixed argv, sealed state and native objects.
+// Public CLI arguments alone cannot cause final dispatch.
+func NativeFinalEntryV1() bool { return nativeEntryFinalFSV1 == 1 }
+
+// NativeEntryScopeV1 consumes the actual pre-Go receipt. ABI<6 has no scope
+// feature; the entry records that exact native ABI and real NNP. An alternate
+// ELF entry or unsupported build has no receipt and fails closed.
+func NativeEntryScopeV1() (*NativeScopeV1, error) {
+	if err := Disable(); err != nil {
+		return nil, err
+	}
+	abi, err := nativeLandlockABIV1()
+	if err != nil {
+		return nil, err
+	}
+	if nativeEntryScopeABIV1 == 0 || nativeEntryScopeABIV1 != uintptr(abi) {
+		return nil, fmt.Errorf("native runtime lacks its original single-thread entry scope")
+	}
+	proof := &NativeScopeV1{pid: os.Getpid(), abi: abi}
+	proof.applied = &nativeScopeAppliedV1{original: proof}
+	if err := proof.check(); err != nil {
+		return nil, err
+	}
+	return proof, nil
+}
+
+func (scope *NativeScopeV1) check() error {
+	if scope == nil || scope.applied == nil || scope.applied.original != scope || scope.pid != os.Getpid() || scope.abi < 1 {
+		return fmt.Errorf("filesystem boundary has no actual original runtime scope")
+	}
+	abi, err := nativeLandlockABIV1()
+	if err != nil || abi != scope.abi {
+		return fmt.Errorf("native scope ABI changed: %v", err)
+	}
+	actual, err := unix.PrctlRetInt(unix.PR_GET_DUMPABLE, 0, 0, 0, 0)
+	if err != nil || actual != 0 {
+		return fmt.Errorf("native role became dumpable before filesystem boundary: %v", err)
+	}
+	nnp, err := unix.PrctlRetInt(unix.PR_GET_NO_NEW_PRIVS, 0, 0, 0, 0)
+	if err != nil || nnp != 1 {
+		return fmt.Errorf("native role lost no_new_privs: %v", err)
+	}
+	return nil
+}
+
+// NativeFilesystemV1 retains the exact already-opened role root and explicit
+// writable mount objects while the final native topology finishes. The roots
+// are objects from the closed setup projection, never unrelated host paths.
+type NativeFilesystemV1 struct {
+	mu       sync.Mutex
+	scope    *NativeScopeV1
+	fd       int
+	roots    []*os.File
+	consumed bool
+	applied  *nativeFSAppliedV1
+}
+
+type nativeFSAppliedV1 struct {
+	original *NativeFilesystemV1
+	pid      int
+}
+
+// NativeFSRootV1 is DATA plus an existing owned native object. ReadWrite is
+// only the original fixed topology's mode; it grants no new root or program.
+type NativeFSRootV1 struct {
+	File       *os.File
+	ReadWrite  bool
+	Executable bool
+}
+
+func nativeFSRightsV1(abi int) uint64 {
+	switch {
+	case abi == 1:
+		return 1<<13 - 1
+	case abi == 2:
+		return 1<<14 - 1
+	case abi <= 4:
+		return 1<<15 - 1
+	case abi <= 8:
+		return 1<<16 - 1
+	default:
+		return 1<<17 - 1
+	}
+}
+
+// FS-only role completion never creates a signal/IPC scope. Controller and
+// Gofer keep the SAME raw pre-Go scoped ancestor. Sentry uses its separate
+// same-PID final exec, so every systrap descendant inherits ONE final FS domain.
+func nativeFilesystemAttrV1(abi int) nativeRulesetAttrV1 {
+	attr := nativeRulesetAttrV1{FS: nativeFSRightsV1(abi)}
+	if abi >= 4 {
+		attr.Net = 3
+	}
+	if abi >= 10 {
+		attr.Net = 15
+	}
+	return attr
+}
+
+func PrepareNativeFilesystemV1(scope *NativeScopeV1, roots []NativeFSRootV1) (_ *NativeFilesystemV1, returned error) {
+	if err := scope.check(); err != nil {
+		return nil, err
+	}
+	if len(roots) == 0 {
+		return nil, fmt.Errorf("native filesystem boundary has no captured role root")
+	}
+	attr := nativeFilesystemAttrV1(scope.abi)
+	fd, err := createNativeRulesetV1(&attr, scope.abi)
+	if err != nil {
+		return nil, err
+	}
+	result := &NativeFilesystemV1{scope: scope, fd: fd}
+	complete := false
+	defer func() {
+		if !complete {
+			returned = errors.Join(returned, result.Close())
+		}
+	}()
+	for _, root := range roots {
+		if root.File == nil {
+			return nil, fmt.Errorf("native role root is missing")
+		}
+		captured, err := unix.FcntlInt(root.File.Fd(), unix.F_DUPFD_CLOEXEC, 3)
+		if err != nil {
+			return nil, err
+		}
+		file := os.NewFile(uintptr(captured), "actual-native-role-root")
+		result.roots = append(result.roots, file)
+		var st unix.Stat_t
+		if err := unix.Fstat(captured, &st); err != nil {
+			return nil, err
+		}
+		access := uint64((1 << 2) | (1 << 3)) // read file and directory.
+		if root.ReadWrite {
+			access |= (1 << 1) | (1 << 4) | (1 << 5) | (1 << 7) | (1 << 8) | (1 << 9) | (1 << 10) | (1 << 12) | (1 << 13) | (1 << 14)
+		}
+		if root.Executable {
+			access |= 1
+		}
+		access &= attr.FS
+		if st.Mode&unix.S_IFMT != unix.S_IFDIR {
+			access &= (1 << 0) | (1 << 1) | (1 << 2) | (1 << 14) | (1 << 15) | (1 << 16)
+		}
+		rule := nativePathRuleV1{Allowed: access, Parent: int32(captured)}
+		_, _, errno := unix.RawSyscall6(unix.SYS_LANDLOCK_ADD_RULE, uintptr(fd), 1, uintptr(unsafe.Pointer(&rule)), 0, 0, 0)
+		runtime.KeepAlive(rule)
+		if errno != 0 {
+			return nil, fmt.Errorf("add actual native role object: %w", errno)
+		}
+	}
+	complete = true
+	return result, nil
+}
+
+// EnforceFinalV1 is called ONLY after this role's final mount/pivot/unmount/
+// chroot boundary and BEFORE any guest/private input. Success is one-use and
+// does not itself issue a native role, boot or payload capability.
+func (policy *NativeFilesystemV1) EnforceFinalV1() error {
+	if policy == nil {
+		return fmt.Errorf("native role has no prepared final filesystem boundary")
+	}
+	policy.mu.Lock()
+	defer policy.mu.Unlock()
+	if policy.consumed || policy.fd < 0 {
+		return fmt.Errorf("native filesystem boundary already consumed")
+	}
+	if err := policy.scope.check(); err != nil {
+		return err
+	}
+	if err := enforceNativeAllThreadsV1(policy.fd); err != nil {
+		return err
+	}
+	policy.consumed = true
+	if err := policy.closeLocked(); err != nil {
+		return err
+	}
+	policy.applied = &nativeFSAppliedV1{original: policy, pid: os.Getpid()}
+	return nil
+}
+
+func (policy *NativeFilesystemV1) closeLocked() error {
+	var result error
+	if policy.fd >= 0 {
+		result = unix.Close(policy.fd)
+		policy.fd = -1
+	}
+	for _, root := range policy.roots {
+		result = errors.Join(result, root.Close())
+	}
+	policy.roots = nil
+	return result
+}
+func (policy *NativeFilesystemV1) Close() error {
+	if policy == nil || policy.scope == nil {
+		return nil
+	}
+	policy.mu.Lock()
+	defer policy.mu.Unlock()
+	return policy.closeLocked()
+}
+
+// finalReceiptV1 is deliberately private. A role name, JSON assertion or
+// caller bool cannot issue a late-input barrier in place of real syscalls.
+func (policy *NativeFilesystemV1) finalReceiptV1() error {
+	if policy == nil {
+		return fmt.Errorf("native private phase has no filesystem policy")
+	}
+	policy.mu.Lock()
+	defer policy.mu.Unlock()
+	if !policy.consumed || policy.applied == nil || policy.applied.original != policy || policy.applied.pid != os.Getpid() {
+		return fmt.Errorf("native private phase has no actual all-thread filesystem result")
+	}
+	return policy.scope.check()
+}
+
+// nativeEntryFinalFilesystemV1 consumes actual pre-Go kernel enforcement.
+// Every runtime thread and native platform child inherits ONE full domain.
+// There is no per-thread late filesystem layer on this Sentry path.
+func nativeEntryFinalFilesystemV1(scope *NativeScopeV1) (*NativeFilesystemV1, error) {
+	if nativeEntryFinalFSV1 != 1 {
+		return nil, fmt.Errorf("native Sentry lacks its actual final pre-Go filesystem boundary")
+	}
+	if err := scope.check(); err != nil {
+		return nil, err
+	}
+	policy := &NativeFilesystemV1{scope: scope, fd: -1, consumed: true}
+	policy.applied = &nativeFSAppliedV1{original: policy, pid: os.Getpid()}
+	return policy, nil
+}
