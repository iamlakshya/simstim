+// SPDX-License-Identifier: Apache-2.0
+package hostguard
+
+import (
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"os"
+	"sync"
+
+	"golang.org/x/sys/unix"
+)
+
+// NativeSentryIOV1 owns only the final Sentry's fresh native IO vector. The
+// controller listener is first, followed by root and mount Gofer streams in
+// SAME immutable topology order. Guest FD3 is deliberately a later message.
+// A frame, socket identity or this receive result does not prove the other
+// roles: the original creator must join that aggregate before sending IO.
+type NativeSentryIOV1 struct {
+	mu       sync.Mutex
+	original *NativeSentryIOV1
+	phase    *NativePrivateV1
+	files    []*os.File
+	claimed  []int
+	objects  []nativeFinalObjectV1
+	accepted bool
+	closed   bool
+}
+
+func nativeSentryIOHeaderV1(data []byte, gofers int) error {
+	if len(data) != 6 || string(data[:4]) != "IOV\x01" || gofers < 1 || gofers > 1025 || int(binary.BigEndian.Uint16(data[4:])) != gofers {
+		return fmt.Errorf("final Sentry IO changed its fixed native vector")
+	}
+	return nil
+}
+
+// ReceiveFinalSentryIOV1 is called before Loader.New/platform.New. It reads
+// only the endpoint created AFTER this exact final exec's ND0 and successful
+// raw final FS entry. No future IO endpoint survives the exec reset.
+func (phase *NativePrivateV1) ReceiveFinalSentryIOV1() (_ *NativeSentryIOV1, failure error) {
+	if phase == nil {
+		return nil, fmt.Errorf("final Sentry IO has no actual native owner")
+	}
+	phase.mu.Lock()
+	defer phase.mu.Unlock()
+	if err := phase.checkLocked(); err != nil {
+		return nil, err
+	}
+	if nativeEntryFinalFSV1 != 1 || phase.role != NativeSentryV1 || !phase.final || !phase.published || phase.consumed || phase.io != nil || phase.policy == nil {
+		return nil, fmt.Errorf("final Sentry IO arrived outside its original final phase")
+	}
+	if err := phase.policy.finalReceiptV1(); err != nil {
+		return nil, err
+	}
+	gofers := 1 + len(phase.topology.wire.Mounts)
+	// One extra payload byte and ancillary capacity expose truncation/extra
+	// input. SCM_MAX_FD bounds a single kernel record, so use closed batches.
+	result := &NativeSentryIOV1{phase: phase}
+	result.original = result
+	complete := false
+	defer func() {
+		if !complete {
+			failure = errors.Join(failure, result.Close())
+		}
+	}()
+	for offset := 0; offset < gofers+1; {
+		count := min(240, gofers+1-offset)
+		data := make([]byte, 11)
+		ancillary := make([]byte, unix.CmsgSpace(4*count)+unix.CmsgSpace(unix.SizeofUcred))
+		n, oobn, flags, _, err := unix.Recvmsg(int(phase.local.Fd()), data, ancillary, unix.MSG_CMSG_CLOEXEC)
+		if err != nil {
+			return nil, err
+		}
+		messages, parseErr := unix.ParseSocketControlMessage(ancillary[:oobn])
+		var rights []int
+		credentials, rightFrames := 0, 0
+		var semanticErr error
+		for _, message := range messages {
+			if message.Header.Level == unix.SOL_SOCKET && message.Header.Type == unix.SCM_RIGHTS {
+				rightFrames++
+				received, err := unix.ParseUnixRights(&message)
+				if err != nil {
+					semanticErr = errors.Join(semanticErr, err)
+				}
+				rights = append(rights, received...)
+			} else if message.Header.Level == unix.SOL_SOCKET && message.Header.Type == unix.SCM_CREDENTIALS {
+				credentials++
+				_, err := unix.ParseUnixCredentials(&message)
+				semanticErr = errors.Join(semanticErr, err)
+			} else {
+				semanticErr = errors.Join(semanticErr, fmt.Errorf("final IO has unsupported ancillary data"))
+			}
+		}
+		// Own every delivered descriptor before any malformed-frame refusal.
+		for _, fd := range rights {
+			result.files = append(result.files, os.NewFile(uintptr(fd), "fresh-final-native-IO-object"))
+		}
+		if parseErr != nil || semanticErr != nil || flags&(unix.MSG_TRUNC|unix.MSG_CTRUNC) != 0 || n != 10 || credentials != 1 || rightFrames != 1 || len(rights) != count {
+			return nil, fmt.Errorf("final IO has a malformed closed batch: %v", errors.Join(parseErr, semanticErr))
+		}
+		if err := nativeSentryIOHeaderV1(data[:6], gofers); err != nil {
+			return nil, err
+		}
+		if int(binary.BigEndian.Uint16(data[6:8])) != offset || int(binary.BigEndian.Uint16(data[8:10])) != count {
+			return nil, fmt.Errorf("final IO batch changed original ordering or extent")
+		}
+		offset += count
+	}
+	seen := map[[2]uint64]bool{}
+	for index, file := range result.files {
+		var st unix.Stat_t
+		if err := unix.Fstat(int(file.Fd()), &st); err != nil || st.Mode&unix.S_IFMT != unix.S_IFSOCK {
+			return nil, fmt.Errorf("final IO contains another native object: %v", err)
+		}
+		identity := [2]uint64{uint64(st.Dev), st.Ino}
+		if seen[identity] {
+			return nil, fmt.Errorf("final IO aliases another fixed role object")
+		}
+		seen[identity] = true
+		kind, err := unix.GetsockoptInt(int(file.Fd()), unix.SOL_SOCKET, unix.SO_TYPE)
+		if err != nil || kind != unix.SOCK_STREAM {
+			return nil, fmt.Errorf("final IO has another native socket kind: %v", err)
+		}
+		domain, err := unix.GetsockoptInt(int(file.Fd()), unix.SOL_SOCKET, unix.SO_DOMAIN)
+		if err != nil || domain != unix.AF_UNIX {
+			return nil, fmt.Errorf("final IO has another native socket domain: %v", err)
+		}
+		listening, err := unix.GetsockoptInt(int(file.Fd()), unix.SOL_SOCKET, unix.SO_ACCEPTCONN)
+		if err != nil || index == 0 && listening != 1 || index != 0 && listening != 0 {
+			return nil, fmt.Errorf("final IO changed its fixed listener/stream role: %v", err)
+		}
+		if index != 0 {
+			if _, err := unix.Getpeername(int(file.Fd())); err != nil {
+				return nil, fmt.Errorf("final Gofer IO is not connected: %w", err)
+			}
+		}
+		result.objects = append(result.objects, nativeFinalObjectV1{Dev: uint64(st.Dev), Ino: st.Ino})
+	}
+	phase.io = result
+	complete = true
+	return result, nil
+}
+
+// TakeBootFDsV1 transfers raw owned duplicates for the Loader's FD type. No
+// os.File finaliser can close the duplicates after the Loader adopts them.
+func (io *NativeSentryIOV1) TakeBootFDsV1() (controller int, gofers []int, failure error) {
+	if io == nil {
+		return -1, nil, fmt.Errorf("final native IO has no original receive owner")
+	}
+	io.mu.Lock()
+	defer io.mu.Unlock()
+	if io.original != io || io.closed || io.accepted || len(io.claimed) != 0 || len(io.files) < 2 {
+		return -1, nil, fmt.Errorf("final native IO was reconstructed, ended or reused")
+	}
+	for _, file := range io.files {
+		// Loader reserves 253..255 for its stable stdio table. Original receive
+		// aliases may occupy those slots, but AcceptBoot closes them first.
+		fd, err := unix.FcntlInt(file.Fd(), unix.F_DUPFD_CLOEXEC, 256)
+		if err != nil {
+			return -1, nil, err
+		}
+		io.claimed = append(io.claimed, fd)
+	}
+	return io.claimed[0], append([]int(nil), io.claimed[1:]...), nil
+}
+
+// AcceptBootV1 checks the actual same one-use vector at the Loader boundary.
+// Public FD numbers and matching inode DATA cannot construct this owner.
+func (io *NativeSentryIOV1) AcceptBootV1(phase *NativePrivateV1, controller int, gofers []int) error {
+	if io == nil || phase == nil {
+		return fmt.Errorf("native Loader has no original final IO receive")
+	}
+	phase.mu.Lock()
+	defer phase.mu.Unlock()
+	io.mu.Lock()
+	defer io.mu.Unlock()
+	if err := phase.checkLocked(); err != nil {
+		return err
+	}
+	if nativeEntryFinalFSV1 != 1 || io.original != io || io.phase != phase || phase.io != io || io.closed || io.accepted || !phase.final || phase.consumed || len(io.claimed) != len(gofers)+1 || len(io.objects) != len(io.claimed) {
+		return fmt.Errorf("native Loader changed its original final IO owner or purpose")
+	}
+	for index, fd := range append([]int{controller}, gofers...) {
+		var st unix.Stat_t
+		if fd != io.claimed[index] {
+			return fmt.Errorf("native Loader changed its original final IO slots")
+		}
+		if err := unix.Fstat(fd, &st); err != nil || uint64(st.Dev) != io.objects[index].Dev || st.Ino != io.objects[index].Ino {
+			return fmt.Errorf("native Loader lost its same final IO objects: %v", err)
+		}
+	}
+	for _, file := range io.files {
+		if err := file.Close(); err != nil {
+			return err
+		}
+	}
+	io.files = nil
+	io.accepted = true
+	return nil
+}
+
+func (io *NativeSentryIOV1) Close() error {
+	if io == nil {
+		return nil
+	}
+	io.mu.Lock()
+	defer io.mu.Unlock()
+	if io.closed {
+		return nil
+	}
+	io.closed = true
+	var result error
+	for _, file := range io.files {
+		result = errors.Join(result, file.Close())
+	}
+	if !io.accepted {
+		for _, fd := range io.claimed {
+			result = errors.Join(result, unix.Close(fd))
+		}
+	}
+	return result
+}
+
+// ConfirmFinalBoundaryV1 verifies the receipt already issued before Loader.New.
+// It never creates a sibling filesystem layer after platform/systrap creation.
+func (phase *NativePrivateV1) ConfirmFinalBoundaryV1() error {
+	if phase == nil {
+		return fmt.Errorf("native final boundary has no actual owner")
+	}
+	phase.mu.Lock()
+	defer phase.mu.Unlock()
+	if err := phase.checkLocked(); err != nil {
+		return err
+	}
+	if phase.role != NativeSentryV1 || nativeEntryFinalFSV1 != 1 || !phase.final || phase.policy == nil || phase.io == nil || !phase.io.accepted || phase.consumed {
+		return fmt.Errorf("native final boundary was not inherited before platform creation")
+	}
+	return phase.policy.finalReceiptV1()
+}
