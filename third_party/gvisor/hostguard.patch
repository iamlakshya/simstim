+// SPDX-License-Identifier: Apache-2.0
+package hostguard
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path"
+	"strings"
+	"sync"
+
+	"golang.org/x/sys/unix"
+)
+
+const nativeTopologyLimitV1 = 4 << 20
+
+type nativeTopologyMountV1 struct {
+	Role     string `json:"role"`
+	Source   int    `json:"source"`
+	Guest    string `json:"guest"`
+	Write    bool   `json:"write"`
+	Identity string `json:"identity"`
+}
+type nativeTopologyWireV1 struct {
+	Version int                     `json:"v"`
+	ID      string                  `json:"id"`
+	Role    string                  `json:"role"`
+	Mounts  []nativeTopologyMountV1 `json:"mounts"`
+}
+
+// NativeTopologyV1 is validated immutable setup DATA and held native objects.
+// It is neither a role-creation receipt nor permission to receive private data.
+// No host path, arbitrary OCI/process config, secret or guest link is parsed.
+type NativeTopologyV1 struct {
+	mu         sync.Mutex
+	descriptor *os.File
+	sources    []*os.File
+	wire       nativeTopologyWireV1
+	digest     string
+	closed     bool
+}
+
+func nativeObjectIdentityV1(file *os.File) (string, error) {
+	if file == nil {
+		return "", fmt.Errorf("native setup object is missing")
+	}
+	var st unix.Stat_t
+	if err := unix.Fstat(int(file.Fd()), &st); err != nil {
+		return "", err
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFREG && st.Mode&unix.S_IFMT != unix.S_IFDIR {
+		return "", fmt.Errorf("native setup source is not a file or directory")
+	}
+	return fmt.Sprintf("%x:%x", st.Dev, st.Ino), nil
+}
+
+// nativeExactObjectV1 rejects duplicate, aliased, missing and unknown fields.
+// Each nested mount uses the same barrier; decoding a map alone would silently
+// overwrite duplicate keys and encoding/json alone accepts case aliases.
+func nativeExactObjectV1(data []byte, fields ...string) (map[string]json.RawMessage, error) {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	token, err := decoder.Token()
+	if err != nil || token != json.Delim('{') {
+		return nil, fmt.Errorf("native setup is not an exact object")
+	}
+	allowed := map[string]bool{}
+	for _, field := range fields {
+		allowed[field] = true
+	}
+	values := map[string]json.RawMessage{}
+	for decoder.More() {
+		token, err := decoder.Token()
+		if err != nil {
+			return nil, err
+		}
+		key, ok := token.(string)
+		if !ok || !allowed[key] || values[key] != nil {
+			return nil, fmt.Errorf("native setup contains duplicate, aliased or unsupported fields")
+		}
+		var value json.RawMessage
+		if err := decoder.Decode(&value); err != nil {
+			return nil, err
+		}
+		if bytes.Equal(bytes.TrimSpace(value), []byte("null")) {
+			return nil, fmt.Errorf("native setup field is null")
+		}
+		values[key] = value
+	}
+	token, err = decoder.Token()
+	if err != nil || token != json.Delim('}') || len(values) != len(allowed) {
+		return nil, fmt.Errorf("native setup object is incomplete")
+	}
+	var trailing any
+	if !errors.Is(decoder.Decode(&trailing), io.EOF) {
+		return nil, fmt.Errorf("native setup has trailing input")
+	}
+	return values, nil
+}
+
+func decodeNativeTopologyV1(data []byte, count int) (nativeTopologyWireV1, error) {
+	var wire nativeTopologyWireV1
+	if len(data) == 0 || len(data) > nativeTopologyLimitV1 || count < 0 || count > 1024 {
+		return wire, fmt.Errorf("native setup exceeds its closed bounds")
+	}
+	fields, err := nativeExactObjectV1(data, "v", "id", "role", "mounts")
+	if err != nil {
+		return wire, err
+	}
+	if bytes.Equal(bytes.TrimSpace(fields["mounts"]), []byte("null")) {
+		return wire, fmt.Errorf("native setup mount vector is null")
+	}
+	var mounts []json.RawMessage
+	if err := json.Unmarshal(fields["mounts"], &mounts); err != nil || len(mounts) != count {
+		return wire, fmt.Errorf("native setup source vector changed: %v", err)
+	}
+	for _, mount := range mounts {
+		if _, err := nativeExactObjectV1(mount, "role", "source", "guest", "write", "identity"); err != nil {
+			return wire, err
+		}
+	}
+	if err := json.Unmarshal(data, &wire); err != nil {
+		return wire, err
+	}
+	if wire.Version != 2 || len(wire.ID) < 1 || len(wire.ID) > 32 || strings.Trim(wire.ID, "abcdefghijklmnopqrstuvwxyz234567") != "" || wire.Role != "guest-init" && wire.Role != "probe-true" {
+		return wire, fmt.Errorf("native setup has another version, ID or fixed role")
+	}
+	seen := map[string]bool{}
+	for index, mount := range wire.Mounts {
+		if mount.Source != index || mount.Identity == "" || !path.IsAbs(mount.Guest) || path.Clean(mount.Guest) != mount.Guest || mount.Guest == "/" || mount.Guest == "/home" || strings.ContainsAny(mount.Guest, "\x00\r\n") || seen[mount.Guest] {
+			return wire, fmt.Errorf("native setup changed source ordering or fixed guest targets")
+		}
+		if err := nativeMountRoleV2(mount); err != nil {
+			return wire, err
+		}
+		for _, reserved := range []string{"/proc", "/dev", "/tmp", "/run"} {
+			if mount.Guest == reserved || strings.HasPrefix(mount.Guest, reserved+"/") {
+				return wire, fmt.Errorf("native setup overlaps private guest topology")
+			}
+		}
+		seen[mount.Guest] = true
+	}
+	return wire, nil
+}
+
+// CaptureNativeTopologyV1 duplicates SAME already-held objects and validates
+// all required native seals and identities. It does not reopen their paths.
+func CaptureNativeTopologyV1(descriptor *os.File, sources []*os.File) (_ *NativeTopologyV1, failure error) {
+	if descriptor == nil {
+		return nil, fmt.Errorf("native setup has no immutable descriptor")
+	}
+	// Reassert actual post-exec ND0 before even public topology is parsed.
+	if err := Disable(); err != nil {
+		return nil, err
+	}
+	required := unix.F_SEAL_WRITE | unix.F_SEAL_GROW | unix.F_SEAL_SHRINK | unix.F_SEAL_SEAL
+	seals, err := unix.FcntlInt(descriptor.Fd(), unix.F_GET_SEALS, 0)
+	if err != nil || seals&required != required {
+		return nil, fmt.Errorf("native setup descriptor is not sealed: %v", err)
+	}
+	var st unix.Stat_t
+	if err := unix.Fstat(int(descriptor.Fd()), &st); err != nil {
+		return nil, err
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFREG || st.Size < 1 || st.Size > nativeTopologyLimitV1 {
+		return nil, fmt.Errorf("native setup descriptor has unsupported type or size")
+	}
+	raw, err := io.ReadAll(io.NewSectionReader(descriptor, 0, nativeTopologyLimitV1+1))
+	if err != nil {
+		return nil, err
+	}
+	wire, err := decodeNativeTopologyV1(raw, len(sources))
+	if err != nil {
+		return nil, err
+	}
+	result := &NativeTopologyV1{wire: wire}
+	complete := false
+	defer func() {
+		if !complete {
+			failure = errors.Join(failure, result.Close())
+		}
+	}()
+	fd, err := unix.FcntlInt(descriptor.Fd(), unix.F_DUPFD_CLOEXEC, 3)
+	if err != nil {
+		return nil, err
+	}
+	result.descriptor = os.NewFile(uintptr(fd), "actual-immutable-native-topology")
+	for index, source := range sources {
+		if wire.Mounts[index].Role != "mount" {
+			info, err := source.Stat()
+			if err != nil || !info.IsDir() {
+				return nil, fmt.Errorf("kept state lost its original native directory: %v", err)
+			}
+		}
+		actual, err := nativeObjectIdentityV1(source)
+		if err != nil || actual != wire.Mounts[index].Identity {
+			return nil, fmt.Errorf("native topology source identity changed: %v", err)
+		}
+		fd, err := unix.FcntlInt(source.Fd(), unix.F_DUPFD_CLOEXEC, 3)
+		if err != nil {
+			return nil, err
+		}
+		held := os.NewFile(uintptr(fd), "actual-native-topology-source")
+		result.sources = append(result.sources, held)
+		actual, err = nativeObjectIdentityV1(held)
+		if err != nil || actual != wire.Mounts[index].Identity {
+			return nil, fmt.Errorf("native topology source changed during retention: %v", err)
+		}
+	}
+	digest := sha256.Sum256(raw)
+	result.digest = hex.EncodeToString(digest[:])
+	complete = true
+	return result, nil
+}
+
+func (topology *NativeTopologyV1) policyRootsV1(root *os.File) ([]NativeFSRootV1, error) {
+	if topology == nil {
+		return nil, fmt.Errorf("native role has no actual setup capsule")
+	}
+	topology.mu.Lock()
+	defer topology.mu.Unlock()
+	if topology.closed || topology.descriptor == nil || topology.digest == "" || len(topology.sources) != len(topology.wire.Mounts) {
+		return nil, fmt.Errorf("native setup lifetime ended")
+	}
+	if _, err := nativeObjectIdentityV1(root); err != nil {
+		return nil, err
+	}
+	roots := []NativeFSRootV1{{File: root}}
+	for index, source := range topology.sources {
+		identity, err := nativeObjectIdentityV1(source)
+		if err != nil || identity != topology.wire.Mounts[index].Identity {
+			return nil, fmt.Errorf("native setup lost its original filesystem object: %v", err)
+		}
+		roots = append(roots, NativeFSRootV1{File: source, ReadWrite: topology.wire.Mounts[index].Write})
+	}
+	return roots, nil
+}
+func (topology *NativeTopologyV1) Close() error {
+	if topology == nil {
+		return nil
+	}
+	topology.mu.Lock()
+	defer topology.mu.Unlock()
+	if topology.closed {
+		return nil
+	}
+	topology.closed = true
+	var result error
+	if topology.descriptor != nil {
+		result = errors.Join(result, topology.descriptor.Close())
+	}
+	for _, source := range topology.sources {
+		result = errors.Join(result, source.Close())
+	}
+	return result
+}
+
+// These are the same fixed state-generation targets as the host producer.
+// Role is comparison DATA from the original approved native plan, never a new
+// home grant or authority to parse state contents during trusted setup.
+func nativeMountRoleV2(mount nativeTopologyMountV1) error {
+	const restore = "/mnt/.agent-state-restore"
+	const capture = "/mnt/.agent-state-capture"
+	switch mount.Role {
+	case "mount":
+		if mount.Guest == "/home" || strings.HasPrefix(mount.Guest, "/home/") || mount.Guest == restore || mount.Guest == capture {
+			return fmt.Errorf("ordinary native mount claimed home or state topology")
+		}
+	case "kept-dir":
+		relative, ok := strings.CutPrefix(mount.Guest, "/home/agent/")
+		if !ok || !mount.Write || relative == "" || path.IsAbs(relative) || path.Clean(relative) != relative || relative == ".." || strings.HasPrefix(relative, "../") || strings.ContainsAny(relative, "\x00\r\n") {
+			return fmt.Errorf("kept state changed its original guest prefix or access")
+		}
+	case "state-restore":
+		if mount.Guest != restore || mount.Write {
+			return fmt.Errorf("native restore generation changed its fixed target/access")
+		}
+	case "state-capture":
+		if mount.Guest != capture || !mount.Write {
+			return fmt.Errorf("native capture generation changed its fixed target/access")
+		}
+	default:
+		return fmt.Errorf("unsupported native topology mount role")
+	}
+	return nil
+}
