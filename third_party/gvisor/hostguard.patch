+// Copyright 2026 The gVisor Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+// Package hostguard protects the trusted host runtime before it reads guest
+// configuration. It grants neither a namespace nor an additional host identity.
+package hostguard
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"strconv"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+// Disable clears and verifies the mm's dumpability. Credential changes and
+// exec must be followed by this before configuration or guest input is read.
+func Disable() error {
+	if err := unix.Prctl(unix.PR_SET_DUMPABLE, 0, 0, 0, 0); err != nil {
+		return fmt.Errorf("protect runtime memory: %w", err)
+	}
+	value, err := unix.PrctlRetInt(unix.PR_GET_DUMPABLE, 0, 0, 0, 0)
+	if err != nil || value != 0 {
+		return fmt.Errorf("runtime memory protection did not remain active: %v", err)
+	}
+	return nil
+}
+
+// MustDisable terminates before any further guest-data processing if the
+// kernel cannot retain memory protection after a credential change.
+func MustDisable() {
+	if Disable() != nil {
+		_, _ = unix.Write(2, []byte("the runtime cannot retain private process memory\n"))
+		os.Exit(125)
+	}
+}
+
+// SingleMappedRoot recognises the real, effective AND saved zero identities
+// in an existing one-ID user namespace. Malformed native maps never become a
+// false result followed by an unsafe ordinary-root fallback.
+func SingleMappedRoot() (bool, error) {
+	uid, err := readMap("/proc/self/uid_map")
+	if err != nil {
+		return false, err
+	}
+	gid, err := readMap("/proc/self/gid_map")
+	if err != nil {
+		return false, err
+	}
+	single := len(uid) == 1 && len(gid) == 1 && uid[0][0] == 0 && gid[0][0] == 0 && uid[0][2] == 1 && gid[0][2] == 1
+	if !single {
+		return false, nil
+	}
+	ruid, euid, suid := unix.Getresuid()
+	rgid, egid, sgid := unix.Getresgid()
+	if ruid != 0 || euid != 0 || suid != 0 || rgid != 0 || egid != 0 || sgid != 0 {
+		return false, fmt.Errorf("the single mapped namespace is not real, effective and saved root")
+	}
+	return true, nil
+}
+
+func readMap(name string) ([][3]uint64, error) {
+	file, err := os.Open(name)
+	if err != nil {
+		return nil, fmt.Errorf("open native identity map: %w", err)
+	}
+	defer file.Close()
+	data, err := io.ReadAll(io.LimitReader(file, 16385))
+	if err != nil {
+		return nil, fmt.Errorf("read native identity map: %w", err)
+	}
+	return parseMap(string(data))
+}
+
+func parseMap(text string) ([][3]uint64, error) {
+	if len(text) == 0 || len(text) > 16384 || !strings.HasSuffix(text, "\n") {
+		return nil, fmt.Errorf("invalid native identity map size or record ending")
+	}
+	for _, value := range []byte(text) {
+		if value != ' ' && value != '\t' && value != '\n' && (value < '0' || value > '9') {
+			return nil, fmt.Errorf("invalid native identity map grammar")
+		}
+	}
+	var rows [][3]uint64
+	for _, line := range strings.Split(strings.TrimSuffix(text, "\n"), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) != 3 {
+			return nil, fmt.Errorf("invalid native identity map record")
+		}
+		var row [3]uint64
+		for index, field := range fields {
+			value, err := strconv.ParseUint(field, 10, 32)
+			if err != nil || strconv.FormatUint(value, 10) != field {
+				return nil, fmt.Errorf("invalid native identity map number")
+			}
+			row[index] = value
+		}
+		if row[2] == 0 || row[0]+row[2] > 1<<32-1 || row[1]+row[2] > 1<<32-1 {
+			return nil, fmt.Errorf("invalid native identity map range")
+		}
+		for _, old := range rows {
+			for _, index := range []int{0, 1} {
+				if row[index] < old[index]+old[2] && old[index] < row[index]+row[2] {
+					return nil, fmt.Errorf("overlapping native identity map ranges")
+				}
+			}
+		}
+		rows = append(rows, row)
+	}
+	return rows, nil
+}
