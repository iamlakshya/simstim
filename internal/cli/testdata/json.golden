== errors
{"v":1,"error":{"code":"host_not_found","kind":"not_found","message":"no host named \"nowhere\"","try":"<name> host add nowhere","exit":3}}
{"v":1,"error":{"code":"unknown_command","kind":"usage","message":"unknown command \"atach\"","try":"<name> attach --help","exit":2,"suggestions":["attach"]}}
{"v":1,"error":{"code":"json_needs_detach","kind":"usage","message":"--json needs --detach, because an attached session owns the terminal","try":"<name> new box --json --detach -- htop","exit":2}}
