# Build output
/bin/
# The docs site's dependencies, cache, and the pages and data that
# cmd/docgen -site writes from docs/ (scripts/docs-site.sh)
/site/node_modules/
/site/.astro/
/site/src/content/docs/
/site/src/generated/
/site/public/images/
# Pinned developer tools (scripts/setup.sh)
/.tools/
/dist/
/build/
*.test
*.out
coverage.*

# Host helpers embedded into the client at build time (see justfile: helpers, vt)
/internal/client/helpers/*
!/internal/client/helpers/*.go
!/internal/client/helpers/README.md

# Zig build output and fetched packages for the shadow terminal
/vt/zig-out/
/vt/.zig-cache/
/vt/zig-pkg/
/.zig-cache/

# Notes that must never reach git history (clean-room material, private notes,
# the owner's goals, status and logs)
/docs/research/private/
/private/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
.drop-test.txt
.e2e-debug.jsonl*
__pycache__/
.clip-test.png

# Link checker cache
.lycheecache
